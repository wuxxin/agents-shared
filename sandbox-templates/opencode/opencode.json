{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "plugin": [
    "@anthonyhaussman/opencode-agy-auth",
    "opencode-llm-proxy",
    "@slkiser/opencode-quota",
    "opencode-handoff",
    "oh-my-opencode-slim",
    [
      "opencode-hindsight-plus",
      {
        "hindsightApiUrl": "http://localhost:8888",
        "dynamicBankId": true,
        "dynamicBankGranularity": ["agent", "gitProject"],
        "enableKnowledgePages": true
      }
    ]
  ],
  "lsp": true,
  "provider": {
    "deepseek": {},
    "google-agy": {},
    "google-antigravity": {}
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": ["bunx", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "arbor": {
      "type": "local",
      "command": ["arbor", "mcp"]
    },
    "openadapt": {
      "type": "local",
      "command": ["openadapt", "mcp"]
    },
    "a2a": {
      "type": "local",
      "command": ["opencode-a2a", "mcp"]
    },
    "hindsight": {
      "type": "local",
      "command": ["bunx", "hindsight-mcp"]
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
