{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "plugin": [
    "./node_modules/@anthonyhaussman/opencode-agy-auth",
    "./node_modules/@slkiser/opencode-quota",
    "./node_modules/opencode-handoff",
    "./node_modules/oh-my-opencode-slim",
    [
      "./node_modules/@toady00/opencode-hindsight",
      {
        "hindsightApiUrl": "http://localhost:8888",
        "applyMode": "opt-out",
        "defaults": {
          "bankId": "opencode-orchestrator",
          "autoRetain": true,
          "autoRecall": true,
          "tags": ["source:opencode", "project:{project}", "agent:orchestrator"],
          "retainEveryNTurns": 10,
          "retainConversationExtras": false
        }
      }
    ]
  ],
  "lsp": true,
  "formatter": {
    "shfmt": {
      "command": ["shfmt", "-i", "4", "-w", "$FILE"]
    },
    "ruff": {
      "command": ["ruff", "format", "$FILE"]
    }
  },
  "provider": {
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "cost": {
            "input": 0.14,
            "output": 0.28,
            "cache_read": 0.0028
          }
        },
        "deepseek-v4-pro": {
          "cost": {
            "input": 0.435,
            "output": 0.87,
            "cache_read": 0.003625
          }
        }
      }
    },

    "local-inference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Inference",
      "options": {
        "baseURL": "http://localhost:51080/v1"
      },
      "models": {
        "qwen3": {
          "name": "Qwen3",
          "limit": { "context": 120192, "output": 16384 },
          "request": { "headers": { "X-Client-ID": "opencode" } }
        },
        "qwen3-thinking": {
          "name": "Qwen3 Thinking",
          "limit": { "context": 120192, "output": 16384 },
          "capabilities": { "thinking": true },
          "request": { "headers": { "X-Client-ID": "opencode" } }
        }
      }
    }
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": ["bunx", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "arbor": {
      "type": "local",
      "command": ["arbor", "mcp"]
    },
    "hindsight": {
      "type": "local",
      "command": ["bunx", "hindsight-mcp"]
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "oracle": {
      "options": {
        "hindsight": {
          "bankId": "opencode-oracle",
          "autoRetain": false,
          "autoRecall": false,
          "tags": ["source:opencode", "project:{project}", "agent:oracle"]
        }
      }
    },
    "fixer": {
      "options": {
        "hindsight": {
          "bankId": "opencode-fixer",
          "autoRetain": false,
          "autoRecall": false,
          "tags": ["source:opencode", "project:{project}", "agent:fixer"]
        }
      }
    },
    "librarian": {
      "options": {
        "hindsight": {
          "bankId": "opencode-librarian",
          "autoRetain": false,
          "autoRecall": false,
          "tags": ["source:opencode", "project:{project}", "agent:librarian"]
        }
      }
    },
    "explorer": {
      "options": {
        "hindsight": {
          "bankId": "opencode-explorer",
          "autoRetain": false,
          "autoRecall": false,
          "tags": ["source:opencode", "project:{project}", "agent:explorer"]
        }
      }
    },
    "designer": {
      "options": {
        "hindsight": {
          "bankId": "opencode-designer",
          "autoRetain": false,
          "autoRecall": false,
          "tags": ["source:opencode", "project:{project}", "agent:designer"]
        }
      }
    }
  }
}
