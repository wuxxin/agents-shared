{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "plugin": [
    "@anthonyhaussman/opencode-agy-auth",
    "opencode-llm-proxy",
    "@slkiser/opencode-quota",
    "opencode-handoff",
    "oh-my-opencode-slim",
    "@shantur/jarvis-mcp/plugin",
    [
      "opencode-hindsight-plus",
      {
        "hindsightApiUrl": "http://localhost:8888",
        "dynamicBankId": true,
        "dynamicBankGranularity": ["agent"],
        "retainTags": ["{session_id}", "project:{project}"],
        "retainMetadata": { "project": "{project}" },
        "enableKnowledgePages": true,
        "recallBudget": "low",
        "recallMaxTokens": 512,
        "minRecallPromptChars": 15,
        "retainEveryNTurns": 15
      }
    ]
  ],
  "lsp": true,
  "formatter": {
    "shfmt": {
      "command": ["shfmt", "-i", "4", "-w", "$FILE"]
    },
    "ruff": {
      "command": ["ruff", "format", "$FILE"]
    }
  },
  "provider": {
    "deepseek": {},
    "google-agy": {},
    "local-inference": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Inference",
      "options": {
        "baseURL": "http://localhost:51080/v1"
      },
      "models": {
        "qwen3": {
          "name": "Qwen3",
          "limit": { "context": 120192, "output": 16384 },
          "request": { "headers": { "X-Client-ID": "opencode" } }
        },
        "qwen3-thinking": {
          "name": "Qwen3 Thinking",
          "limit": { "context": 120192, "output": 16384 },
          "capabilities": { "thinking": true },
          "request": { "headers": { "X-Client-ID": "opencode" } }
        }
      }
    }
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": ["bunx", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "arbor": {
      "type": "local",
      "command": ["arbor", "mcp"]
    },
    "hindsight": {
      "type": "local",
      "command": ["bunx", "hindsight-mcp"]
    },
    "jarvis": {
      "type": "local",
      "command": ["bunx", "@shantur/jarvis-mcp"]
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
