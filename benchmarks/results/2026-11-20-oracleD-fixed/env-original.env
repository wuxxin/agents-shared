# local-chat-strata.env
# Configuration file for local-chat-strata.service.
#
# Dedicated Strata Chat and Vision inference settings for Qwen3.8-Flash-Next on AMD RDNA3 (RX 7900 XTX).
# Reload with:  local-chat-strata.sh restart

# ### SERVER SETTINGS

# Port to bind the server to (default: 20080, matching local-chat for drop-in replacement)
LCHAT_STRATA_PORT=20080

# Host to bind the server to (127.0.0.1 for local access only)
LCHAT_STRATA_HOST=127.0.0.1

# HIP GPU device ID (0 for primary RX 7900 XTX)
LCHAT_STRATA_DEVICE="0"


# ### MODEL AND ENGINE PATHS
# Base directory for local models repository (override to use custom storage)
LOCAL_MODELS_DIR="/data/public/machine-learning/models"

# Package tooling and data folders (hipBLASLt tables, expert profile, ESP projection)
STRATA_TOOLS_DIR="/usr/share/strata/terminal/tools"
STRATA_DATA_DIR="/usr/share/strata/terminal/data"

# Shard 1 (Native IQ3_S model - clean un-ablated Swift 1.5)
LCHAT_STRATA_MODEL="${LOCAL_MODELS_DIR}/strata/swift15_iq3s/models/swift-IQ3_S/Swift-Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf"

# Shard 2 (PLE GGUF)
LCHAT_STRATA_PLE_MODEL="${LOCAL_MODELS_DIR}/strata/swift15_iq3s/models/swift-IQ3_S/Swift-Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00002-of-00002.gguf"

# Strata native pack directory
LCHAT_STRATA_PACK="${LOCAL_MODELS_DIR}/strata/swift15_iq3s/packs/swift-iq3_s"

# Vision mmproj model (BF16 vision encoder)
LCHAT_STRATA_MMPROJ="${LOCAL_MODELS_DIR}/strata/swift15_iq3s/models/mmproj-Swift-Qwen3.8-Flash-Next-BF16.gguf"

# MTP Draft head runtime folder (speculative decoding)
LCHAT_STRATA_MTP="${LOCAL_MODELS_DIR}/strata/swift15_iq3s/mtp/rt"

# MTP Draft vocabulary override (empty = default full bilingual/multilingual draft_vocab.bin)
LCHAT_STRATA_MTP_VOCAB=""

# Runtime experimental speed projection / refusal control vector (uncensored)
LCHAT_STRATA_ESP="${LOCAL_MODELS_DIR}/strata/projections/Qwen3.8-Flash-Next-experimental-speed-projection.gguf"
LCHAT_STRATA_ESP_SCALE="1.0"
LCHAT_STRATA_ESP_LAYERS="4 44"
# ### ENGINE TUNING PARAMETERS

# Context window size in tokens (up to 240,384 tokens)
LCHAT_STRATA_MAX_CONTEXT=240384

# Prefill chunk size (24576 single-pass for <=24k prompts)
LCHAT_STRATA_PREFILL="24576"

# Deterministic Agentic Sampling parameters
LCHAT_STRATA_TEMPERATURE=0.6
LCHAT_STRATA_REPEAT_PENALTY=1.1
LCHAT_STRATA_TOP_P=0.95
LCHAT_STRATA_TOP_K=20

# Hardware calibrated PCIe fractional saturation
LCHAT_STRATA_PCIE_FRAC="0.20"

# Host RAM budget for experts in MiB
LCHAT_STRATA_EXPERT_RAM_BUDGET=42000

# Prompt cache slots
LCHAT_STRATA_PROMPT_CACHE=6

# Conversation cache slots, RAM budget, and 117.76 GiB OOM-safety guards
LCHAT_STRATA_CONV_CACHE_SLOTS=8
LCHAT_STRATA_CONV_CACHE_MIB=16384
LCHAT_STRATA_CONV_CACHE_MIN_FREE_MIB=6144
LCHAT_STRATA_CONV_CACHE_MIN_TOKENS=4096
LCHAT_STRATA_CONV_CACHE_PARK_GAIN=2048

# Conversation-cache SSD tier: parked conversations the RAM tier evicts are written here (empty dir = off)
LCHAT_STRATA_CONV_SPILL_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/user-cache/conv-spill"
LCHAT_STRATA_CONV_SPILL_MIB=24576

# Speculative decoding tokens, threshold, and drafter selection
LCHAT_STRATA_DRAFTING="mtp"
LCHAT_STRATA_SPEC=4
LCHAT_STRATA_SPEC_MIN_P=0.58
LCHAT_STRATA_SUFFIX_DRAFT=3
LCHAT_STRATA_LOOKUP_CHAIN=2
LCHAT_STRATA_ADAPT_ASYNC=1
LCHAT_STRATA_ADAPT_EVERY=1
LCHAT_STRATA_ADAPT_SWAPS=160
LCHAT_STRATA_ADAPT_DECAY="0.97"

# KV cache quantization, elastic VRAM growth (HIP VMM), and Tier-3 NVMe slot offload
LCHAT_STRATA_KV="k8v4"
LCHAT_STRATA_KV_GROW=true
LCHAT_STRATA_KV_RESIDENT=0
LCHAT_STRATA_SLOT_SAVE_PATH="${HOME}/.cache/user-cache"

# Model idle unload timeout in seconds without requests (default: 3600 = 1 hour; 0 to disable)
LCHAT_STRATA_IDLE_UNLOAD=3600

# NVMe Janitor cache limits
LCHAT_STRATA_USER_CACHE_MAX_GIB=25
LCHAT_STRATA_USER_CACHE_MAX_AGE_DAYS=3
LCHAT_STRATA_EXPERT_CACHE="auto"
LCHAT_STRATA_VRAM_RESERVE_MIB=576
# Routing profile and adaptive persistence
LCHAT_STRATA_EXPERT_PROFILE="/usr/share/strata/terminal/data/expert-profile.bin"
LCHAT_STRATA_EXPERT_PROFILE_SAVE="${HOME}/.local/state/strata/local-chat-strata-profile.bin"
LCHAT_STRATA_PLE_IO="ram"

# Enable multimodal vision processing via strata-vision-hip
LCHAT_STRATA_VISION=true
LCHAT_STRATA_VISION_TOKENS=1024


# ### ALIASES AND METADATA

# Primary alias reported to clients and router
LCHAT_STRATA_ALIAS="qwen3.8-flash-next"

# Comma-separated list of recognized aliases
LCHAT_STRATA_ALIASES="qwen3.8-flash-next-swift15,qwen3.8-moe,swift-1.5,qwen3.8,qwen3"

# ### TOKENIZER & CHAT TEMPLATE RUNTIME
# Points to pre-prepared tokenizer directory in target model dir containing vocab.json and chat_template.jinja
# Default points to tok_runtime (modified thinking-enabled template); change to packs/swift-iq3_s/tokenizer for raw GGUF template
LCHAT_STRATA_TOKENIZER_DIR="/data/public/machine-learning/models/strata/swift15_iq3s/tok_runtime"
LCHAT_STRATA_CHAT_TEMPLATE_KWARGS='{"enable_thinking": true}'
# Extra arguments passed directly to server.py
LCHAT_STRATA_EXTRA_ARGS=""

# Native Strata execution & ROCm flags (Session 4 Round 2 gfx1100 tuned)
STRATA_SCORES_THREAD=1
STRATA_WMMA_GEMM=1
STRATA_PF_GEMM=1
STRATA_PF_PAD=1
STRATA_PF_FUSED=1
STRATA_PF_F16=1
STRATA_PF_DM16=1
STRATA_DENSE_MMQ=1
STRATA_HC_UPMIX=1
STRATA_PF_HCDOWN=1
STRATA_CVEC_FUSE=1
STRATA_PF_HC_REGION=1
STRATA_PLE_COMPACT=1
STRATA_PLE_COPY_STREAM=1
STRATA_PREFILL_WARM=1
STRATA_PREFILL_AUTO_MAX=24576
STRATA_PREFILL_RING=512
STRATA_PREFILL_ROUTED_STREAM=1
STRATA_EMB_REUSE_ACCOUNT=1
STRATA_GDN_HEAD=1
STRATA_GDN_PP=2
STRATA_GDN_CONVL2=2
STRATA_GDN_NOY=1
STRATA_HIP_WMMA=1
STRATA_PA_FAST=1
STRATA_SELECT_WMMA=1
STRATA_Q8_PACKED=1
STRATA_MMVF_ROWS=1
STRATA_ATTN_LANECELL=1
STRATA_ATTN_MERGE_V2=1
STRATA_EXPERT_V2=1
STRATA_TSUM=1
STRATA_LFUSE=1
STRATA_GDN_SPLIT=1
STRATA_QFUSE=1
STRATA_PLE_BATCH=1
STRATA_SMALL_UNR=3
STRATA_GR_Q32_G=2
STRATA_GR_Q8_PFS=1
STRATA_HEAD_MIX_MULTI=1
STRATA_FUSE_HITS=1
STRATA_FUSE_WAIT=1
STRATA_VERIFY_QDEDUP=1
STRATA_SPEC_COST=1
STRATA_FUSE_HEAD_GR=1
STRATA_NORM_ROPE=1
HSA_USERPTR_FOR_PAGED_MEM=1
STRATA_MEMORY_LIMIT_MIB=0
STRATA_SLOT_RAM_RESERVE_GIB=8
STRATA_RESIDENT_HEADROOM_GIB=0
STRATA_SH_STREAM=0
STRATA_ARENA_RELEASE=0
PYTHONUNBUFFERED=1
STRATA_REQUEST_LINES=1

