#!/usr/bin/env bash
# kpxc-secret: Fast, secure secret retrieval helper using KeePassXC (git-credential-keepassxc)
# Integrates with KeePassXC browser/proxy protocol without DBus Secret Service dependencies.
set -euo pipefail

VERSION="1.1.0"

# Socket & Config Resolution ---
find_socket() {
    if [[ -n "${KEEPASSXC_BROWSER_SOCKET_PATH:-}" && -S "${KEEPASSXC_BROWSER_SOCKET_PATH}" ]]; then
        echo "$KEEPASSXC_BROWSER_SOCKET_PATH"
        return 0
    fi

    local uid
    uid="$(id -u)"
    local candidates=(
        "/run/user/$uid/app/org.keepassxc.KeePassXC/org.keepassxc.KeePassXC.BrowserServer"
        "/run/user/$uid/org.keepassxc.KeePassXC.BrowserServer"
        "/tmp/keepassxc-${USER:-$(id -un)}.socket"
    )

    for sock in "${candidates[@]}"; do
        if [[ -S "$sock" ]]; then
            echo "$sock"
            return 0
        fi
    done

    # Fallback search if socket is elsewhere in /run/user/$uid/
    local run_sock
    run_sock=$(find "/run/user/$uid" -maxdepth 4 -name "*BrowserServer*" -type s 2>/dev/null | head -n 1 || true)
    if [[ -n "$run_sock" && -S "$run_sock" ]]; then
        echo "$run_sock"
        return 0
    fi

    return 1
}

find_config() {
    if [[ -n "${KPXC_CONFIG:-}" && -f "${KPXC_CONFIG}" ]]; then
        echo "$KPXC_CONFIG"
        return 0
    fi

    local candidates=(
        "${XDG_CONFIG_HOME:-$HOME/.config}/git-credential-keepassxc"
        "${REAL_HOME:-$HOME/real_home}/.config/git-credential-keepassxc"
        "$HOME/real_home/.config/git-credential-keepassxc"
        "$HOME/.config/git-credential-keepassxc"
    )

    for cfg in "${candidates[@]}"; do
        if [[ -f "$cfg" ]] && grep -q '"databases": *\[[^{]*{' "$cfg" 2>/dev/null; then
            echo "$cfg"
            return 0
        fi
    done

    for cfg in "${candidates[@]}"; do
        if [[ -f "$cfg" ]]; then
            echo "$cfg"
            return 0
        fi
    done

    # Default fallback path
    echo "${XDG_CONFIG_HOME:-$HOME/.config}/git-credential-keepassxc"
}

# Ensure caller profile whitelists current binary and common execution environments
ensure_caller_whitelisted() {
    local cfg_file="$1"
    mkdir -p "$(dirname "$cfg_file")"

    # If config file does not exist, initialize with empty JSON object
    if [[ ! -f "$cfg_file" || ! -s "$cfg_file" ]]; then
        echo '{}' >"$cfg_file"
        chmod 600 "$cfg_file"
    fi

    # Read config and inspect callers list using python
    python3 -c '
import sys, json, os

cfg_path = sys.argv[1]
uid = os.getuid()
gid = os.getgid()

binaries = [
    "/usr/bin/bash",
    "/bin/bash",
    "/usr/bin/sh",
    "/bin/sh",
    "/usr/bin/python3",
    "/usr/lib/oh-my-pi/omp",
    "/usr/bin/git"
]

try:
    with open(cfg_path, "r") as f:
        data = json.load(f)
except Exception:
    data = {}

callers = data.get("callers", [])
existing_paths = {c.get("path") for c in callers if isinstance(c, dict)}

updated = False
for b in binaries:
    if os.path.exists(b) and b not in existing_paths:
        callers.append({
            "path": b,
            "uid": uid,
            "gid": gid,
            "canonicalize": False
        })
        existing_paths.add(b)
        updated = True

if updated or "callers" not in data:
    data["callers"] = callers
    with open(cfg_path, "w") as f:
        json.dump(data, f, indent=2)
' "$cfg_file"
}

# Secret Resolution Logic ---
resolve_uri() {
    local uri="$1"
    local cfg_file="$2"
    local sock="$3"

    # 1. Plain environment variable fallback: env://VAR_NAME
    if [[ "$uri" == env://* ]]; then
        local var_name="${uri#env://}"
        if [[ -z "${!var_name+x}" ]]; then
            echo "Error: Environment variable '$var_name' is not set." >&2
            return 1
        fi
        echo -n "${!var_name}"
        return 0
    fi

    # 2. Command evaluation fallback: cmd://shell_command
    if [[ "$uri" == cmd://* ]]; then
        local cmd="${uri#cmd://}"
        eval "$cmd"
        return 0
    fi

    # 3. KeePassXC URI: kpxc://[group/]target[:field]
    if [[ "$uri" == kpxc://* ]]; then
        local spec="${uri#kpxc://}"
        local group=""
        local target=""
        local field="password"

        # Check for field specifier at the end (:field)
        if [[ "$spec" =~ (.*):([^/:]+)$ ]]; then
            field="${BASH_REMATCH[2]}"
            spec="${BASH_REMATCH[1]}"
        fi

        # Check for group prefix (group/target or group1/group2/target)
        if [[ "$spec" =~ ^(.*)/(https?://.+)$ ]]; then
            local group_path="${BASH_REMATCH[1]}"
            target="${BASH_REMATCH[2]}"
            group="${group_path##*/}"
        elif [[ "$spec" =~ ^https?:// ]]; then
            target="$spec"
        elif [[ "$spec" == */* ]]; then
            target="${spec##*/}"
            local group_path="${spec%/*}"
            group="${group_path##*/}"
        else
            target="$spec"
        fi
        if [[ -z "$target" ]]; then
            echo "Error: Target identifier missing in URI: $uri" >&2
            return 1
        fi

        # Build git-credential-keepassxc input
        local cred_input=""
        if [[ "$target" == *"://"* ]]; then
            cred_input="url=$target"$'\n'
        elif [[ "$target" == *"."* || "$target" == *"localhost"* ]]; then
            cred_input="host=$target"$'\n'
            cred_input+="url=https://$target"$'\n'
        else
            cred_input="host=$target"$'\n'
            cred_input+="url=https://$target"$'\n'
            cred_input+="path=$target"$'\n'
        fi

        local global_args=(-c "$cfg_file" -s "$sock")
        if [[ -n "$group" ]]; then
            global_args+=(--group "$group")
        fi

        # Handle TOTP request
        if [[ "${field,,}" == "totp" ]]; then
            local res
            if ! res=$(printf "%s" "$cred_input" | git-credential-keepassxc "${global_args[@]}" get --totp 2>&1); then
                echo "Error: Failed to retrieve TOTP for '$target' ($res)" >&2
                return 1
            fi
            local code
            code=$(echo "$res" | sed -n 's/^password=//p' | tr -d '\r\n')
            if [[ -z "$code" ]]; then
                echo "Error: No TOTP returned for '$target': $res" >&2
                return 1
            fi
            echo -n "$code"
            return 0
        fi

        # Handle standard fields or advanced attributes
        local raw_json
        if ! raw_json=$(printf "%s" "$cred_input" | git-credential-keepassxc "${global_args[@]}" get --advanced-fields --json 2>&1); then
            echo "Error: Failed to query KeePassXC for '$target': $raw_json" >&2
            return 1
        fi

        # Parse field from JSON using python
        local val
        val=$(python3 -c '
import sys, json

raw = sys.stdin.read().strip()
field = sys.argv[1]

# Extract JSON portion if mixed with logs
json_start = raw.find("{")
if json_start == -1:
    sys.exit(1)

try:
    data = json.loads(raw[json_start:])
except Exception:
    sys.exit(1)

val = None
field_lower = field.lower()

if field_lower == "password":
    val = data.get("password")
elif field_lower == "username":
    val = data.get("username")
elif field_lower == "url":
    val = data.get("url")
else:
    # Check advanced/custom fields (git-credential-keepassxc uses "string_fields")
    adv = data.get("string_fields") or data.get("advanced") or {}
    if isinstance(adv, dict):
        if field in adv:
            val = adv[field]
        elif f"KPH: {field}" in adv:
            val = adv[f"KPH: {field}"]
        else:
            for k, v in adv.items():
                k_clean = k.lower().removeprefix("kph:").strip()
                f_clean = field_lower.removeprefix("kph:").strip()
                if k.lower() == field_lower or k_clean == f_clean:
                    val = v
                    break

if val is not None:
    sys.stdout.write(str(val))
    sys.exit(0)
else:
    sys.exit(2)
' "$field" <<<"$raw_json" || true)

        if [[ -n "$val" ]]; then
            echo -n "$val"
            return 0
        fi

        echo "Error: Field '$field' not found in KeePassXC entry for '$target'." >&2
        return 1
    fi

    # Unrecognized URI scheme
    echo "Error: Unrecognized secret URI scheme: '$uri'. Expected kpxc://, env://, or cmd://" >&2
    return 1
}

# Subcommands ---
cmd_get() {
    local uri="${1:-}"
    if [[ -z "$uri" ]]; then
        echo "Usage: kpxc-secret get <URI>" >&2
        exit 1
    fi

    local sock
    sock=$(find_socket) || {
        echo "Error: KeePassXC browser socket not found. Ensure KeePassXC is running with browser integration enabled." >&2
        exit 1
    }

    local cfg
    cfg=$(find_config)
    ensure_caller_whitelisted "$cfg"

    resolve_uri "$uri" "$cfg" "$sock"
    echo ""
}

cmd_export() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: kpxc-secret export <KEY=URI>..." >&2
        exit 1
    fi

    local sock
    sock=$(find_socket) || {
        echo "Error: KeePassXC browser socket not found." >&2
        exit 1
    }

    local cfg
    cfg=$(find_config)
    ensure_caller_whitelisted "$cfg"

    for item in "$@"; do
        if [[ "$item" != *"="* ]]; then
            echo "Error: Invalid export pair '$item'. Expected KEY=URI format." >&2
            exit 1
        fi
        local key="${item%%=*}"
        local uri="${item#*=}"
        local val
        val=$(resolve_uri "$uri" "$cfg" "$sock")
        # Output escaped export line
        printf "export %s=%q\n" "$key" "$val"
    done
}

cmd_run() {
    local secrets=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --secret)
            secrets+=("$2")
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
        esac
    done

    if [[ $# -eq 0 ]]; then
        echo "Usage: kpxc-secret run [--secret KEY=URI...] -- <command> [args...]" >&2
        exit 1
    fi

    local sock
    sock=$(find_socket) || {
        echo "Error: KeePassXC browser socket not found." >&2
        exit 1
    }

    local cfg
    cfg=$(find_config)
    ensure_caller_whitelisted "$cfg"

    for item in "${secrets[@]}"; do
        local key="${item%%=*}"
        local uri="${item#*=}"
        local val
        val=$(resolve_uri "$uri" "$cfg" "$sock")
        export "$key"="$val"
    done

    exec "$@"
}

cmd_configure() {
    local group="Automation"
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --group)
            group="$2"
            shift 2
            ;;
        *)
            shift
            ;;
        esac
    done

    local sock
    sock=$(find_socket) || {
        echo "Error: KeePassXC browser socket not found." >&2
        exit 1
    }

    local cfg
    cfg=$(find_config)
    ensure_caller_whitelisted "$cfg"

    echo "Associating git-credential-keepassxc with KeePassXC..."
    echo "Using socket: $sock"
    echo "Using config: $cfg"
    echo "Dedicated group: $group"
    echo ""
    echo "KeePassXC will now present a GUI dialog to approve the association."
    echo "Please switch to KeePassXC, enter an identifier (e.g. 'kpxc-automation'), and click 'Save and allow access'."
    echo ""

    git-credential-keepassxc -c "$cfg" -s "$sock" configure --group "$group"
    echo "Association complete!"
}

cmd_ls() {
    local sock
    sock=$(find_socket) || {
        echo "Error: KeePassXC browser socket not found." >&2
        exit 1
    }

    local cfg
    cfg=$(find_config)
    ensure_caller_whitelisted "$cfg"

    git-credential-keepassxc -c "$cfg" -s "$sock" groups "$@"
}

cmd_status() {
    echo "=== kpxc-secret Status (v$VERSION) ==="
    local sock
    if sock=$(find_socket); then
        echo "Socket: $sock (ACTIVE)"
    else
        echo "Socket: NOT FOUND"
    fi

    local cfg
    cfg=$(find_config)
    echo "Config file: $cfg"
    if [[ -f "$cfg" ]]; then
        echo "Config status: EXISTS ($(stat -c '%a' "$cfg") permissions)"
        python3 -c '
import sys, json
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    print("  Associated databases:", len(d.get("databases", [])))
    print("  Whitelisted callers:", len(d.get("callers", [])))
except Exception as e:
    print("  Config parse error:", e)
' "$cfg"
    else
        echo "Config status: NOT FOUND (Run 'kpxc-secret configure' to pair)"
    fi

    if [[ -n "${KEEPASSXC_BROWSER_SOCKET_PATH:-}" ]]; then
        echo "Env KEEPASSXC_BROWSER_SOCKET_PATH: $KEEPASSXC_BROWSER_SOCKET_PATH"
    fi
}

# Entrypoint ---
show_help() {
    cat <<EOF
kpxc-secret v$VERSION - Secret retrieval helper using KeePassXC

Usage:
    kpxc-secret get <URI>
        Resolve a secret URI and print value to stdout.

    kpxc-secret export <KEY=URI>...
        Print shell export statements for resolved secrets.
        Example: eval "\$(kpxc-secret export OPENAI_API_KEY=kpxc://api.openai.com)"

    kpxc-secret run [--secret KEY=URI...] -- <command> [args...]
        Resolve secrets and execute command with secrets injected into environment.
        Example: kpxc-secret run --secret TOKEN=kpxc://github.com -- ./deploy.sh

    kpxc-secret configure [--group <GROUP>]
        Associate with KeePassXC database (triggers KeePassXC GUI pairing popup).

    kpxc-secret status
        Display diagnostic status for socket, config, and associations.

    kpxc-secret ls [--raw]
    kpxc-secret groups [--raw]
        List KeePassXC database groups, parents, and UUIDs.

URI Formats:
    kpxc://[<group>/]<target>[:<field>]
        - target: URL, host, or entry title (e.g., api.openai.com, github.com)
        - field: password (default), username, totp, notes, or custom attribute name
    cmd://<command>
        Execute command and capture stdout.
    env://<VAR_NAME>
        Read from existing environment variable.
EOF
}

if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

subcmd="$1"
shift

case "$subcmd" in
get)
    cmd_get "$@"
    ;;
export)
    cmd_export "$@"
    ;;
run)
    cmd_run "$@"
    ;;
configure)
    cmd_configure "$@"
    ;;
status)
    cmd_status "$@"
    ;;
ls | groups)
    cmd_ls "$@"
    ;;
-h | --help | help)
    show_help
    ;;
-v | --version)
    echo "kpxc-secret v$VERSION"
    ;;
*)
    echo "Error: Unknown subcommand '$subcmd'." >&2
    show_help >&2
    exit 1
    ;;
esac
