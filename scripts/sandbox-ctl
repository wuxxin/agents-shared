#!/usr/bin/env bash
# Generalized Sandbox & systemd Transient Launcher
# Confines arbitrary binaries using systemd user namespaces or bubblewrap.
set -euo pipefail

# Constants
LAUNCHER_NAME="sandbox-ctl"

# Default Configuration Constants
DEFAULT_LAUNCHER_ENGINE="auto"
DEFAULT_DISABLE_XDG_RUNTIME="false"
DEFAULT_DISABLE_SSH_AUTH="false"
DEFAULT_DISABLE_WAYLAND="false"
DEFAULT_DISABLE_AUDIO="false"
DEFAULT_DISABLE_DBUS="false"
DEFAULT_DISABLE_HARDWARE="false"
DEFAULT_DISABLE_IPC_SHARE="true"
DEFAULT_DISABLE_PID_SHARE="true"
DEFAULT_LAUNCHER_PRIVATE_BASEPATH="$HOME/agent-private"
DEFAULT_LAUNCHER_PRIVATE_MOUNTS=""
DEFAULT_LAUNCHER_SANDBOX_MOUNTS=""
DEFAULT_LAUNCHER_EXTRA_MOUNTS="$HOME/agent-shared:agent-shared /data/download:download"
DEFAULT_LAUNCHER_GUI="false"
DEFAULT_LAUNCHER_GUI_NAME=""
DEFAULT_LAUNCHER_GUI_COMMENT="Sandboxed app"
DEFAULT_LAUNCHER_GUI_ICON=""
DEFAULT_LAUNCHER_GUI_CATEGORIES="Utility;"
DEFAULT_LAUNCHER_GUI_TERMINAL="false"
DEFAULT_LAUNCHER_APP_FLAGS=""
DEFAULT_LAUNCHER_DEFAULT_ARGS=""
DEFAULT_LAUNCHER_INIT_DEFAULT_PROJECT="false"
# shellcheck disable=SC2034
DEFAULT_LAUNCHER_INSTALL_CMDS=""
# shellcheck disable=SC2034
DEFAULT_LAUNCHER_UNINSTALL_CMDS=""

# Service & Sidecar Default Constants
DEFAULT_LAUNCHER_SERVICE_ENABLED="false"
DEFAULT_LAUNCHER_SERVICE_CMD="sleep"
DEFAULT_LAUNCHER_SERVICE_ARGS="10"
DEFAULT_LAUNCHER_SIDECARS="sleep"
DEFAULT_LAUNCHER_SIDECAR_SLEEP_CMD="sleep"
DEFAULT_LAUNCHER_SIDECAR_SLEEP_ARGS="10"

# Global environment variable exports (array of KEY=VALUE strings)
declare -g -a LAUNCHER_EXPORTS=()

# Helper: Check if systemd user manager is reachable
is_systemd_running() {
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/private" ]
}

resolve_path() {
    local val="$1"
    val="${val//%h/"$HOME"}"
    val="${val//\$HOME/"$HOME"}"
    if [[ "$val" =~ ^~ ]]; then
        val="${val/#\~/"$HOME"}"
    fi
    echo "$val"
}

sanitize_var_name() {
    local val="$1"
    val="${val//-/_}"
    val="${val//./_}"
    val="${val^^}"
    echo "$val"
}

init_app_vars() {
    local name="$1"
    app_name="$name"
    persistent_home="$HOME/.local/sandbox/$app_name"
    SERVICE_NAME="${app_name}"
    env_file="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE_NAME}.env"
    SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE_NAME}.service"

    # Migrate old env file if it exists and new one does not
    local old_env_file="$HOME/.local/sandbox/$app_name.env"
    if [[ ! -f "$env_file" && -f "$old_env_file" ]]; then
        mkdir -p "$(dirname "$env_file")"
        mv "$old_env_file" "$env_file"
        echo "Migrated environment file from $old_env_file to $env_file" >&2
    fi

    # Source env file if it exists
    if [[ -f "$env_file" ]]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$env_file"
        set +a
        set -u
    fi

    # Apply defaults using constants
    LAUNCHER_PRIVATE_BASEPATH=$(resolve_path "${LAUNCHER_PRIVATE_BASEPATH:-$DEFAULT_LAUNCHER_PRIVATE_BASEPATH}")
    work_dir="$LAUNCHER_PRIVATE_BASEPATH/$app_name"
}

# Determine Calling Mode & App Name
cmd_name=$(basename "$0")

if [[ "$cmd_name" == "$LAUNCHER_NAME" || "$cmd_name" == "sandbox-launcher" ]]; then
    central_mode=true
    if [[ $# -ge 2 ]]; then
        app_name="$2"
    else
        app_name=""
    fi
else
    central_mode=false
    app_name="$cmd_name"
fi

if [[ -n "${app_name:-}" ]]; then
    init_app_vars "$app_name"
fi

# Helper: Display launcher help information
show_help() {
    cat <<EOF
Sandbox-Ctl

- scriptcopy [or install-script]
    - Copy the sandbox-ctl script file to ~/.local/bin/sandbox-ctl
- install <app_name> [opts]
    - Setup sandbox, service files, and symlink in ~/.local/bin
    - Options:
        --no-git-config (skip copying .gitconfig)
        --new-config (overwrite environment file with defaults)
        --new-config-from <path> (copy environment file from path)
        --no-start (setup files without starting service)
- uninstall <app_name>
    - Remove symlinks, desktop, and systemd service files (preserves data)
- destroy <app_name>
    - Delete persistent sandbox home and env file
- edit <app_name>
    - Edit environment configuration file for app
- cat <app_name>
    - Print service file and environment configuration
- selftest <app_name>
    - Print config (cat) then run sandbox diagnostics
- exec <app_name> [args...]
    - Run the sandboxed application with optional args
- run <app_name> <cmd> [args...]
    - Run a custom command inside the sandbox
- shell <app_name>
    - Spawn an interactive shell inside the sandbox

Service Control Commands:
- start <app_name>     - Start the systemd user service
- stop <app_name>      - Stop the systemd user service
- restart <app_name>   - Restart the systemd user service
- status <app_name>    - Show status of the systemd user service
- enable <app_name>    - Enable systemd user service on boot
- disable <app_name>   - Disable systemd user service on boot
- logs <app_name>      - Tail systemd user service logs

Usage when called as a symlink (e.g. <app_name>):
  - [args...]          - Run the sandboxed <app_name> with all arguments
                         passed transparently to the original binary

EOF
}

# Helper: Find the real binary on the host to avoid recursive launcher calls
find_real_binary() {
    local binary_name="$1"
    # Clean PATH to exclude ~/.local/bin where the launcher symlink is located
    local clean_path
    clean_path=$(echo "$PATH" | tr ':' '\n' | grep -v "$HOME/.local/bin" | tr '\n' ':' | sed 's/:$//')

    # Locate the binary in the cleaned PATH
    PATH="$clean_path" command -v "$binary_name" || true
}

# Helper: Check if a path is under (or matches) a parent directory
is_under() {
    local path="$1"
    local parent="$2"
    path="${path%/}"
    parent="${parent%/}"
    [[ "$path" == "$parent" || "$path" == "$parent"/* ]]
}

# Helper: Initialize the sandbox directory structure
initialize_sandbox() {
    mkdir -p "$persistent_home" "$work_dir"

    # Only create a mount point in persistent home if work_dir is under $HOME
    if [[ "$work_dir" == "$HOME"/* ]]; then
        local rel_work
        rel_work=$(realpath --relative-to="$HOME" "$work_dir" 2>/dev/null || echo "agent-private/$app_name")
        mkdir -p "$persistent_home/$rel_work"
    fi
}

# Helper: Build unified sandbox configurations
build_sandbox_config() {
    local target_mode="$1" # "systemd" or "bwrap"
    local target_cwd="${2:-$HOME}"

    # Extract values from environment with defaults
    local disable_ipc_share="${DISABLE_IPC_SHARE:-$DEFAULT_DISABLE_IPC_SHARE}"
    local disable_pid_share="${DISABLE_PID_SHARE:-$DEFAULT_DISABLE_PID_SHARE}"
    local disable_hardware="${DISABLE_HARDWARE:-$DEFAULT_DISABLE_HARDWARE}"
    local launcher_private_basepath
    launcher_private_basepath=$(resolve_path "${LAUNCHER_PRIVATE_BASEPATH:-$DEFAULT_LAUNCHER_PRIVATE_BASEPATH}")
    local launcher_private_mounts="${LAUNCHER_PRIVATE_MOUNTS:-$DEFAULT_LAUNCHER_PRIVATE_MOUNTS}"
    local launcher_sandbox_mounts="${LAUNCHER_SANDBOX_MOUNTS:-$DEFAULT_LAUNCHER_SANDBOX_MOUNTS}"
    local launcher_extra_mounts="${LAUNCHER_EXTRA_MOUNTS:-$DEFAULT_LAUNCHER_EXTRA_MOUNTS}"
    local disable_xdg_runtime="${DISABLE_XDG_RUNTIME:-$DEFAULT_DISABLE_XDG_RUNTIME}"
    local disable_ssh_auth="${DISABLE_SSH_AUTH:-$DEFAULT_DISABLE_SSH_AUTH}"
    local disable_wayland="${DISABLE_WAYLAND:-$DEFAULT_DISABLE_WAYLAND}"
    local disable_audio="${DISABLE_AUDIO:-$DEFAULT_DISABLE_AUDIO}"
    local disable_dbus="${DISABLE_DBUS:-$DEFAULT_DISABLE_DBUS}"

    # Determine DISPLAY, XAUTHORITY, XDG_RUNTIME_DIR, SSH_AUTH_SOCK
    local display="${DISPLAY:-}"
    local xauthority="${XAUTHORITY:-}"
    local xdg_runtime_dir="${XDG_RUNTIME_DIR:-}"
    local ssh_auth_sock="${SSH_AUTH_SOCK:-}"

    if [[ "$target_mode" == "systemd" ]]; then
        # Return systemd properties
        echo "NoNewPrivileges=yes"
        echo "CapabilityBoundingSet="
        echo "AmbientCapabilities="
        echo "ProtectSystem=strict"
        echo "PrivateTmp=yes"

        # Relocated HOME
        echo "TemporaryFileSystem=$HOME"
        echo "BindPaths=$persistent_home:$HOME"
        echo "WorkingDirectory=$target_cwd"
        echo "Environment=HOME=$HOME"
        echo "Environment=SANDBOX_NAME=$app_name"
        echo "Environment=SANDBOX_ENGINE=systemd"
        echo "Environment=SANDBOX=$app_name"

        # LAUNCHER_EXPORTS
        if [[ ${#LAUNCHER_EXPORTS[@]} -gt 0 ]]; then
            for exp in "${LAUNCHER_EXPORTS[@]}"; do
                if [[ -n "$exp" ]]; then
                    echo "Environment=$exp"
                fi
            done
        fi

        # Workspace bind
        echo "BindPaths=$work_dir:$work_dir"

        # Private devices/hardware
        if [[ "$disable_hardware" == "true" || "$disable_hardware" == "1" ]]; then
            echo "PrivateDevices=yes"
        else
            echo "PrivateDevices=no"
        fi

        # Private IPC
        if [[ "$disable_ipc_share" == "true" || "$disable_ipc_share" == "1" ]]; then
            echo "PrivateIPC=yes"
        else
            echo "PrivateIPC=no"
        fi

        # Extra hardening
        echo "ProtectKernelTunables=yes"
        echo "ProtectKernelModules=yes"
        echo "ProtectKernelLogs=yes"
        echo "ProtectControlGroups=yes"
        echo "ProtectClock=yes"
        echo "ProtectHostname=yes"
        echo "LockPersonality=yes"
        echo "RestrictSUIDSGID=yes"
        echo "RestrictRealtime=yes"
        echo "KeyringMode=private"
        echo "UMask=0077"

        # GUI display environment variables
        if [[ -n "$display" ]]; then
            echo "Environment=DISPLAY=$display"
        fi
        if [[ -n "$xauthority" && -f "$xauthority" ]]; then
            echo "Environment=XAUTHORITY=$xauthority"
            echo "BindReadOnlyPaths=$xauthority:$xauthority"
            echo "BindReadOnlyPaths=/tmp/.X11-unix:/tmp/.X11-unix"
        fi

        # Wayland, Audio, DBus (selective runtime mounting)
        if [[ "$disable_xdg_runtime" != "true" && "$disable_xdg_runtime" != "1" && -n "$xdg_runtime_dir" && -d "$xdg_runtime_dir" ]]; then
            echo "Environment=XDG_RUNTIME_DIR=$xdg_runtime_dir"
            echo "TemporaryFileSystem=$xdg_runtime_dir"

            # Wayland
            if [[ "$disable_wayland" != "true" && "$disable_wayland" != "1" ]]; then
                local wl_display="${WAYLAND_DISPLAY:-wayland-0}"
                if [[ -e "$xdg_runtime_dir/$wl_display" ]]; then
                    echo "BindPaths=$xdg_runtime_dir/$wl_display:$xdg_runtime_dir/$wl_display"
                fi
                if [[ -e "$xdg_runtime_dir/${wl_display}.lock" ]]; then
                    echo "BindPaths=$xdg_runtime_dir/${wl_display}.lock:$xdg_runtime_dir/${wl_display}.lock"
                fi
                # Include Xwayland/Mutter auth files
                local old_nullglob
                old_nullglob=$(shopt -p nullglob || true)
                shopt -s nullglob
                for auth_file in "$xdg_runtime_dir"/.mutter-Xwaylandauth*; do
                    echo "BindPaths=$auth_file:$auth_file"
                done
                eval "$old_nullglob"
            fi

            # Audio (Pipewire / PulseAudio)
            if [[ "$disable_audio" != "true" && "$disable_audio" != "1" ]]; then
                for item in pipewire-0 pipewire-0.lock pipewire-0-manager pipewire-0-manager.lock pulse; do
                    if [[ -e "$xdg_runtime_dir/$item" ]]; then
                        echo "BindPaths=$xdg_runtime_dir/$item:$xdg_runtime_dir/$item"
                    fi
                done
                if [[ -d "/run/user/$(id -u)/pulse" ]]; then
                    echo "BindPaths=/run/user/$(id -u)/pulse:/run/user/$(id -u)/pulse"
                fi
            fi

            # DBus
            if [[ "$disable_dbus" != "true" && "$disable_dbus" != "1" ]]; then
                if [[ -e "$xdg_runtime_dir/bus" ]]; then
                    echo "BindPaths=$xdg_runtime_dir/bus:$xdg_runtime_dir/bus"
                fi
            fi
        fi

        # SSH agent forwarding
        if [[ "$disable_ssh_auth" != "true" && "$disable_ssh_auth" != "1" && -n "$ssh_auth_sock" && -S "$ssh_auth_sock" ]]; then
            echo "Environment=SSH_AUTH_SOCK=$ssh_auth_sock"
            echo "BindPaths=$ssh_auth_sock:$ssh_auth_sock"
        fi

        # LAUNCHER_PRIVATE_MOUNTS
        for m in $launcher_private_mounts; do
            if [[ -n "$m" ]]; then
                local mount_path
                if [[ "$m" == /* || "$m" == ~* || "$m" == %h* ]]; then
                    mount_path=$(resolve_path "$m")
                else
                    mount_path=$(resolve_path "$launcher_private_basepath/$m")
                fi
                mkdir -p "$mount_path" || true
                if [[ "$mount_path" == "$HOME"/* ]]; then
                    local rel_target="${mount_path#"$HOME"/}"
                    local real_target_path="$persistent_home/$rel_target"
                    if [[ -L "$real_target_path" ]]; then
                        rm -f "$real_target_path"
                    fi
                    mkdir -p "$real_target_path" 2>/dev/null || true
                fi
                echo "BindPaths=$mount_path:$mount_path"
            fi
        done

        # LAUNCHER_SANDBOX_MOUNTS
        for m in $launcher_sandbox_mounts; do
            if [[ -n "$m" ]]; then
                local sandbox_name="${m%%/*}"
                local subpath="${m#*/}"
                mkdir -p "$HOME/.local/sandbox/${sandbox_name}/${subpath}"
                mkdir -p "$persistent_home/${subpath}"
                echo "BindPaths=$HOME/.local/sandbox/${sandbox_name}/${subpath}:$HOME/${subpath}"
            fi
        done

        # LAUNCHER_EXTRA_MOUNTS
        for m in $launcher_extra_mounts; do
            if [[ -n "$m" ]]; then
                local host_path="${m%%:*}"
                local sandbox_path="${m#*:}"
                host_path="${host_path//%h/$HOME}"
                host_path="${host_path//\~/$HOME}"
                host_path="${host_path//\$HOME/$HOME}"

                local target_path
                if [[ "$sandbox_path" == /* ]]; then
                    target_path="$sandbox_path"
                else
                    target_path="$HOME/$sandbox_path"
                fi

                mkdir -p "$host_path" || true

                # For host creation of target mount point inside persistent home
                if [[ "$target_path" == "$HOME"/* ]]; then
                    local rel_target="${target_path#"$HOME"/}"
                    local real_target_path="$persistent_home/$rel_target"
                    if [[ -L "$real_target_path" ]]; then
                        rm -f "$real_target_path"
                    fi
                    mkdir -p "$real_target_path" 2>/dev/null || true
                fi

                echo "BindPaths=$host_path:$target_path"
            fi
        done

    elif [[ "$target_mode" == "bwrap" ]]; then
        # Return bubblewrap arguments (space-separated, line-by-line)
        echo "--die-with-parent"
        echo "--new-session"
        echo "--ro-bind"
        echo "/"
        echo "/"
        echo "--tmpfs"
        echo "/tmp"
        echo "--ro-bind"
        echo "/sys"
        echo "/sys"
        echo "--proc"
        echo "/proc"

        # Relocated HOME
        echo "--tmpfs"
        echo "$HOME"
        echo "--bind"
        echo "$persistent_home"
        echo "$HOME"
        echo "--bind"
        echo "$work_dir"
        echo "$work_dir"
        echo "--setenv"
        echo "HOME"
        echo "$HOME"
        echo "--setenv"
        echo "SANDBOX_NAME"
        echo "$app_name"
        echo "--setenv"
        echo "SANDBOX_ENGINE"
        echo "bwrap"
        echo "--setenv"
        echo "SANDBOX"
        echo "$app_name"

        # LAUNCHER_EXPORTS
        if [[ ${#LAUNCHER_EXPORTS[@]} -gt 0 ]]; then
            for exp in "${LAUNCHER_EXPORTS[@]}"; do
                if [[ -n "$exp" ]]; then
                    local key="${exp%%=*}"
                    local val="${exp#*=}"
                    echo "--setenv"
                    echo "$key"
                    echo "$val"
                fi
            done
        fi

        # Host device sharing / isolation
        if [[ "$disable_hardware" == "true" || "$disable_hardware" == "1" ]]; then
            echo "--dev"
            echo "/dev"
        else
            echo "--dev-bind"
            echo "/dev"
            echo "/dev"
        fi

        # IPC/PID sharing / isolation
        if [[ "$disable_ipc_share" == "true" || "$disable_ipc_share" == "1" ]]; then
            if [[ "$disable_pid_share" == "true" || "$disable_pid_share" == "1" ]]; then
                echo "--unshare-all"
            else
                echo "--unshare-user"
                echo "--unshare-ipc"
                echo "--unshare-net"
                echo "--unshare-uts"
                echo "--unshare-cgroup-try"
            fi
        else
            if [[ "$disable_pid_share" == "true" || "$disable_pid_share" == "1" ]]; then
                echo "--unshare-user"
                echo "--unshare-pid"
                echo "--unshare-net"
                echo "--unshare-uts"
                echo "--unshare-cgroup-try"
            else
                echo "--unshare-user"
                echo "--unshare-net"
                echo "--unshare-uts"
                echo "--unshare-cgroup-try"
            fi
        fi

        # Net is shared
        echo "--share-net"

        # GUI displays
        if [[ -n "$display" ]]; then
            echo "--setenv"
            echo "DISPLAY"
            echo "$display"
        fi
        if [[ -n "$xauthority" && -f "$xauthority" ]]; then
            echo "--setenv"
            echo "XAUTHORITY"
            echo "$xauthority"
            echo "--ro-bind"
            echo "$xauthority"
            echo "$xauthority"
            echo "--ro-bind"
            echo "/tmp/.X11-unix"
            echo "/tmp/.X11-unix"
        fi

        # Wayland, Audio, DBus (selective runtime mounting)
        if [[ "$disable_xdg_runtime" != "true" && "$disable_xdg_runtime" != "1" && -n "$xdg_runtime_dir" && -d "$xdg_runtime_dir" ]]; then
            echo "--tmpfs"
            echo "$xdg_runtime_dir"
            echo "--setenv"
            echo "XDG_RUNTIME_DIR"
            echo "$xdg_runtime_dir"

            # Wayland
            if [[ "$disable_wayland" != "true" && "$disable_wayland" != "1" ]]; then
                local wl_display="${WAYLAND_DISPLAY:-wayland-0}"
                if [[ -e "$xdg_runtime_dir/$wl_display" ]]; then
                    echo "--bind"
                    echo "$xdg_runtime_dir/$wl_display"
                    echo "$xdg_runtime_dir/$wl_display"
                fi
                if [[ -e "$xdg_runtime_dir/${wl_display}.lock" ]]; then
                    echo "--bind"
                    echo "$xdg_runtime_dir/${wl_display}.lock"
                    echo "$xdg_runtime_dir/${wl_display}.lock"
                fi
                local old_nullglob
                old_nullglob=$(shopt -p nullglob || true)
                shopt -s nullglob
                for auth_file in "$xdg_runtime_dir"/.mutter-Xwaylandauth*; do
                    echo "--bind"
                    echo "$auth_file"
                    echo "$auth_file"
                done
                eval "$old_nullglob"
            fi

            # Audio
            if [[ "$disable_audio" != "true" && "$disable_audio" != "1" ]]; then
                for item in pipewire-0 pipewire-0.lock pipewire-0-manager pipewire-0-manager.lock pulse; do
                    if [[ -e "$xdg_runtime_dir/$item" ]]; then
                        echo "--bind"
                        echo "$xdg_runtime_dir/$item"
                        echo "$xdg_runtime_dir/$item"
                    fi
                done
                if [[ -d "/run/user/$(id -u)/pulse" ]]; then
                    echo "--bind"
                    echo "/run/user/$(id -u)/pulse"
                    echo "/run/user/$(id -u)/pulse"
                fi
            fi

            # DBus
            if [[ "$disable_dbus" != "true" && "$disable_dbus" != "1" ]]; then
                if [[ -e "$xdg_runtime_dir/bus" ]]; then
                    echo "--bind"
                    echo "$xdg_runtime_dir/bus"
                    echo "$xdg_runtime_dir/bus"
                fi
            fi
        fi

        # SSH agent forwarding
        if [[ "$disable_ssh_auth" != "true" && "$disable_ssh_auth" != "1" && -n "$ssh_auth_sock" && -S "$ssh_auth_sock" ]]; then
            echo "--setenv"
            echo "SSH_AUTH_SOCK"
            echo "$ssh_auth_sock"
            echo "--bind"
            echo "$ssh_auth_sock"
            echo "$ssh_auth_sock"
        fi

        # LAUNCHER_PRIVATE_MOUNTS
        for m in $launcher_private_mounts; do
            if [[ -n "$m" ]]; then
                local mount_path
                if [[ "$m" == /* || "$m" == ~* || "$m" == %h* ]]; then
                    mount_path=$(resolve_path "$m")
                else
                    mount_path=$(resolve_path "$launcher_private_basepath/$m")
                fi
                mkdir -p "$mount_path" || true
                if [[ "$mount_path" == "$HOME"/* ]]; then
                    local rel_target="${mount_path#"$HOME"/}"
                    local real_target_path="$persistent_home/$rel_target"
                    if [[ -L "$real_target_path" ]]; then
                        rm -f "$real_target_path"
                    fi
                    mkdir -p "$real_target_path" 2>/dev/null || true
                fi
                echo "--bind"
                echo "$mount_path"
                echo "$mount_path"
            fi
        done

        # LAUNCHER_SANDBOX_MOUNTS
        for m in $launcher_sandbox_mounts; do
            if [[ -n "$m" ]]; then
                local sandbox_name="${m%%/*}"
                local subpath="${m#*/}"
                mkdir -p "$HOME/.local/sandbox/${sandbox_name}/${subpath}"
                mkdir -p "$persistent_home/${subpath}"
                echo "--bind"
                echo "$HOME/.local/sandbox/${sandbox_name}/${subpath}"
                echo "$HOME/${subpath}"
            fi
        done

        # LAUNCHER_EXTRA_MOUNTS
        for m in $launcher_extra_mounts; do
            if [[ -n "$m" ]]; then
                local host_path="${m%%:*}"
                local sandbox_path="${m#*:}"
                host_path="${host_path//%h/$HOME}"
                host_path="${host_path//\~/$HOME}"
                host_path="${host_path//\$HOME/$HOME}"

                local target_path
                if [[ "$sandbox_path" == /* ]]; then
                    target_path="$sandbox_path"
                else
                    target_path="$HOME/$sandbox_path"
                fi

                mkdir -p "$host_path" || true

                # Ensure the mount point exists in the persistent home on host
                if [[ "$target_path" == "$HOME"/* ]]; then
                    local rel_target="${target_path#"$HOME"/}"
                    local real_target_path="$persistent_home/$rel_target"
                    if [[ -L "$real_target_path" ]]; then
                        rm -f "$real_target_path"
                    fi
                    mkdir -p "$real_target_path" 2>/dev/null || true
                fi

                echo "--bind"
                echo "$host_path"
                echo "$target_path"
            fi
        done
    fi
}

# Helper: Run Sandbox (using systemd-run or bwrap)
run_sandbox() {
    # Initialize sandbox directories if missing
    initialize_sandbox

    # Determine execution engine
    local run_engine="bwrap"
    if [[ "${LAUNCHER_ENGINE:-auto}" == "systemd" ]]; then
        if ! is_systemd_running; then
            echo "Error: systemd user manager is not reachable but LAUNCHER_ENGINE=systemd was set." >&2
            exit 1
        fi
        run_engine="systemd"
    elif [[ "${LAUNCHER_ENGINE:-auto}" == "bwrap" ]]; then
        run_engine="bwrap"
    else
        if is_systemd_running; then
            run_engine="systemd"
        fi
    fi

    # Determine target working directory inside the sandbox
    local cwd
    cwd="$(pwd)"
    local target_cwd=""
    local is_mounted=false
    local rel_path=""

    # 1. Check if CWD is under persistent_home
    if is_under "$cwd" "$persistent_home"; then
        is_mounted=true
        rel_path=$(realpath --relative-to="$persistent_home" "$cwd" 2>/dev/null || echo "")
        if [[ "$rel_path" == "." || -z "$rel_path" ]]; then
            target_cwd="$HOME"
        else
            target_cwd="$HOME/$rel_path"
        fi
    # 2. Check if CWD is under work_dir
    elif is_under "$cwd" "$work_dir"; then
        is_mounted=true
        rel_path=$(realpath --relative-to="$work_dir" "$cwd" 2>/dev/null || echo "")
        if [[ "$rel_path" == "." || -z "$rel_path" ]]; then
            target_cwd="$work_dir"
        else
            target_cwd="$work_dir/$rel_path"
        fi
    fi

    # 3. Check extra mounts
    if [[ "$is_mounted" == "false" ]]; then
        local launcher_extra_mounts="${LAUNCHER_EXTRA_MOUNTS:-$DEFAULT_LAUNCHER_EXTRA_MOUNTS}"
        for m in $launcher_extra_mounts; do
            if [[ -n "$m" ]]; then
                local host_path="${m%%:*}"
                host_path="${host_path//%h/$HOME}"
                host_path="${host_path//\~/$HOME}"
                host_path="${host_path//\$HOME/$HOME}"
                if is_under "$cwd" "$host_path"; then
                    is_mounted=true
                    rel_path=$(realpath --relative-to="$host_path" "$cwd" 2>/dev/null || echo "")

                    local sandbox_path="${m#*:}"
                    local target_base
                    if [[ "$sandbox_path" == /* ]]; then
                        target_base="$sandbox_path"
                    else
                        target_base="$HOME/$sandbox_path"
                    fi

                    if [[ "$rel_path" == "." || -z "$rel_path" ]]; then
                        target_cwd="$target_base"
                    else
                        target_cwd="$target_base/$rel_path"
                    fi
                    break
                fi
            fi
        done
    fi

    # Check sandbox mounts
    if [[ "$is_mounted" == "false" ]]; then
        local launcher_sandbox_mounts="${LAUNCHER_SANDBOX_MOUNTS:-$DEFAULT_LAUNCHER_SANDBOX_MOUNTS}"
        for m in $launcher_sandbox_mounts; do
            if [[ -n "$m" ]]; then
                local sandbox_name="${m%%/*}"
                local subpath="${m#*/}"
                local host_sandbox_path="$HOME/.local/sandbox/${sandbox_name}/${subpath}"
                if is_under "$cwd" "$host_sandbox_path"; then
                    is_mounted=true
                    rel_path=$(realpath --relative-to="$host_sandbox_path" "$cwd" 2>/dev/null || echo "")
                    local target_base="$HOME/${subpath}"
                    if [[ "$rel_path" == "." || -z "$rel_path" ]]; then
                        target_cwd="$target_base"
                    else
                        target_cwd="$target_base/$rel_path"
                    fi
                    break
                fi
            fi
        done
    fi

    # 4. Check private mounts
    if [[ "$is_mounted" == "false" ]]; then
        local launcher_private_mounts="${LAUNCHER_PRIVATE_MOUNTS:-$DEFAULT_LAUNCHER_PRIVATE_MOUNTS}"
        local launcher_private_basepath
        launcher_private_basepath=$(resolve_path "${LAUNCHER_PRIVATE_MOUNTS_BASEPATH:-${LAUNCHER_PRIVATE_BASEPATH:-$DEFAULT_LAUNCHER_PRIVATE_BASEPATH}}")
        for m in $launcher_private_mounts; do
            if [[ -n "$m" ]]; then
                local mount_path
                if [[ "$m" == /* || "$m" == ~* || "$m" == %h* ]]; then
                    mount_path=$(resolve_path "$m")
                else
                    mount_path=$(resolve_path "$launcher_private_basepath/$m")
                fi
                if is_under "$cwd" "$mount_path"; then
                    is_mounted=true
                    rel_path=$(realpath --relative-to="$mount_path" "$cwd" 2>/dev/null || echo "")
                    if [[ "$rel_path" == "." || -z "$rel_path" ]]; then
                        target_cwd="$mount_path"
                    else
                        target_cwd="$mount_path/$rel_path"
                    fi
                    break
                fi
            fi
        done
    fi

    # 5. Check custom bind paths
    if [[ "$is_mounted" == "false" && -n "${SANDBOX_BIND_PATHS:-}" ]]; then
        IFS=':' read -ra paths <<<"$SANDBOX_BIND_PATHS"
        for p in "${paths[@]}"; do
            if [[ -n "$p" ]] && is_under "$cwd" "$p"; then
                is_mounted=true
                rel_path=$(realpath --relative-to="$p" "$cwd" 2>/dev/null || echo "")
                if [[ "$rel_path" == "." || -z "$rel_path" ]]; then
                    target_cwd="$p"
                else
                    target_cwd="$p/$rel_path"
                fi
                break
            fi
        done
    fi

    # 6. If not mounted, check if CWD is under HOME
    if [[ "$is_mounted" == "false" ]]; then
        local real_home
        real_home="$(realpath "$HOME")"
        local real_cwd
        real_cwd="$(realpath "$cwd")"
        rel_path=$(realpath --relative-to="$real_home" "$real_cwd" 2>/dev/null || echo "")

        if [[ -n "$rel_path" && "$rel_path" != ..* ]]; then
            if [[ "$rel_path" == "." || -z "$rel_path" ]]; then
                target_cwd="$HOME"
            else
                target_cwd="$HOME/$rel_path"
            fi

            local check_host_dir="$persistent_home"
            if [[ "$rel_path" != "." && -n "$rel_path" ]]; then
                check_host_dir="$persistent_home/$rel_path"
            fi

            if [[ ! -d "$check_host_dir" ]]; then
                echo "Warning: Current working directory '$cwd' is mapped to '$target_cwd' inside the sandbox, which does not exist." >&2
                echo "This will likely cause the sandbox execution to fail." >&2
            fi
        else
            # Outside HOME
            target_cwd="$cwd"
        fi
    fi

    if [[ -z "$target_cwd" ]]; then
        target_cwd="$HOME"
    fi

    # Construct cmd_args with LAUNCHER_APP_FLAGS if defined
    local cmd_args=()
    if [[ $# -gt 0 ]]; then
        local binary="$1"
        shift
        cmd_args+=("$binary")
        if [[ -n "${LAUNCHER_APP_FLAGS:-}" ]]; then
            eval "cmd_args+=(${LAUNCHER_APP_FLAGS})"
        fi
        cmd_args+=("$@")
    fi

    if [[ "$run_engine" == "systemd" ]]; then
        # 1. Run via systemd-run (transient scope/service)
        local systemd_opts=(
            --user
            --pty
            --wait
            --collect
            --quiet
            -p "Type=exec"
        )
        # Load configs from build_sandbox_config
        while IFS= read -r prop; do
            if [[ -n "$prop" ]]; then
                systemd_opts+=(-p "$prop")
            fi
        done < <(build_sandbox_config systemd "$target_cwd")
        echo "Executing sandbox using systemd-run: ${cmd_args[*]}"
        systemd-run "${systemd_opts[@]}" "${cmd_args[@]}"
    else
        # 2. Run via bubblewrap
        # Ensure bubblewrap is installed on the host
        if ! command -v bwrap >/dev/null 2>&1; then
            echo "Error: bubblewrap (bwrap) is not installed or not in PATH." >&2
            exit 1
        fi

        local bwrap_args=()
        while IFS= read -r arg; do
            if [[ -n "$arg" ]]; then
                bwrap_args+=("$arg")
            fi
        done < <(build_sandbox_config bwrap)

        # Add chdir to current working directory
        bwrap_args+=(--chdir "$target_cwd")
        echo "Executing sandbox using bwrap: ${cmd_args[*]}"
        bwrap "${bwrap_args[@]}" "${cmd_args[@]}"
    fi
}

# Command: Install launcher, symlink, and desktop entries
cmd_install() {
    local no_git_config=false
    local new_config=false
    local new_config_from=""
    local no_start=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --no-git-config) no_git_config=true ;;
        --new-config) new_config=true ;;
        --new-config-from)
            shift
            if [[ $# -eq 0 ]]; then
                echo "Error: --new-config-from requires a path argument." >&2
                exit 1
            fi
            new_config_from="$1"
            if [[ ! -f "$new_config_from" || ! -r "$new_config_from" ]]; then
                echo "Error: --new-config-from file '$new_config_from' does not exist or is not readable." >&2
                exit 1
            fi
            ;;
        --no-start) no_start=true ;;
        esac
        shift
    done

    # --new-config and --new-config-from are mutually exclusive
    if [[ "$new_config" == "true" && -n "$new_config_from" ]]; then
        echo "Error: --new-config and --new-config-from are mutually exclusive." >&2
        exit 1
    fi

    local bin_dir="$HOME/.local/bin"
    local script_target="$bin_dir/$LAUNCHER_NAME"
    local symlink_target="$bin_dir/$app_name"

    echo "Installing Sandbox Launcher for '$app_name'..."

    # Initialize sandbox directories
    initialize_sandbox

    # Copy .gitconfig from host if it exists and is missing in sandbox home
    if [[ "$no_git_config" == "false" ]]; then
        if [[ -f "$HOME/.gitconfig" && ! -f "$persistent_home/.gitconfig" ]]; then
            echo "Copying .gitconfig to $persistent_home/.gitconfig..."
            cp "$HOME/.gitconfig" "$persistent_home/.gitconfig"
        fi
    fi

    # Generic default project initialization
    if [[ "${LAUNCHER_INIT_DEFAULT_PROJECT:-$DEFAULT_LAUNCHER_INIT_DEFAULT_PROJECT}" == "true" || "${LAUNCHER_INIT_DEFAULT_PROJECT:-$DEFAULT_LAUNCHER_INIT_DEFAULT_PROJECT}" == "1" ]]; then
        local default_project="$work_dir/default"
        mkdir -p "$default_project"
        if [[ ! -d "$default_project/.git" ]]; then
            git -C "$default_project" init
        fi
    fi

    # Ensure local bin directory exists
    mkdir -p "$bin_dir"

    # Copy launcher script itself to user local bin if called from elsewhere
    local current_script
    current_script="$(realpath "$0")"

    if [[ "$current_script" != "$(realpath "$script_target" 2>/dev/null)" ]]; then
        echo "Copying launcher script to $script_target..."
        cp "$current_script" "$script_target"
        chmod +x "$script_target"
    fi

    # Create symlink if it does not exist yet
    if [[ ! -e "$symlink_target" && ! -L "$symlink_target" ]]; then
        echo "Creating symlink $symlink_target -> $LAUNCHER_NAME..."
        ln -s "$LAUNCHER_NAME" "$symlink_target"
    else
        echo "Symlink/file already exists at $symlink_target (skipping creation)."
    fi

    # Create or copy environment configuration file
    if [[ -n "$new_config_from" ]]; then
        echo "Copying environment file from $new_config_from to $env_file..."
        mkdir -p "$(dirname "$env_file")"
        cp "$new_config_from" "$env_file"
        chmod 600 "$env_file"

        # Re-source environment to load freshly copied settings
        init_app_vars "$app_name"
    elif [[ "$new_config" == "true" || ! -f "$env_file" ]]; then
        echo "Creating environment file at $env_file..."
        mkdir -p "$(dirname "$env_file")"
        cat >"$env_file" <<EOF
# env configuration for $app_name
# This file is loaded by the sandbox launcher.

# --- Execution Options ---
# Configures the execution engine (auto, systemd, bwrap).
# Set to 'systemd' to force cgroups containment or 'bwrap' to force bubblewrap container.
# LAUNCHER_ENGINE="${DEFAULT_LAUNCHER_ENGINE}"

# --- Hardening / Feature Flags (set to true to disable) ---
# DISABLE_XDG_RUNTIME="${DEFAULT_DISABLE_XDG_RUNTIME}"   # Disable XDG runtime directory (Wayland, DBus, audio)
# DISABLE_SSH_AUTH="${DEFAULT_DISABLE_SSH_AUTH}"      # Disable SSH agent forwarding
# DISABLE_WAYLAND="${DEFAULT_DISABLE_WAYLAND}"       # Disable Wayland display access
# DISABLE_AUDIO="${DEFAULT_DISABLE_AUDIO}"         # Disable audio playback/recording
# DISABLE_DBUS="${DEFAULT_DISABLE_DBUS}"          # Disable DBus session bus communication

# --- Namespace & Hardware Containment (set to true to isolate, false to share) ---
# DISABLE_HARDWARE="${DEFAULT_DISABLE_HARDWARE}"     # Isolate host GPU/DRI devices (set to true to run headless)
# DISABLE_IPC_SHARE="${DEFAULT_DISABLE_IPC_SHARE}"     # Isolate IPC namespace (set to false for GPU/ROCm hardware)
# DISABLE_PID_SHARE="${DEFAULT_DISABLE_PID_SHARE}"     # Isolate PID namespace (set to false to share host PIDs, to enable trace or inspect of child processes)

# --- Path / Directory Mounts ---
# LAUNCHER_PRIVATE_BASEPATH="${DEFAULT_LAUNCHER_PRIVATE_BASEPATH}"
# LAUNCHER_PRIVATE_MOUNTS="${DEFAULT_LAUNCHER_PRIVATE_MOUNTS}"
# LAUNCHER_SANDBOX_MOUNTS="${DEFAULT_LAUNCHER_SANDBOX_MOUNTS}"
# LAUNCHER_EXTRA_MOUNTS="${DEFAULT_LAUNCHER_EXTRA_MOUNTS}"

# --- Desktop / GUI Integration ---
# LAUNCHER_GUI="${DEFAULT_LAUNCHER_GUI}"            # Set to true to enable generating a desktop entry (.desktop file)
# LAUNCHER_GUI_NAME="${DEFAULT_LAUNCHER_GUI_NAME}"
# LAUNCHER_GUI_COMMENT="${DEFAULT_LAUNCHER_GUI_COMMENT}"
# LAUNCHER_GUI_ICON="${DEFAULT_LAUNCHER_GUI_ICON}"
# LAUNCHER_GUI_CATEGORIES="${DEFAULT_LAUNCHER_GUI_CATEGORIES}"
# LAUNCHER_GUI_TERMINAL="${DEFAULT_LAUNCHER_GUI_TERMINAL}"

# --- Service & Sidecar Options ---
# Set LAUNCHER_SERVICE_ENABLED="true" to enable background systemd service execution.
# Example launcher service command that outputs environment exports and waits until stopped:
# LAUNCHER_SERVICE_CMD="bash"
# LAUNCHER_SERVICE_ARGS='-c "export; exec sleep infinity"'
LAUNCHER_SERVICE_ENABLED="${DEFAULT_LAUNCHER_SERVICE_ENABLED}"
LAUNCHER_SERVICE_CMD="${DEFAULT_LAUNCHER_SERVICE_CMD}"
LAUNCHER_SERVICE_ARGS="${DEFAULT_LAUNCHER_SERVICE_ARGS}"
LAUNCHER_SIDECARS="${DEFAULT_LAUNCHER_SIDECARS}"
LAUNCHER_SIDECAR_SLEEP_CMD="${DEFAULT_LAUNCHER_SIDECAR_SLEEP_CMD}"
LAUNCHER_SIDECAR_SLEEP_ARGS="${DEFAULT_LAUNCHER_SIDECAR_SLEEP_ARGS}"

# --- Environment Variable Exports ---
# List of environment variables to export into the sandbox environment
# LAUNCHER_EXPORTS=(
#   'OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=true'
# )

# --- Application Startup Options ---
# LAUNCHER_APP_FLAGS="${DEFAULT_LAUNCHER_APP_FLAGS}"     # Extra flags appended to binary (e.g. '--no-sandbox' for Electron)
# LAUNCHER_DEFAULT_ARGS="${DEFAULT_LAUNCHER_DEFAULT_ARGS}"   # Default args passed if none are provided (e.g. '\$work_dir/default')
# LAUNCHER_INIT_DEFAULT_PROJECT="${DEFAULT_LAUNCHER_INIT_DEFAULT_PROJECT}" # Set to true to run 'git init' on the default project workspace

# --- Install/Uninstall Hooks ---
# Array of bash commands executed during install. Must be idempotent — should recreate everything needed as if it were a fresh install.
# LAUNCHER_INSTALL_CMDS=(
#   'cp /path/to/source \$HOME/.local/whatever'
# )
# Array of bash commands executed during uninstall. Should clean up any files/directories created by LAUNCHER_INSTALL_CMDS.
# LAUNCHER_UNINSTALL_CMDS=(
#   'rm -f \$HOME/.local/whatever'
# )

EOF
        chmod 600 "$env_file"

        # Re-source environment to load freshly created settings
        init_app_vars "$app_name"
    fi

    # GUI / Desktop Entry support
    local app_dir="$HOME/.local/share/applications"
    local desktop_file="$app_dir/$app_name.desktop"

    if [[ "${LAUNCHER_GUI:-$DEFAULT_LAUNCHER_GUI}" == "true" || "${LAUNCHER_GUI:-$DEFAULT_LAUNCHER_GUI}" == "1" ]]; then
        echo "Creating desktop entry for '$app_name' at $desktop_file..."
        mkdir -p "$app_dir"

        local gui_name="${LAUNCHER_GUI_NAME:-${app_name^}}"
        local gui_comment="${LAUNCHER_GUI_COMMENT:-$DEFAULT_LAUNCHER_GUI_COMMENT}"
        local gui_icon="${LAUNCHER_GUI_ICON:-$app_name}"
        local gui_categories="${LAUNCHER_GUI_CATEGORIES:-$DEFAULT_LAUNCHER_GUI_CATEGORIES}"
        local gui_terminal="${LAUNCHER_GUI_TERMINAL:-$DEFAULT_LAUNCHER_GUI_TERMINAL}"

        cat <<EOF >"$desktop_file"
[Desktop Entry]
Type=Application
Name=$gui_name
Comment=$gui_comment
Exec=$symlink_target %F
TryExec=$symlink_target
Icon=$gui_icon
Terminal=$gui_terminal
Categories=$gui_categories
StartupNotify=true
EOF
        chmod 644 "$desktop_file"
    else
        if [[ -f "$desktop_file" ]]; then
            echo "Removing desktop entry (LAUNCHER_GUI is not enabled)..."
            rm -f "$desktop_file"
        fi
    fi

    # Generate systemd user service file
    write_service_file

    # Execute LAUNCHER_INSTALL_CMDS inside sandbox if defined
    if [[ -n "${LAUNCHER_INSTALL_CMDS[*]:-}" ]]; then
        echo "Running LAUNCHER_INSTALL_CMDS inside sandbox..."
        for install_cmd in "${LAUNCHER_INSTALL_CMDS[@]}"; do
            if [[ -n "$install_cmd" ]]; then
                echo "--> Sandbox install command: $install_cmd"
                if ! run_sandbox /bin/bash -c "$install_cmd"; then
                    echo "Warning: LAUNCHER_INSTALL_CMDS command failed: $install_cmd" >&2
                fi
            fi
        done
    fi

    if is_systemd_running; then
        if [[ "${LAUNCHER_SERVICE_ENABLED:-false}" == "true" || "${LAUNCHER_SERVICE_ENABLED:-false}" == "1" ]]; then
            echo "Reloading systemd and enabling service..."
            systemctl --user enable "${SERVICE_NAME}.service" || true

            if [[ "$no_start" == "true" ]]; then
                echo "Stopping service if running (--no-start specified)..."
                systemctl --user stop "${SERVICE_NAME}.service" || true
            else
                echo "Starting service automatically..."
                systemctl --user restart "${SERVICE_NAME}.service" || true
            fi
        fi
    else
        echo "Systemd user manager is not running/available in this environment. Skipping systemd service activation."
    fi

    echo "Installation complete!"
    echo "Sandbox home directory: $persistent_home"
    echo "Sandbox environment file: $env_file"
    echo "Sandbox workspace: $work_dir"
}

# Helper: Generate systemd user service file contents
write_service_file() {
    local target_cwd="$work_dir"

    echo "Generating systemd user service for '$app_name' at $SERVICE_FILE..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    local service_cmd="${LAUNCHER_SERVICE_CMD:-$DEFAULT_LAUNCHER_SERVICE_CMD}"
    local service_args="${LAUNCHER_SERVICE_ARGS:-$DEFAULT_LAUNCHER_SERVICE_ARGS}"
    local sidecars_val="${LAUNCHER_SIDECARS:-}"
    sidecars_val="${sidecars_val//;/ }"
    sidecars_val="${sidecars_val//$'\n'/ }"

    local sidecars_exec=""
    local idx=0
    for sidecar in ${sidecars_val}; do
        local var_name
        var_name=$(sanitize_var_name "$sidecar")
        local cmd_var="LAUNCHER_SIDECAR_${var_name}_CMD"
        local cmd_val="${!cmd_var:-}"
        if [[ -z "$cmd_val" ]]; then
            cmd_val="$sidecar"
        fi

        # Warn if command doesn't exist on host
        local host_cmd_val="$cmd_val"
        host_cmd_val="${host_cmd_val//\$HOME/$HOME}"
        host_cmd_val="${host_cmd_val//%h/$HOME}"
        if [[ "$host_cmd_val" =~ ^(/|\.|\~) ]] || [[ -f "$host_cmd_val" ]]; then
            if [[ "$host_cmd_val" =~ ^~ ]]; then
                host_cmd_val="${host_cmd_val/#\~/$HOME}"
            fi
            if [[ ! -x "$host_cmd_val" ]]; then
                echo "Warning: Sidecar '$sidecar' executable '$cmd_val' (resolved: '$host_cmd_val') does not exist or is not executable." >&2
            fi
        else
            if ! command -v "$host_cmd_val" >/dev/null 2>&1; then
                echo "Warning: Sidecar '$sidecar' executable '$cmd_val' is not found in PATH." >&2
            fi
        fi

        local args_var="LAUNCHER_SIDECAR_${var_name}_ARGS"
        local args_val="${!args_var:-}"

        local env_remove_var="LAUNCHER_SIDECAR_${var_name}_ENV_REMOVE"
        local env_remove_val="${!env_remove_var:-}"
        local env_flags=""
        for r in ${env_remove_val}; do
            env_flags="$env_flags -u $r"
        done

        local env_override_var="LAUNCHER_SIDECAR_${var_name}_ENV_OVERRIDE"
        local env_override_val="${!env_override_var:-}"
        for o in ${env_override_val}; do
            env_flags="$env_flags $o"
        done

        sidecars_exec="$sidecars_exec if ! command -v $cmd_val >/dev/null 2>&1 && [ ! -x \"$cmd_val\" ]; then echo \"Error: Cannot spawn sidecar $sidecar because its executable '$cmd_val' is missing or not executable.\" >&2 ; exit 1 ; fi ; env$env_flags $cmd_val $args_val & SIDECAR_PID_$idx=\$\$! ; "
        idx=$((idx + 1))
    done

    local exec_start_cmd
    if [[ -n "$sidecars_exec" ]]; then
        local kill_pids="\$\$MAIN_PID"
        for ((i = 0; i < idx; i++)); do
            kill_pids="$kill_pids \$\$SIDECAR_PID_$i"
        done
        exec_start_cmd="/bin/bash -c 'trap \"kill $kill_pids 2>/dev/null || true\" EXIT ; $service_cmd $service_args & MAIN_PID=\$\$! ; $sidecars_exec wait -n'"
    else
        exec_start_cmd="$service_cmd $service_args"
    fi

    # Build sandbox config
    local sandbox_props=""
    while IFS= read -r prop; do
        if [[ -n "$prop" ]]; then
            sandbox_props="$sandbox_props"$'\n'"$prop"
        fi
    done < <(build_sandbox_config systemd "$target_cwd")

    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=Sandbox Service - ${app_name}
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=40
StartLimitBurst=4

[Service]
Type=simple
EnvironmentFile=-%h/.config/systemd/user/${SERVICE_NAME}.env
${sandbox_props}
ExecStart=${exec_start_cmd}
Restart=always
RestartSec=60
RestartMaxDelaySec=300
RestartSteps=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=${SERVICE_NAME}

[Install]
WantedBy=default.target
EOF

    if is_systemd_running; then
        systemctl --user daemon-reload
    fi
}

# Command: Edit environment configuration file
cmd_edit() {
    mkdir -p "$(dirname "$env_file")"
    touch "$env_file"
    ${EDITOR:-nano} "$env_file"

    if [[ -f "$env_file" ]]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$env_file"
        set +a
        set -u
    fi

    if is_systemd_running; then
        write_service_file
        if [[ "${LAUNCHER_SERVICE_ENABLED:-false}" == "true" || "${LAUNCHER_SERVICE_ENABLED:-false}" == "1" ]]; then
            echo "Ensuring service is enabled..."
            systemctl --user enable "${SERVICE_NAME}.service" || true
            echo "Restarting service to apply updated environment..."
            systemctl --user restart "${SERVICE_NAME}.service" || true
        else
            if systemctl --user is-active "${SERVICE_NAME}.service" &>/dev/null; then
                echo "Restarting service to apply updated environment..."
                systemctl --user restart "${SERVICE_NAME}.service" || true
            else
                echo "Service is not active. Service restart skipped."
            fi
        fi
    else
        echo "Systemd is not running. Service restart skipped."
    fi
}

# Command: Uninstall symlink, desktop file & systemd service
cmd_uninstall() {
    local bin_dir="$HOME/.local/bin"
    local symlink_target="$bin_dir/$app_name"
    local app_dir="$HOME/.local/share/applications"
    local desktop_file="$app_dir/$app_name.desktop"

    echo "Uninstalling Sandbox Launcher for '$app_name'..."

    if is_systemd_running; then
        echo "Stopping and disabling service..."
        systemctl --user stop "${SERVICE_NAME}.service" || true
        systemctl --user disable "${SERVICE_NAME}.service" || true
    fi

    if [[ -f "$SERVICE_FILE" ]]; then
        rm -f "$SERVICE_FILE"
        if is_systemd_running; then
            systemctl --user daemon-reload
        fi
        echo "Removed service file: $SERVICE_FILE"
    fi

    if [[ -L "$symlink_target" || -e "$symlink_target" ]]; then
        rm -f "$symlink_target"
        echo "Removed symlink: $symlink_target"
    else
        echo "No symlink found at $symlink_target."
    fi

    if [[ -f "$desktop_file" ]]; then
        rm -f "$desktop_file"
        echo "Removed desktop entry: $desktop_file"
    fi

    # Execute LAUNCHER_UNINSTALL_CMDS inside sandbox if defined
    if [[ -n "${LAUNCHER_UNINSTALL_CMDS[*]:-}" ]]; then
        echo "Running LAUNCHER_UNINSTALL_CMDS inside sandbox..."
        for uninstall_cmd in "${LAUNCHER_UNINSTALL_CMDS[@]}"; do
            if [[ -n "$uninstall_cmd" ]]; then
                echo "--> Sandbox uninstall command: $uninstall_cmd"
                if ! run_sandbox /bin/bash -c "$uninstall_cmd"; then
                    echo "Warning: LAUNCHER_UNINSTALL_CMDS command failed: $uninstall_cmd" >&2
                fi
            fi
        done
    fi

    echo "Uninstallation complete!"
    echo "Persistent sandbox directories and environment file were NOT deleted: '$persistent_home'"
}

# Command: Destroy sandbox data
cmd_destroy() {
    echo "Destroying sandbox data for '$app_name'..."

    if [[ -d "$persistent_home" ]]; then
        rm -rf "$persistent_home"
        echo "Deleted sandbox home: $persistent_home"
    fi

    echo "Sandbox destruction for '$app_name' complete (workspace '$work_dir', and env file: $env_file was preserved)."
}

# Command: Print service file and environment configuration
cmd_cat() {
    echo "=== Service File: ${SERVICE_FILE} ==="
    if [[ -f "${SERVICE_FILE}" ]]; then
        cat "${SERVICE_FILE}"
    else
        echo "(Service file does not exist. Run 'install' to create it.)"
    fi
    echo ""
    echo "=== Environment File: ${env_file} ==="
    if [[ -f "${env_file}" ]]; then
        cat "${env_file}"
    else
        echo "(Environment file does not exist. Run 'install' to create it.)"
    fi
}

# Command: Self-test — audit service unit file, systemd service status, and transient execution for both engines
cmd_selftest() {
    echo "=== SELF-TEST SANITY CHECKS: ${app_name} ==="
    echo ""
    echo "--- Config & Service File Audits ---"
    if [[ -f "${env_file}" ]]; then
        echo "OK: Environment file exists at ${env_file}"
        if grep -E "%[hHtSEuUbB]" "${env_file}" >/dev/null 2>&1; then
            echo "WARNING: Raw specifiers detected in environment file ${env_file}:"
            grep -E "%[hHtSEuUbB]" "${env_file}" || true
        else
            echo "OK: Environment file has no unresolved specifiers."
        fi
    else
        echo "WARNING: Environment file missing at ${env_file}"
    fi

    if [[ -f "${SERVICE_FILE}" ]]; then
        echo "OK: Systemd service unit file exists at ${SERVICE_FILE}"
        if grep -E "%[hHtSEuUbB]" "${SERVICE_FILE}" | grep -v 'EnvironmentFile=' >/dev/null 2>&1; then
            echo "WARNING: Raw specifiers detected in service unit file ${SERVICE_FILE}:"
            grep -E "%[hHtSEuUbB]" "${SERVICE_FILE}" | grep -v 'EnvironmentFile=' || true
        else
            echo "OK: Service file has no unresolved specifiers."
        fi
    else
        echo "INFO: Service file not found at ${SERVICE_FILE} (run 'install' to generate)."
    fi

    echo ""
    echo "--- Systemd Service Unit Status ---"
    if is_systemd_running; then
        systemctl --user status "${SERVICE_NAME}.service" --no-pager || true
    else
        echo "INFO: Systemd user manager is not running/reachable."
    fi

    # shellcheck disable=SC2016
    local run_diag_script='
echo "  PWD:  $(pwd)"
echo "  HOME: $HOME"
echo "  UID:  $(id -u)"
if [ -d "$HOME/.local/sandbox/'"$app_name"'" ]; then
    echo "  LEAK WARNING: $HOME/.local/sandbox/'"$app_name"' exists inside the sandbox!"
else
    echo "  OK: .local/sandbox/'"$app_name"' is NOT accessible/visible inside sandbox."
fi
echo "  PATH check:"
echo "$PATH" | tr ":" "\n" | while read -r entry; do
    if [ -d "$entry" ]; then
        echo "    OK   $entry"
    else
        echo "    MISS $entry"
    fi
done
echo "  Key Environment:"
echo "    SANDBOX_NAME=${SANDBOX_NAME:-unset}"
echo "    SANDBOX_ENGINE=${SANDBOX_ENGINE:-unset}"
echo "    SHELL=${SHELL:-unset}"
echo "    XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-unset}"
echo "    SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-unset}"
echo "    DISPLAY=${DISPLAY:-unset}"
echo "    WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset}"
echo "  Specifier Check:"
env | grep -E "%[hHtSEuUbB]" || echo "    OK: no unresolved specifiers in environment"
'

    echo ""
    echo "=== TRANSIENT EXECUTION DIAGNOSTICS ==="
    local orig_engine="${LAUNCHER_ENGINE:-auto}"

    if command -v bwrap >/dev/null 2>&1; then
        echo ""
        echo "--- Testing Bubblewrap (bwrap) Engine ---"
        LAUNCHER_ENGINE="bwrap" run_sandbox /bin/bash -c "$run_diag_script" || echo "ERROR: bwrap selftest failed"
    else
        echo "INFO: Bubblewrap (bwrap) binary not found on host."
    fi

    if is_systemd_running; then
        echo ""
        echo "--- Testing Systemd Transient Engine ---"
        LAUNCHER_ENGINE="systemd" run_sandbox /bin/bash -c "$run_diag_script" || echo "ERROR: systemd selftest failed"
    else
        echo "INFO: Systemd user manager not reachable, skipping systemd engine transient selftest."
    fi

    export LAUNCHER_ENGINE="$orig_engine"
    echo ""
    echo "=== SELFTEST COMPLETE ==="
}

cmd_start() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user start "${SERVICE_NAME}.service"
}

cmd_stop() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user stop "${SERVICE_NAME}.service"
}

cmd_restart() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user restart "${SERVICE_NAME}.service"
}

cmd_status() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user status "${SERVICE_NAME}.service"
}

cmd_enable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user enable "${SERVICE_NAME}.service"
}

cmd_disable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user disable "${SERVICE_NAME}.service"
}

cmd_logs() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    journalctl --user -u "${SERVICE_NAME}.service" "$@"
}

# Command: Copy sandbox-ctl script itself to ~/.local/bin/sandbox-ctl
cmd_scriptcopy() {
    local bin_dir="$HOME/.local/bin"
    local script_target="$bin_dir/$LAUNCHER_NAME"
    local current_script
    current_script="$(realpath "$0")"

    mkdir -p "$bin_dir"

    if [[ "$current_script" != "$(realpath "$script_target" 2>/dev/null)" ]]; then
        echo "Copying launcher script $current_script -> $script_target..."
        cp "$current_script" "$script_target"
        chmod +x "$script_target"
        echo "Successfully installed $LAUNCHER_NAME to $script_target"
    else
        echo "Launcher script is already located at $script_target (up to date)."
    fi
}

# --- Parsing Command and Routing ---

main() {
    if [[ "$central_mode" == "true" ]]; then
        # Central Mode: sandbox-ctl <cmd> <app_name> [args...]
        if [[ $# -lt 1 ]]; then
            show_help
            exit 1
        fi

        local cmd="$1"
        shift

        if [[ "$cmd" == "help" ]]; then
            show_help
            exit 0
        fi

        if [[ "$cmd" == "scriptcopy" || "$cmd" == "install-script" || "$cmd" == "copy-script" ]]; then
            cmd_scriptcopy
            exit 0
        fi

        if [[ $# -lt 1 ]]; then
            echo "Error: Application name (app_name) is required for command '$cmd'." >&2
            show_help >&2
            exit 1
        fi

        app_name="$1"
        shift

        # Re-evaluate paths for app_name
        init_app_vars "$app_name"

        case "$cmd" in
        install)
            cmd_install "$@"
            ;;
        uninstall)
            cmd_uninstall
            ;;
        destroy)
            cmd_destroy
            ;;
        edit)
            cmd_edit
            ;;
        cat)
            cmd_cat
            ;;
        selftest)
            cmd_selftest
            ;;
        start)
            cmd_start
            ;;
        stop)
            cmd_stop
            ;;
        restart)
            cmd_restart
            ;;
        status)
            cmd_status
            ;;
        enable)
            cmd_enable
            ;;
        disable)
            cmd_disable
            ;;
        logs)
            cmd_logs "$@"
            ;;
        exec)
            local real_bin
            real_bin=$(find_real_binary "$app_name")
            local target_bin=""
            if [[ -n "$real_bin" ]]; then
                target_bin="$real_bin"
            else
                target_bin="$app_name"
            fi
            if [[ $# -eq 0 && -n "${LAUNCHER_DEFAULT_ARGS:-}" ]]; then
                eval "set -- ${LAUNCHER_DEFAULT_ARGS}"
            fi
            run_sandbox "$target_bin" "$@"
            ;;
        run)
            if [[ $# -lt 1 ]]; then
                echo "Error: run requires a command to run." >&2
                exit 1
            fi
            run_sandbox "$@"
            ;;
        shell)
            if [[ $# -eq 0 ]]; then
                run_sandbox "${SHELL:-/bin/bash}" -l
            else
                run_sandbox "${SHELL:-/bin/bash}" "$@"
            fi
            ;;
        *)
            echo "Unknown command: $cmd" >&2
            show_help >&2
            exit 1
            ;;
        esac

    else
        # App Symlink Mode: <app_name> [args...]
        local real_bin
        real_bin=$(find_real_binary "$app_name")
        local target_bin=""
        if [[ -n "$real_bin" ]]; then
            target_bin="$real_bin"
        else
            target_bin="$app_name"
        fi

        if [[ $# -eq 0 && -n "${LAUNCHER_DEFAULT_ARGS:-}" ]]; then
            eval "set -- ${LAUNCHER_DEFAULT_ARGS}"
        fi

        run_sandbox "$target_bin" "$@"
    fi
}

main "$@"
