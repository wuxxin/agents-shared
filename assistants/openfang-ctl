#!/usr/bin/env bash
set -euo pipefail

# openfang-ctl - installation and management wrapper for openfang

SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/openfang.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/openfang.env"
OPENFANG_HOME="$HOME/.local/share/openfang"

get_shared_options() {
    local mode="$1" # "service" or "transient"
    local home_spec
    if [ "$mode" = "service" ]; then
        home_spec="%h"
    else
        home_spec="$HOME"
    fi

    local AGENT_PRIVATE_MOUNTS=""
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    # Environment & Working Directory
    echo "Environment=HOME=${home_spec}/.local/share/openfang"
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/openfang.env"
    echo "WorkingDirectory=${home_spec}/.local/share/openfang"

    # Security measures
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet="
    echo "AmbientCapabilities="

    # Filesystem hiding
    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    # Retain changes by bind mounting the explicit openfang home directory
    echo "BindPaths=${home_spec}/.local/share/openfang:${home_spec}/.local/share/openfang"
    # Allow access to agent-shared as requested
    echo "BindPaths=${home_spec}/agent-shared:${home_spec}/agent-shared"

    for m in ${AGENT_PRIVATE_MOUNTS:-}; do
        mkdir -p "$HOME/agent-private/$m"
        echo "BindPaths=${home_spec}/agent-private/$m:${home_spec}/agent-private/$m"
    done

    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=yes"
    echo "PrivateMounts=yes"

    # Kernel and IPC constraints
    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "LockPersonality=yes"
    echo "MemoryDenyWriteExecute=no"
    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

write_service_file() {
    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=OpenFang Agent OS Daemon
Documentation=https://github.com/RightNow-AI/openfang
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
$(get_shared_options service)
ExecStart=/usr/bin/openfang start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openfang

# Note: ProtectProc=invisible, ProcSubset=pid, and RestrictNamespaces=yes
# are explicitly omitted to allow child processes to use bwrap (which needs
# CLONE_NEWUSER and CLONE_NEWNS).

[Install]
WantedBy=default.target
EOF

    systemctl --user daemon-reload
}

cmd_install() {
    echo "Setting up openfang home directory at $OPENFANG_HOME..."
    mkdir -p "$OPENFANG_HOME"

    echo "Generating systemd user service..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    if [ ! -f "$ENV_FILE" ]; then
        cat >"$ENV_FILE" <<'EOF'
# openfang.env
# ---------------------------------------------------------------------------
# OpenFang Environment Configuration
# ---------------------------------------------------------------------------

# List of submounts from ~/agent-private/* to bind-mount into the sandbox
# (e.g., AGENT_PRIVATE_MOUNTS="health diary" binds ~/agent-private/health and ~/agent-private/diary)
# AGENT_PRIVATE_MOUNTS=""
EOF
        chmod 600 "$ENV_FILE"
        echo "Created default environment file at $ENV_FILE"
    fi

    write_service_file

    echo "Reloading systemd and enabling service..."
    systemctl --user enable openfang.service

    echo "Starting service automatically..."
    systemctl --user start openfang.service

    echo "Done! Type '$0 logs' to see the output."
}

cmd_uninstall() {
    echo "Uninstalling openfang systemd service..."
    systemctl --user stop openfang.service || true
    systemctl --user disable openfang.service || true

    if [ -f "$SERVICE_FILE" ]; then
        rm "$SERVICE_FILE"
        systemctl --user daemon-reload
        echo "Removed service file."
    fi
    echo "Uninstalled successfully. Data in $OPENFANG_HOME is preserved."
}

cmd_start() {
    write_service_file
    systemctl --user start openfang.service
}

cmd_stop() {
    systemctl --user stop openfang.service
}

cmd_restart() {
    write_service_file
    systemctl --user restart openfang.service
}

cmd_status() {
    systemctl --user status openfang.service
}

cmd_enable() {
    write_service_file
    systemctl --user enable openfang.service
}

cmd_disable() {
    systemctl --user disable openfang.service
}

cmd_logs() {
    journalctl --user -u openfang.service "$@"
}

cmd_edit() {
    mkdir -p "$(dirname "$ENV_FILE")"
    touch "$ENV_FILE"
    ${EDITOR:-nano} "$ENV_FILE"
    echo "Restarting service to apply updated environment..."
    cmd_restart
}

cmd_exec() {
    echo "Starting openfang as a transient systemd service with args: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" /usr/bin/openfang "$@"
}

cmd_shell() {
    echo "Starting interactive shell as a transient systemd service..."

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "${SHELL:-/bin/bash}" "$@"
}

usage() {
    echo "Usage: $0 <command>"
    echo "Commands:"
    echo "  install   - Setup service and openfang home directory"
    echo "  uninstall - Stop and remove systemd service"
    echo "  start     - Start the systemd service"
    echo "  stop      - Stop the systemd service"
    echo "  restart   - Restart the systemd service"
    echo "  status    - View systemd service status"
    echo "  enable    - Enable systemd service on boot"
    echo "  disable   - Disable systemd service on boot"
    echo "  logs      - Tail the systemd service logs"
    echo "  edit      - Edit the .env file and restart the service upon exit"
    echo "  exec      - Run openfang as a transient systemd user service with args"
    echo "  shell     - Spawn an interactive shell in the openfang systemd environment"
}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
install) cmd_install ;;
uninstall) cmd_uninstall ;;
start) cmd_start ;;
stop) cmd_stop ;;
restart) cmd_restart ;;
status) cmd_status ;;
enable) cmd_enable ;;
disable) cmd_disable ;;
logs) cmd_logs "$@" ;;
edit) cmd_edit ;;
exec) cmd_exec "$@" ;;
shell) cmd_shell "$@" ;;
*)
    echo "Unknown command: $COMMAND"
    usage
    exit 1
    ;;
esac
