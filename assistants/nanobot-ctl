#!/usr/bin/env bash
set -euo pipefail

# nanobot-ctl - installation and management wrapper for nanobot

SERVICE_NAME="nanobot"
NANOBOT_HOME="$HOME/.local/sandbox/nanobot"
VENV_DIR="$NANOBOT_HOME/venv"
SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE_NAME}.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE_NAME}.env"
CONFIG_FILE="$NANOBOT_HOME/config.json"
PACKAGE="nanobot-ai"

is_systemd_running() {
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/private" ]
}

require_uv() {
    if ! command -v uv &>/dev/null; then
        echo "Error: 'uv' is not installed or not in PATH."
        exit 1
    fi
}

sanitize_var_name() {
    local val="$1"
    val="${val//-/_}"
    val="${val//./_}"
    val="${val^^}"
    echo "$val"
}

get_shared_options() {
    local mode="$1" # "service" or "transient"
    local home_spec
    if [ "$mode" = "service" ]; then
        home_spec="%h"
    else
        home_spec="$HOME"
    fi

    local AGENT_PRIVATE_MOUNTS=""
    local AGENT_SANDBOX_MOUNTS=""
    local AGENT_EXTRA_MOUNTS=""
    local AGENT_WORKSPACE=""
    # Set default AGENT_WORKSPACE before sourcing so self-referencing variables expand correctly
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-$HOME/.local/sandbox/nanobot/.nanobot/workspace}"
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    # Environment & Working Directory
    echo "Environment=HOME=${home_spec}/.local/sandbox/nanobot"
    echo "Environment=NANOBOT_CONFIG=${home_spec}/.local/sandbox/nanobot/config.json"
    echo "Environment=NANOBOT_PORT=${NANOBOT_PORT:-8790}"
    echo "Environment=AGENT_WORKSPACE=${AGENT_WORKSPACE:-${home_spec}/.local/sandbox/nanobot/.nanobot/workspace}"
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/nanobot.env"
    echo "WorkingDirectory=${home_spec}/.local/sandbox/nanobot"

    # Security measures
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet="
    echo "AmbientCapabilities="

    # Filesystem isolation
    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    # Retain changes by bind mounting the explicit nanobot home directory
    echo "BindPaths=${home_spec}/.local/sandbox/nanobot:${home_spec}/.local/sandbox/nanobot"

    for m in ${AGENT_PRIVATE_MOUNTS:-}; do
        mkdir -p "$HOME/agent-private/$m"
        echo "BindPaths=${home_spec}/agent-private/$m:${home_spec}/agent-private/$m"
    done

    for m in ${AGENT_SANDBOX_MOUNTS:-}; do
        local sandbox_name="${m%%/*}"
        local subpath="${m#*/}"
        mkdir -p "$HOME/.local/sandbox/${sandbox_name}/${subpath}"
        mkdir -p "$HOME/.local/sandbox/nanobot/${subpath}"
        echo "BindPaths=${home_spec}/.local/sandbox/${sandbox_name}/${subpath}:${home_spec}/.local/sandbox/nanobot/${subpath}"
    done

    for m in ${AGENT_EXTRA_MOUNTS:-}; do
        local abs_dir="${m%%:*}"
        local rel_dir="${m#*:}"
        mkdir -p "$abs_dir" || true
        mkdir -p "$HOME/$rel_dir"
        echo "BindPaths=${abs_dir}:${home_spec}/${rel_dir}"
    done

    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=yes"
    echo "PrivateMounts=yes"

    # Kernel and IPC constraints
    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "LockPersonality=yes"
    echo "MemoryDenyWriteExecute=no"
    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

write_service_file() {
    # Set default AGENT_WORKSPACE before sourcing so self-referencing variables expand correctly
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-$HOME/.local/sandbox/nanobot/.nanobot/workspace}"
    if [ -f "$ENV_FILE" ]; then
        if grep -q "%h" "$ENV_FILE"; then
            sed -i "s|%h|$HOME|g" "$ENV_FILE"
            echo "Expanded %h to $HOME in $ENV_FILE"
        fi
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    # Ensure host workspace directory exists
    local workspace_dir="${AGENT_WORKSPACE:-$HOME/.local/sandbox/nanobot/.nanobot/workspace}"
    workspace_dir="${workspace_dir//%h/$HOME}"
    mkdir -p "$workspace_dir"

    # Manage systemd-tmpfiles configuration file based on AGENT_TMPFILES_CLEANUP
    local tmpfiles_config="${XDG_CONFIG_HOME:-$HOME/.config}/user-tmpfiles.d/${SERVICE_NAME}.conf"
    local tmpfiles_dir
    tmpfiles_dir=$(dirname "$tmpfiles_config")
    mkdir -p "$tmpfiles_dir"

    local tmpfiles_cleanup_enabled="${AGENT_TMPFILES_CLEANUP:-false}"

    if [ "$tmpfiles_cleanup_enabled" = "true" ]; then
        if [ -f "${tmpfiles_config}.disabled" ]; then
            mv "${tmpfiles_config}.disabled" "$tmpfiles_config"
            echo "Enabled systemd-tmpfiles configuration at $tmpfiles_config"
        elif [ ! -f "$tmpfiles_config" ]; then
            cat >"$tmpfiles_config" <<EOF
# ~/.config/user-tmpfiles.d/${SERVICE_NAME}.conf
# systemd-tmpfiles configuration for Nanobot

# Example: Delete all files in workspace/voice-notes/read/ if older than 24 hours
# Type  Path                                                                                Mode UID  GID  Age  Argument
e       %h/.local/sandbox/nanobot/.nanobot/workspace/voice-notes/read                        -    -    -    24h  -
EOF
            echo "Created and enabled default systemd-tmpfiles configuration at $tmpfiles_config"
        fi

        # Run cleanup now
        if is_systemd_running; then
            echo "Running systemd-tmpfiles cleanup..."
            systemd-tmpfiles --user --create --clean || true
        fi
    else
        if [ -f "$tmpfiles_config" ]; then
            mv "$tmpfiles_config" "${tmpfiles_config}.disabled"
            echo "Disabled systemd-tmpfiles configuration (renamed to ${tmpfiles_config}.disabled)"
        fi
    fi

    # Parse sidecars
    local sidecars_val="${AGENT_SIDECARS:-}"
    sidecars_val="${sidecars_val//;/ }"
    sidecars_val="${sidecars_val//$'\n'/ }"

    local sidecars_exec=""
    local sidecar_check=""
    local idx=0
    for sidecar in ${sidecars_val}; do
        local var_name
        var_name=$(sanitize_var_name "$sidecar")
        local cmd_var="AGENT_SIDECAR_${var_name}_CMD"
        local cmd_val="${!cmd_var:-}"
        if [ -z "$cmd_val" ]; then
            cmd_val="$sidecar"
        fi

        # Warn if command doesn't exist on host
        local host_cmd_val="$cmd_val"
        host_cmd_val="${host_cmd_val//\$AGENT_WORKSPACE/$workspace_dir}"
        host_cmd_val="${host_cmd_val//\$HOME/$HOME}"
        host_cmd_val="${host_cmd_val//%h/$HOME}"
        if [[ "$host_cmd_val" =~ ^(/|\.|\~) ]] || [ -f "$host_cmd_val" ]; then
            if [[ "$host_cmd_val" =~ ^~ ]]; then
                host_cmd_val="${host_cmd_val/#\~/$HOME}"
            fi
            if [ ! -x "$host_cmd_val" ]; then
                echo "Warning: Sidecar '$sidecar' executable '$cmd_val' (resolved: '$host_cmd_val') does not exist or is not executable." >&2
            fi
        else
            if ! command -v "$host_cmd_val" >/dev/null 2>&1; then
                echo "Warning: Sidecar '$sidecar' executable '$cmd_val' is not found in PATH." >&2
            fi
        fi

        local args_var="AGENT_SIDECAR_${var_name}_ARGS"
        local args_val="${!args_var:-}"

        # Process env removes and overrides
        local env_remove_var="AGENT_SIDECAR_${var_name}_ENV_REMOVE"
        local env_remove_val="${!env_remove_var:-}"
        local env_flags=""
        for r in ${env_remove_val}; do
            env_flags="$env_flags -u $r"
        done

        local env_override_var="AGENT_SIDECAR_${var_name}_ENV_OVERRIDE"
        local env_override_val="${!env_override_var:-}"
        for o in ${env_override_val}; do
            env_flags="$env_flags $o"
        done

        # Check executable inside sandbox at startup and print clear error if missing
        sidecars_exec="$sidecars_exec if ! command -v $cmd_val >/dev/null 2>&1 && [ ! -x \"$cmd_val\" ]; then echo \"Error: Cannot spawn sidecar $sidecar because its executable '$cmd_val' is missing or not executable.\" >&2 ; exit 1 ; fi ; env$env_flags $cmd_val $args_val & SIDECAR_PID_$idx=\$! ; "
        sidecar_check="$sidecar_check if ! kill -0 \$SIDECAR_PID_$idx 2>/dev/null; then echo \"Sidecar $sidecar (PID \$SIDECAR_PID_$idx) terminated.\" ; fi ; "
        idx=$((idx + 1))
    done

    local exec_start_cmd
    if [ -n "$sidecars_exec" ]; then
        # Spawn daemon first, sleep 2, check if daemon failed to start, spawn sidecars, then wait on daemon
        exec_start_cmd="/bin/bash -c '$VENV_DIR/bin/nanobot gateway --config $CONFIG_FILE --port \$NANOBOT_PORT & MAIN_PID=\$! ; sleep 2 ; if ! kill -0 \$MAIN_PID 2>/dev/null; then echo \"Main daemon process (PID \$MAIN_PID) failed to start.\" >&2 ; exit 1 ; fi ; $sidecars_exec wait -n ; if ! kill -0 \$MAIN_PID 2>/dev/null; then echo \"Main daemon process (PID \$MAIN_PID) terminated.\" ; fi ; $sidecar_check exit 1'"
    else
        exec_start_cmd="$VENV_DIR/bin/nanobot gateway --config $CONFIG_FILE --port \$NANOBOT_PORT"
    fi

    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=Nanobot Service
After=network.target
StartLimitIntervalSec=40
StartLimitBurst=4

[Service]
Type=simple
$(get_shared_options service)
ExecStart=$exec_start_cmd
Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nanobot

# Note: ProtectProc=invisible and ProcSubset=pid are omitted
# because they can cause bwrap's /proc bind to fail.
# RestrictNamespaces=yes is also omitted since bwrap fundamentally relies on CLONE_NEWUSER and CLONE_NEWNS.

[Install]
WantedBy=default.target
EOF

    if is_systemd_running; then
        systemctl --user daemon-reload
    fi
}

cmd_install() {
    local no_start=false
    local new_config=false
    while [ $# -gt 0 ]; do
        case "$1" in
        --no-start) no_start=true ;;
        --new-config) new_config=true ;;
        esac
        shift
    done

    require_uv
    echo "Installing nanobot and its virtual environment..."

    mkdir -p "$(dirname "$VENV_DIR")"
    uv venv --clear --python /usr/bin/python3 "$VENV_DIR"

    echo "Installing package into virtual environment..."
    uv pip install --python "$VENV_DIR" "$PACKAGE"

    if [ ! -d "$NANOBOT_HOME" ]; then
        mkdir -p "$NANOBOT_HOME"
        echo "Created $NANOBOT_HOME"
    fi
    if [ ! -f "$CONFIG_FILE" ] || [ "$new_config" = "true" ]; then
        cat >"$CONFIG_FILE" <<'EOF'
{
  "providers": {
    "openai_compatible": {
      "local": {
        "api_key": "unused",
        "base_url": "http://localhost:50080/v1"
      }
    },
    "openai": {
      "api_key": "unused",
      "api_base": "http://localhost:50100/v1"
    }
  },
  "agents": {
    "defaults": {
      "provider": "openai_compatible/local",
      "model": "qwen3",
      "context_window_tokens": 80128
    }
  },
  "embeddings": {
    "provider": "openai_compatible/local",
    "model": "qwen3-embedding",
    "api_key": "unused",
    "base_url": "http://localhost:50082/v1"
  },
  "tools": {
    "image_generation": {
      "enabled": true,
      "provider": "openai",
      "model": "stability-ai/sdxl"
    },
    "mcp_servers": {
      "local-reranker": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-fetch"],
        "env": {
          "RERANK_URL": "http://localhost:50086/v1/rerank",
          "RERANK_MODEL": "qwen3-reranker"
        }
      }
    }
  },
  "transcription": {
    "provider": "openai",
    "openai": {
      "api_key": "dummy",
      "base_url": "http://localhost:50090/v1"
    }
  }
}
EOF
        echo "Created default config at $CONFIG_FILE"
    fi

    echo "Generating systemd user service..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    if [ ! -f "$ENV_FILE" ] || [ "$new_config" = "true" ]; then
        cat >"$ENV_FILE" <<'EOF'
# Nanobot Environment Configuration

# NANOBOT_PORT: Gateway port for Nanobot (default 8790)
NANOBOT_PORT=8790

# List of submounts from ~/agent-private/* to bind-mount into the sandbox
# (e.g., AGENT_PRIVATE_MOUNTS="health diary" binds ~/agent-private/health and ~/agent-private/diary)
# AGENT_PRIVATE_MOUNTS=""

# List of submounts from other sandboxes (e.g., opencode) to bind-mount into this assistant's sandbox
AGENT_SANDBOX_MOUNTS="opencode/.cache/opencode opencode/.config/opencode opencode/.local/share/opencode opencode/.local/state/opencode deep-research/.cache/deep-research-profiles deep-research/.config/deep-research-profiles"

# List of extra mounts to bind-mount into the sandbox (syntax: absolute-dir:relative-dir-to-HOME)
AGENT_EXTRA_MOUNTS="%h/agent-shared:agent-shared"

# Agent sandbox workspace path
AGENT_WORKSPACE="%h/.local/sandbox/nanobot/.nanobot/workspace"

# Agent sidecar list
# AGENT_SIDECARS="audionotes"
# AGENT_SIDECAR_AUDIONOTES_CMD="$AGENT_WORKSPACE/scripts/audionotes.sh"
# AGENT_SIDECAR_AUDIONOTES_ARGS="$AGENT_WORKSPACE/audionotes"

# systemd-tmpfiles cleanup policy status
AGENT_TMPFILES_CLEANUP=false

# Local Inference config
OPENAI_API_KEY="dummy"
EOF
        chmod 600 "$ENV_FILE"
        echo "Created default environment file at $ENV_FILE"
    fi

    write_service_file

    if is_systemd_running; then
        echo "Reloading systemd and enabling service..."
        systemctl --user enable "${SERVICE_NAME}.service"

        if [ "$no_start" = "true" ]; then
            echo "Stopping service if running (--no-start specified)..."
            systemctl --user stop "${SERVICE_NAME}.service" || true
        else
            echo "Starting service automatically..."
            systemctl --user start "${SERVICE_NAME}.service"
        fi
    else
        echo "Systemd is not running/available in this environment. Skipping systemd service activation."
    fi

    echo "---------------------------------------------------------------------------"
    echo "Nanobot installation complete!"
    echo "---------------------------------------------------------------------------"
    echo "Done! Type '$0 logs' to see the output."
}

cmd_uninstall() {
    echo "Uninstalling nanobot systemd service..."
    if is_systemd_running; then
        systemctl --user stop "${SERVICE_NAME}.service" || true
        systemctl --user disable "${SERVICE_NAME}.service" || true
    fi

    if [ -f "$SERVICE_FILE" ]; then
        rm "$SERVICE_FILE"
        if is_systemd_running; then
            systemctl --user daemon-reload
        fi
        echo "Removed service file."
    fi
    echo "Uninstalled successfully. Data in $NANOBOT_HOME and configuration in $ENV_FILE are preserved."
}

cmd_start() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user start "${SERVICE_NAME}.service"
}

cmd_stop() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user stop "${SERVICE_NAME}.service"
}

cmd_restart() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user restart "${SERVICE_NAME}.service"
}

cmd_status() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user status "${SERVICE_NAME}.service"
}

cmd_enable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user enable "${SERVICE_NAME}.service"
}

cmd_disable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user disable "${SERVICE_NAME}.service"
}

cmd_logs() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    journalctl --user -u "${SERVICE_NAME}.service" "$@"
}

cmd_edit() {
    mkdir -p "$(dirname "$ENV_FILE")"
    touch "$ENV_FILE"

    local tmpfiles_config="${XDG_CONFIG_HOME:-$HOME/.config}/user-tmpfiles.d/${SERVICE_NAME}.conf"
    local edit_files=("$ENV_FILE")
    if [ -f "$tmpfiles_config" ]; then
        edit_files+=("$tmpfiles_config")
    elif [ -f "${tmpfiles_config}.disabled" ]; then
        edit_files+=("${tmpfiles_config}.disabled")
    fi

    ${EDITOR:-nano} "${edit_files[@]}"
    if is_systemd_running; then
        echo "Restarting service to apply updated environment..."
        cmd_restart
    else
        echo "Systemd is not running. Service restart skipped."
    fi
}

setup_fallback_environment() {
    # Set default AGENT_WORKSPACE before sourcing so self-referencing variables expand correctly
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-$NANOBOT_HOME/.nanobot/workspace}"
    if [ -f "$ENV_FILE" ]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set +a
        set -u
    fi
    export HOME="$NANOBOT_HOME"
    export NANOBOT_CONFIG="$NANOBOT_HOME/config.json"
    export NANOBOT_PORT="${NANOBOT_PORT:-8790}"

    local ws="${AGENT_WORKSPACE}"
    ws="${ws//%h/$HOME}"
    if [[ "$ws" =~ ^~ ]]; then
        ws="${ws/#\~/$HOME}"
    fi
    export AGENT_WORKSPACE="$ws"
    mkdir -p "$NANOBOT_HOME" "$AGENT_WORKSPACE"
    cd "$NANOBOT_HOME" || exit 1
}

FALLBACK_SIDECAR_PIDS=()
FALLBACK_SIDECAR_NAMES=()

spawn_fallback_sidecars() {
    local sidecars_val="${AGENT_SIDECARS:-}"
    sidecars_val="${sidecars_val//;/ }"
    sidecars_val="${sidecars_val//$'\n'/ }"

    for sidecar in ${sidecars_val}; do
        local var_name
        var_name=$(sanitize_var_name "$sidecar")
        local cmd_var="AGENT_SIDECAR_${var_name}_CMD"
        local cmd_val="${!cmd_var:-}"
        if [ -z "$cmd_val" ]; then
            cmd_val="$sidecar"
        fi

        local args_var="AGENT_SIDECAR_${var_name}_ARGS"
        local args_val="${!args_var:-}"

        # Resolve paths
        local check_cmd="$cmd_val"
        check_cmd="${check_cmd//\$AGENT_WORKSPACE/$AGENT_WORKSPACE}"
        check_cmd="${check_cmd//\$HOME/$HOME}"
        check_cmd="${check_cmd//%h/$HOME}"
        if [[ "$check_cmd" =~ ^~ ]]; then
            check_cmd="${check_cmd/#\~/$HOME}"
        fi
        if ! command -v "$check_cmd" >/dev/null 2>&1 && [ ! -x "$check_cmd" ]; then
            echo "Error: Cannot spawn sidecar $sidecar because its executable '$cmd_val' (resolved: '$check_cmd') is missing or not executable." >&2
            exit 1
        fi

        # Process env removes and overrides
        local env_remove_var="AGENT_SIDECAR_${var_name}_ENV_REMOVE"
        local env_remove_val="${!env_remove_var:-}"

        local env_override_var="AGENT_SIDECAR_${var_name}_ENV_OVERRIDE"
        local env_override_val="${!env_override_var:-}"

        (
            # Apply removes
            for r in ${env_remove_val}; do
                unset "$r"
            done
            # Apply overrides
            for o in ${env_override_val}; do
                # shellcheck disable=SC2163
                export "$o"
            done
            # Execute
            eval "exec $cmd_val $args_val"
        ) &
        FALLBACK_SIDECAR_PIDS+=($!)
        FALLBACK_SIDECAR_NAMES+=("$sidecar")
    done
}

cmd_exec() {
    if [ ! -d "$VENV_DIR" ]; then
        echo "Virtual environment not found. Please run 'nanobot-ctl install' first."
        exit 1
    fi
    if ! is_systemd_running; then
        echo "Systemd is not running. Running nanobot directly..."
        setup_fallback_environment

        if [ "${1:-}" = "gateway" ]; then
            # Run cleanup if enabled
            if [ "${AGENT_TMPFILES_CLEANUP:-false}" = "true" ]; then
                echo "Running systemd-tmpfiles cleanup..."
                systemd-tmpfiles --user --create --clean || true
            fi
            # Run daemon in the background
            "$VENV_DIR/bin/nanobot" "$@" &
            local main_pid=$!
            sleep 2
            if ! kill -0 "$main_pid" 2>/dev/null; then
                echo "Main daemon process (PID $main_pid) failed to start." >&2
                exit 1
            fi
            spawn_fallback_sidecars
            wait -n

            # Identify which process died
            if ! kill -0 "$main_pid" 2>/dev/null; then
                echo "Main daemon process (PID $main_pid) terminated."
            fi
            for i in "${!FALLBACK_SIDECAR_PIDS[@]}"; do
                local pid="${FALLBACK_SIDECAR_PIDS[$i]}"
                local name="${FALLBACK_SIDECAR_NAMES[$i]}"
                if ! kill -0 "$pid" 2>/dev/null; then
                    echo "Sidecar $name (PID $pid) terminated."
                fi
            done
            exit 1
        else
            exec "$VENV_DIR/bin/nanobot" "$@"
        fi
    fi
    echo "Starting nanobot as a transient systemd service with args: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    # Use the full path to the binary in the VENV
    systemd-run "${opts[@]}" "$VENV_DIR/bin/nanobot" "$@"
}

cmd_run() {
    if [ ! -d "$VENV_DIR" ]; then
        echo "Virtual environment not found. Please run 'nanobot-ctl install' first."
        exit 1
    fi
    if [ $# -lt 1 ]; then
        echo "Error: run requires a command to execute." >&2
        exit 1
    fi
    if ! is_systemd_running; then
        echo "Systemd is not running. Running command directly..."
        setup_fallback_environment
        exec "$@"
    fi
    echo "Running command inside the nanobot environment: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "$@"
}

cmd_shell() {
    if [ ! -d "$VENV_DIR" ]; then
        echo "Virtual environment not found. Please run 'nanobot-ctl install' first."
        exit 1
    fi
    if ! is_systemd_running; then
        echo "Systemd is not running. Starting direct interactive shell..."
        setup_fallback_environment
        exec "${SHELL:-/bin/bash}" "$@"
    fi
    echo "Starting interactive shell in the nanobot systemd environment..."

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "${SHELL:-/bin/bash}" "$@"
}

usage() {
    echo "Usage: $0 <command>"
    echo "Commands:"
    echo "  install [--no-start] [--new-config] - Setup service and nanobot home directory (do not start service if --no-start is specified, overwrite configs with defaults if --new-config is specified)"
    echo "  uninstall - Stop and remove systemd service"
    echo "  start     - Start the systemd service"
    echo "  stop      - Stop the systemd service"
    echo "  restart   - Restart the systemd service"
    echo "  status    - View systemd service status"
    echo "  enable    - Enable systemd service on boot"
    echo "  disable   - Disable systemd service on boot"
    echo "  logs      - Tail the systemd service logs"
    echo "  edit      - Edit the .env file and restart the service upon exit"
    echo "  exec      - Run nanobot as a transient systemd user service with args"
    echo "  run       - Run a command inside the nanobot systemd environment"
    echo "  shell     - Spawn an interactive shell in the nanobot systemd environment"
}

main() {
    if [ $# -lt 1 ]; then
        usage
        exit 1
    fi

    COMMAND="$1"
    shift

    case "$COMMAND" in
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    status) cmd_status ;;
    enable) cmd_enable ;;
    disable) cmd_disable ;;
    logs) cmd_logs "$@" ;;
    edit) cmd_edit ;;
    exec) cmd_exec "$@" ;;
    run) cmd_run "$@" ;;
    shell) cmd_shell "$@" ;;
    *)
        echo "Unknown command: $COMMAND"
        usage
        exit 1
        ;;
    esac
}

main "$@"
