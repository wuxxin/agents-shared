#!/usr/bin/env bash
set -euo pipefail

# picoclaw-ctl - installation and management wrapper for picoclaw

SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/picoclaw.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/picoclaw.env"
PICOCLAW_HOME="$HOME/.local/sandbox/picoclaw"

is_systemd_running() {
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/private" ]
}

get_shared_options() {
    local mode="$1" # "service" or "transient"
    local home_spec
    if [ "$mode" = "service" ]; then
        home_spec="%h"
    else
        home_spec="$HOME"
    fi

    local AGENT_PRIVATE_MOUNTS=""
    local AGENT_SANDBOX_MOUNTS=""
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    # Environment & Working Directory
    echo "Environment=PICOCLAW_HOME=${home_spec}/.local/sandbox/picoclaw"
    echo "Environment=PICOCLAW_CONFIG=${home_spec}/.local/sandbox/picoclaw/config.json"
    echo "Environment=PICOCLAW_BINARY=/usr/bin/picoclaw"
    echo "Environment=HOME=${home_spec}/.local/sandbox/picoclaw"
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/picoclaw.env"
    echo "WorkingDirectory=${home_spec}/.local/sandbox/picoclaw"

    # Security measures
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet="
    echo "AmbientCapabilities="

    # Filesystem isolation
    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    # Retain changes by bind mounting the explicit picoclaw home directory
    echo "BindPaths=${home_spec}/.local/sandbox/picoclaw:${home_spec}/.local/sandbox/picoclaw"
    # Allow access to agent-shared as requested
    echo "BindPaths=${home_spec}/agent-shared:${home_spec}/agent-shared"

    for m in ${AGENT_PRIVATE_MOUNTS:-}; do
        mkdir -p "$HOME/agent-private/$m"
        echo "BindPaths=${home_spec}/agent-private/$m:${home_spec}/agent-private/$m"
    done

    for m in ${AGENT_SANDBOX_MOUNTS:-}; do
        local sandbox_name="${m%%/*}"
        local subpath="${m#*/}"
        mkdir -p "$HOME/.local/sandbox/${sandbox_name}/${subpath}"
        mkdir -p "$HOME/.local/sandbox/picoclaw/${subpath}"
        echo "BindPaths=${home_spec}/.local/sandbox/${sandbox_name}/${subpath}:${home_spec}/.local/sandbox/picoclaw/${subpath}"
    done

    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=yes"
    echo "PrivateMounts=yes"

    # Kernel and IPC constraints
    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "LockPersonality=yes"
    echo "MemoryDenyWriteExecute=no"
    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

write_service_file() {
    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=PicoClaw Launcher web console service
Documentation=https://github.com/sipeed/picoclaw
After=network.target

[Service]
Type=simple
$(get_shared_options service)
ExecStart=/usr/bin/picoclaw-launcher -no-browser
Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=picoclaw

[Install]
WantedBy=default.target
EOF

    if is_systemd_running; then
        systemctl --user daemon-reload
    fi
}

cmd_install() {
    local no_start=false
    local new_config=false
    while [ $# -gt 0 ]; do
        case "$1" in
        --no-start) no_start=true ;;
        --new-config) new_config=true ;;
        esac
        shift
    done

    echo "Setting up picoclaw home directory at $PICOCLAW_HOME..."
    mkdir -p "$PICOCLAW_HOME"

    if [ ! -f "$PICOCLAW_HOME/config.json" ] || [ "$new_config" = "true" ]; then
        cat >"$PICOCLAW_HOME/config.json" <<'EOF'
{
  "version": 3,
  "agents": {
    "defaults": {
      "model_name": "qwen3",
      "context_window": 80128
    }
  },
  "model_list": [
    {
      "model_name": "qwen3",
      "provider": "openai",
      "model": "qwen3",
      "api_keys": ["unused"],
      "api_base": "http://localhost:50080/v1"
    },
    {
      "model_name": "local_stt",
      "provider": "openai",
      "model": "whisper-1",
      "api_keys": ["dummy"],
      "api_base": "http://localhost:50090/v1"
    },
    {
      "model_name": "local_tts",
      "provider": "openai",
      "model": "qwen3-tts",
      "api_keys": ["dummy"],
      "api_base": "http://localhost:50095/v1"
    }
  ],
  "embeddings": {
    "provider": "openai",
    "model": "qwen3-embedding",
    "base_url": "http://localhost:50082/v1",
    "api_key": "unused"
  },
  "tools": {
    "mcp": {
      "servers": {
        "local-reranker": {
          "command": "npx",
          "args": ["-y", "@modelcontextprotocol/server-fetch"],
          "env": {
            "RERANK_URL": "http://localhost:50086/v1/rerank",
            "RERANK_MODEL": "qwen3-reranker"
          }
        }
      }
    }
  },
  "voice": {
    "model_name": "local_stt",
    "tts_model_name": "local_tts"
  }
}
EOF
        echo "Created default config at $PICOCLAW_HOME/config.json"
    fi

    echo "Generating systemd user service..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    if [ ! -f "$ENV_FILE" ] || [ "$new_config" = "true" ]; then
        cat >"$ENV_FILE" <<'EOF'
# picoclaw.env

# PicoClaw Environment Configuration


# List of submounts from ~/agent-private/* to bind-mount into the sandbox
# (e.g., AGENT_PRIVATE_MOUNTS="health diary" binds ~/agent-private/health and ~/agent-private/diary)
# AGENT_PRIVATE_MOUNTS=""

# List of submounts from other sandboxes (e.g., opencode) to bind-mount into this assistant's sandbox
# (e.g., AGENT_SANDBOX_MOUNTS="opencode/.cache/opencode opencode/.config/opencode opencode/.local/share/opencode opencode/.local/state/opencode")
# AGENT_SANDBOX_MOUNTS=""
EOF
        chmod 600 "$ENV_FILE"
    fi

    write_service_file

    if is_systemd_running; then
        echo "Reloading systemd and enabling service..."
        systemctl --user enable picoclaw.service

        if [ "$no_start" = "true" ]; then
            echo "Stopping service if running (--no-start specified)..."
            systemctl --user stop picoclaw.service || true
        else
            echo "Starting service automatically..."
            systemctl --user start picoclaw.service
        fi
    else
        echo "Systemd is not running/available in this environment. Skipping systemd service activation."
    fi

    echo "Done! Type '$0 logs' to see the output."
}

cmd_uninstall() {
    echo "Uninstalling picoclaw systemd service..."
    if is_systemd_running; then
        systemctl --user stop picoclaw.service || true
        systemctl --user disable picoclaw.service || true
    fi

    if [ -f "$SERVICE_FILE" ]; then
        rm "$SERVICE_FILE"
        if is_systemd_running; then
            systemctl --user daemon-reload
        fi
        echo "Removed service file."
    fi
    echo "Uninstalled successfully. Data in $PICOCLAW_HOME is preserved."
}

cmd_start() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user start picoclaw.service
}

cmd_stop() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user stop picoclaw.service
}

cmd_restart() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user restart picoclaw.service
}

cmd_status() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user status picoclaw.service
}

cmd_enable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user enable picoclaw.service
}

cmd_disable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user disable picoclaw.service
}

cmd_logs() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    journalctl --user -u picoclaw.service "$@"
}

cmd_edit() {
    mkdir -p "$(dirname "$ENV_FILE")"
    touch "$ENV_FILE"
    ${EDITOR:-nano} "$ENV_FILE"
    if is_systemd_running; then
        echo "Restarting service to apply updated environment..."
        cmd_restart
    else
        echo "Systemd is not running. Service restart skipped."
    fi
}

cmd_exec() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running picoclaw directly..."
        if [ -f "$ENV_FILE" ]; then
            set +u
            set -a
            # shellcheck disable=SC1090
            source "$ENV_FILE"
            set +a
            set -u
        fi
        export HOME="$PICOCLAW_HOME"
        export PICOCLAW_HOME="$PICOCLAW_HOME"
        export PICOCLAW_CONFIG="$PICOCLAW_HOME/config.json"
        export PICOCLAW_BINARY=/usr/bin/picoclaw
        cd "$PICOCLAW_HOME"
        exec /usr/bin/picoclaw "$@"
    fi
    echo "Starting picoclaw as a transient systemd service with args: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" /usr/bin/picoclaw "$@"
}

cmd_shell() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Starting direct interactive shell..."
        if [ -f "$ENV_FILE" ]; then
            set +u
            set -a
            # shellcheck disable=SC1090
            source "$ENV_FILE"
            set +a
            set -u
        fi
        export HOME="$PICOCLAW_HOME"
        export PICOCLAW_HOME="$PICOCLAW_HOME"
        export PICOCLAW_CONFIG="$PICOCLAW_HOME/config.json"
        export PICOCLAW_BINARY=/usr/bin/picoclaw
        cd "$PICOCLAW_HOME"
        exec "${SHELL:-/bin/bash}" "$@"
    fi
    echo "Starting interactive shell as a transient systemd service..."

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "${SHELL:-/bin/bash}" "$@"
}

cmd_run() {
    if [ $# -lt 1 ]; then
        echo "Error: run requires a command to execute." >&2
        exit 1
    fi
    if ! is_systemd_running; then
        echo "Systemd is not running. Running command directly..."
        if [ -f "$ENV_FILE" ]; then
            set +u
            set -a
            # shellcheck disable=SC1090
            source "$ENV_FILE"
            set +a
            set -u
        fi
        export HOME="$PICOCLAW_HOME"
        export PICOCLAW_HOME="$PICOCLAW_HOME"
        export PICOCLAW_CONFIG="$PICOCLAW_HOME/config.json"
        export PICOCLAW_BINARY=/usr/bin/picoclaw
        cd "$PICOCLAW_HOME"
        exec "$@"
    fi
    echo "Running command inside the picoclaw environment: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "$@"
}

usage() {
    echo "Usage: $0 <command>"
    echo "Commands:"
    echo "  install [--no-start] [--new-config] - Setup service and picoclaw home directory (do not start service if --no-start is specified, overwrite configs with defaults if --new-config is specified)"
    echo "  uninstall - Stop and remove systemd service"
    echo "  start     - Start the systemd service"
    echo "  stop      - Stop the systemd service"
    echo "  restart   - Restart the systemd service"
    echo "  status    - View systemd service status"
    echo "  enable    - Enable systemd service on boot"
    echo "  disable   - Disable systemd service on boot"
    echo "  logs      - Tail the systemd service logs"
    echo "  edit      - Edit the .env file and restart the service upon exit"
    echo "  exec      - Run picoclaw as a transient systemd user service with args"
    echo "  run       - Run a command inside the picoclaw systemd environment"
    echo "  shell     - Spawn an interactive shell in the picoclaw systemd environment"
}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
install) cmd_install "$@" ;;
uninstall) cmd_uninstall ;;
start) cmd_start ;;
stop) cmd_stop ;;
restart) cmd_restart ;;
status) cmd_status ;;
enable) cmd_enable ;;
disable) cmd_disable ;;
logs) cmd_logs "$@" ;;
edit) cmd_edit ;;
exec) cmd_exec "$@" ;;
run) cmd_run "$@" ;;
shell) cmd_shell "$@" ;;
*)
    echo "Unknown command: $COMMAND"
    usage
    exit 1
    ;;
esac
