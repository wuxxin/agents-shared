#!/usr/bin/env bash
set -euo pipefail

# ironclaw-ctl - installation and management wrapper for ironclaw
#
# Toggle between versions by setting IRONCLAW_REBORN=true/false or ENGINE_V2=true/false
# in ~/.config/systemd/user/ironclaw.env or ~/.local/sandbox/ironclaw/.ironclaw/.env.

SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/ironclaw.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/ironclaw.env"
IRONCLAW_HOME="$HOME/.local/sandbox/ironclaw"

is_systemd_running() {
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/private" ]
}

is_reborn() {
    local val_reborn="${IRONCLAW_REBORN:-}"
    local val_v2="${ENGINE_V2:-}"

    # If env vars are not set in shell environment, read from config files
    if [ -z "$val_reborn" ] && [ -z "$val_v2" ]; then
        if [ -f "$ENV_FILE" ]; then
            val_reborn=$(grep -E '^\s*IRONCLAW_REBORN=' "$ENV_FILE" | cut -d= -f2- | tr -d '"'\'' ')
            val_v2=$(grep -E '^\s*ENGINE_V2=' "$ENV_FILE" | cut -d= -f2- | tr -d '"'\'' ')
        fi
        local app_env_file="$IRONCLAW_HOME/.ironclaw/.env"
        if [ -z "$val_reborn" ] && [ -z "$val_v2" ] && [ -f "$app_env_file" ]; then
            val_reborn=$(grep -E '^\s*IRONCLAW_REBORN=' "$app_env_file" | cut -d= -f2- | tr -d '"'\'' ')
            val_v2=$(grep -E '^\s*ENGINE_V2=' "$app_env_file" | cut -d= -f2- | tr -d '"'\'' ')
        fi
    fi

    if [ "$val_reborn" = "true" ] || [ "$val_v2" = "true" ]; then
        return 0
    fi
    return 1
}

setup_direct_env() {
    if [ -f "$ENV_FILE" ]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set +a
        set -u
    fi
    local app_env_file="$IRONCLAW_HOME/.ironclaw/.env"
    if [ -f "$app_env_file" ]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$app_env_file"
        set +a
        set -u
    fi
    export HOME="$IRONCLAW_HOME"
    export HTTP_PORT="${HTTP_PORT:-8080}"
    export HTTP_HOST="${HTTP_HOST:-127.0.0.1}"
    export DATABASE_URL="${DATABASE_URL:-postgres://localhost/ironclaw}"
    if is_reborn; then
        export IRONCLAW_REBORN_HOME="$IRONCLAW_HOME/.ironclaw/reborn"
        export IRONCLAW_REBORN_PROFILE="${IRONCLAW_REBORN_PROFILE:-local-dev-yolo}"
        export IRONCLAW_REBORN_WEBUI_TOKEN="${IRONCLAW_REBORN_WEBUI_TOKEN:-local_reborn_token}"
        export IRONCLAW_REBORN_WEBUI_USER_ID="${IRONCLAW_REBORN_WEBUI_USER_ID:-default-owner}"
    fi
}

get_exec_cmd_and_args() {
    # Sets variables EXEC_PATH and EXTRA_ARGS
    if is_reborn; then
        EXEC_PATH="/usr/bin/ironclaw-reborn"
        if [ ! -x "$EXEC_PATH" ]; then
            echo "Error: Reborn is selected, but $EXEC_PATH is not executable." >&2
            echo "Please install the ironclaw-reborn-git package." >&2
            exit 1
        fi
        EXTRA_ARGS=()
        if [ $# -gt 0 ]; then
            local cmd="$1"
            if [ "$cmd" = "serve" ] || [ "$cmd" = "repl" ] || [ "$cmd" = "run" ]; then
                # Check profile
                local profile="${IRONCLAW_REBORN_PROFILE:-}"
                if [ -z "$profile" ]; then
                    if [ -f "$ENV_FILE" ]; then
                        profile=$(grep -E '^\s*IRONCLAW_REBORN_PROFILE=' "$ENV_FILE" | cut -d= -f2- | tr -d '"'\'' ')
                    fi
                    local app_env_file="$IRONCLAW_HOME/.ironclaw/.env"
                    if [ -z "$profile" ] && [ -f "$app_env_file" ]; then
                        profile=$(grep -E '^\s*IRONCLAW_REBORN_PROFILE=' "$app_env_file" | cut -d= -f2- | tr -d '"'\'' ')
                    fi
                fi
                if [ "$profile" = "local-dev-yolo" ]; then
                    # Only append if not already present in the arguments
                    local found_confirm=false
                    for arg in "$@"; do
                        if [ "$arg" = "--confirm-host-access" ]; then
                            found_confirm=true
                        fi
                    done
                    if [ "$found_confirm" = "false" ]; then
                        EXTRA_ARGS+=("--confirm-host-access")
                    fi
                fi
            fi
        fi
    else
        EXEC_PATH="/usr/bin/ironclaw"
        if [ ! -x "$EXEC_PATH" ]; then
            echo "Error: Legacy IronClaw is selected, but $EXEC_PATH is not executable." >&2
            echo "Please install the ironclaw-git package." >&2
            exit 1
        fi
        EXTRA_ARGS=()
    fi
}

get_shared_options() {
    local mode="$1" # "service" or "transient"
    local home_spec
    if [ "$mode" = "service" ]; then
        home_spec="%h"
    else
        home_spec="$HOME"
    fi

    local AGENT_PRIVATE_MOUNTS=""
    local AGENT_SANDBOX_MOUNTS=""
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi
    local app_env_file="$IRONCLAW_HOME/.ironclaw/.env"
    if [ -f "$app_env_file" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$app_env_file"
        set -u
    fi

    # Environment & Working Directory
    echo "Environment=HOME=${home_spec}/.local/sandbox/ironclaw"
    echo "Environment=HTTP_HOST=${HTTP_HOST:-127.0.0.1}"
    echo "Environment=HTTP_PORT=${HTTP_PORT:-8080}"
    echo "Environment=DATABASE_URL=${DATABASE_URL:-postgres://localhost/ironclaw}"
    if is_reborn; then
        echo "Environment=IRONCLAW_REBORN_HOME=${home_spec}/.local/sandbox/ironclaw/.ironclaw/reborn"
        echo "Environment=IRONCLAW_REBORN_PROFILE=${IRONCLAW_REBORN_PROFILE:-local-dev-yolo}"
        echo "Environment=IRONCLAW_REBORN_POSTGRES_URL=${IRONCLAW_REBORN_POSTGRES_URL:-}"
        echo "Environment=IRONCLAW_REBORN_SECRET_MASTER_KEY=${IRONCLAW_REBORN_SECRET_MASTER_KEY:-}"
        echo "Environment=IRONCLAW_REBORN_WEBUI_TOKEN=${IRONCLAW_REBORN_WEBUI_TOKEN:-local_reborn_token}"
        echo "Environment=IRONCLAW_REBORN_WEBUI_USER_ID=${IRONCLAW_REBORN_WEBUI_USER_ID:-default-owner}"
    fi
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/ironclaw.env"
    echo "EnvironmentFile=-${home_spec}/.local/sandbox/ironclaw/.ironclaw/.env"
    echo "WorkingDirectory=${home_spec}/.local/sandbox/ironclaw"

    # Security measures
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet="
    echo "AmbientCapabilities="

    # Filesystem isolation
    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    echo "BindPaths=${home_spec}/.local/sandbox/ironclaw:${home_spec}/.local/sandbox/ironclaw"
    echo "BindPaths=${home_spec}/agent-shared:${home_spec}/agent-shared"

    for m in ${AGENT_PRIVATE_MOUNTS:-}; do
        mkdir -p "$HOME/agent-private/$m"
        echo "BindPaths=${home_spec}/agent-private/$m:${home_spec}/agent-private/$m"
    done

    for m in ${AGENT_SANDBOX_MOUNTS:-}; do
        local sandbox_name="${m%%/*}"
        local subpath="${m#*/}"
        mkdir -p "$HOME/.local/sandbox/${sandbox_name}/${subpath}"
        mkdir -p "$HOME/.local/sandbox/ironclaw/${subpath}"
        echo "BindPaths=${home_spec}/.local/sandbox/${sandbox_name}/${subpath}:${home_spec}/.local/sandbox/ironclaw/${subpath}"
    done

    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=yes"
    echo "PrivateMounts=yes"

    # Kernel and IPC constraints
    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "LockPersonality=yes"
    echo "MemoryDenyWriteExecute=no"
    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

write_service_file() {
    local exec_path
    local exec_args
    if is_reborn; then
        exec_path="/usr/bin/ironclaw-reborn"
        if [ ! -x "$exec_path" ]; then
            echo "Warning: $exec_path is not executable. Make sure ironclaw-reborn-git is installed." >&2
        fi
        local extra_args=""
        if [ "${IRONCLAW_REBORN_PROFILE:-}" = "local-dev-yolo" ]; then
            extra_args=" --confirm-host-access"
        fi
        exec_args="serve --host \${HTTP_HOST:-127.0.0.1} --port \${HTTP_PORT:-8080}${extra_args}"
    else
        exec_path="/usr/bin/ironclaw"
        if [ ! -x "$exec_path" ]; then
            echo "Warning: $exec_path is not executable. Make sure ironclaw-git is installed." >&2
        fi
        exec_args="run"
    fi

    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=IronClaw Agent OS Daemon
Documentation=https://github.com/nearai/ironclaw
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
$(get_shared_options service)
ExecStart=${exec_path} ${exec_args}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ironclaw

# Note: ProtectProc=invisible, ProcSubset=pid, and RestrictNamespaces=yes
# are explicitly omitted to allow WASM sandbox and optional Docker workers.

[Install]
WantedBy=default.target
EOF

    if is_systemd_running; then
        systemctl --user daemon-reload
    fi
}

