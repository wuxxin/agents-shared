#!/usr/bin/env bash
set -euo pipefail

# ironclaw-ctl - installation and management wrapper for ironclaw

SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/ironclaw.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/ironclaw.env"
IRONCLAW_HOME="$HOME/.local/sandbox/ironclaw"

is_systemd_running() {
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/private" ]
}

get_shared_options() {
    local mode="$1" # "service" or "transient"
    local home_spec
    if [ "$mode" = "service" ]; then
        home_spec="%h"
    else
        home_spec="$HOME"
    fi

    local AGENT_PRIVATE_MOUNTS=""
    local AGENT_SANDBOX_MOUNTS=""
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    # Environment & Working Directory
    echo "Environment=HOME=${home_spec}/.local/sandbox/ironclaw"
    echo "Environment=HTTP_HOST=${HTTP_HOST:-127.0.0.1}"
    echo "Environment=HTTP_PORT=${HTTP_PORT:-8080}"
    echo "Environment=DATABASE_URL=${DATABASE_URL:-postgres://localhost/ironclaw}"
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/ironclaw.env"
    echo "WorkingDirectory=${home_spec}/.local/sandbox/ironclaw"

    # Security measures
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet="
    echo "AmbientCapabilities="

    # Filesystem isolation
    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    echo "BindPaths=${home_spec}/.local/sandbox/ironclaw:${home_spec}/.local/sandbox/ironclaw"
    echo "BindPaths=${home_spec}/agent-shared:${home_spec}/agent-shared"

    for m in ${AGENT_PRIVATE_MOUNTS:-}; do
        mkdir -p "$HOME/agent-private/$m"
        echo "BindPaths=${home_spec}/agent-private/$m:${home_spec}/agent-private/$m"
    done

    for m in ${AGENT_SANDBOX_MOUNTS:-}; do
        local sandbox_name="${m%%/*}"
        local subpath="${m#*/}"
        mkdir -p "$HOME/.local/sandbox/${sandbox_name}/${subpath}"
        mkdir -p "$HOME/.local/sandbox/ironclaw/${subpath}"
        echo "BindPaths=${home_spec}/.local/sandbox/${sandbox_name}/${subpath}:${home_spec}/.local/sandbox/ironclaw/${subpath}"
    done

    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=yes"
    echo "PrivateMounts=yes"

    # Kernel and IPC constraints
    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "LockPersonality=yes"
    echo "MemoryDenyWriteExecute=no"
    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

write_service_file() {
    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=IronClaw Agent OS Daemon
Documentation=https://github.com/nearai/ironclaw
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
$(get_shared_options service)
ExecStart=/usr/bin/ironclaw run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ironclaw

# Note: ProtectProc=invisible, ProcSubset=pid, and RestrictNamespaces=yes
# are explicitly omitted to allow WASM sandbox and optional Docker workers.

[Install]
WantedBy=default.target
EOF

    if is_systemd_running; then
        systemctl --user daemon-reload
    fi
}

cmd_install() {
    local no_start=false
    local new_config=false
    while [ $# -gt 0 ]; do
        case "$1" in
        --no-start) no_start=true ;;
        --new-config) new_config=true ;;
        esac
        shift
    done

    echo "Setting up ironclaw home directory at $IRONCLAW_HOME..."
    mkdir -p "$IRONCLAW_HOME"

    echo "Generating systemd user service..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    if [ ! -f "$ENV_FILE" ] || [ "$new_config" = "true" ]; then
        cat >"$ENV_FILE" <<'EOF'
# ironclaw.env — systemd bootstrap environment
# HTTP_HOST: Web gateway bind address (default 127.0.0.1)
HTTP_HOST=127.0.0.1
# HTTP_PORT: Web gateway listen port (default 8080)
HTTP_PORT=8080
# DATABASE_URL: PostgreSQL connection string (requires pgvector extension)
DATABASE_URL=postgres://localhost/ironclaw

# List of submounts from ~/agent-private/* to bind-mount into the sandbox
# (e.g., AGENT_PRIVATE_MOUNTS="health diary" binds ~/agent-private/health and ~/agent-private/diary)
# AGENT_PRIVATE_MOUNTS=""

# List of submounts from other sandboxes (e.g., opencode) to bind-mount into this assistant's sandbox
# (e.g., AGENT_SANDBOX_MOUNTS="opencode/.cache/opencode opencode/.config/opencode opencode/.local/share/opencode opencode/.local/state/opencode")
# AGENT_SANDBOX_MOUNTS=""

EOF
        chmod 600 "$ENV_FILE"
        echo "Created default environment file at $ENV_FILE"
    fi

    local APP_DIR="$IRONCLAW_HOME/.ironclaw"
    local APP_ENV_FILE="$APP_DIR/.env"
    if [ ! -f "$APP_ENV_FILE" ] || [ "$new_config" = "true" ]; then
        mkdir -p "$APP_DIR"
        cat >"$APP_ENV_FILE" <<'EOF'
# .env — IronClaw application configuration
# Generated by ironclaw-ctl install --new-config
# Config priority: Database/TOML > Environment > Defaults
# Note: dotenvy does not override vars already set by systemd EnvironmentFile.

# --- Local Chat / LLM Provider (local-chat on port 50080) ---
LLM_BACKEND=openai_compatible
LLM_API_KEY=unused
LLM_BASE_URL=http://localhost:50080/v1
LLM_MODEL=qwen3
# LLM_REQUEST_TIMEOUT_SECS=120

# --- Embeddings (local-embedding on port 50082) ---
EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=http://localhost:50082/v1
EMBEDDING_MODEL=qwen3-embedding
# EMBEDDING_DIMENSION=    # auto-detected from model

# --- Reranking ---
# IronClaw uses built-in Reciprocal Rank Fusion (RRF) for hybrid search
# combining full-text and vector results. No external reranker required.

# --- Speech-to-Text (local-speech-to-text on port 50090) ---
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_BASE_URL=http://localhost:50090/v1
TRANSCRIPTION_MODEL=whisper-1

# --- Text-to-Speech ---
# IronClaw does not support TTS natively. No TTS env vars available.

# --- Image Generation ---
# Image generation is handled via MCP tool output parsing.
# No dedicated image generation env vars are available.

# --- Signal Channel (signal-ctl on port 50889) ---
SIGNAL_ENABLED=true
SIGNAL_HTTP_URL=http://127.0.0.1:50889
# SIGNAL_ACCOUNT=+1234567890
# SIGNAL_ALLOW_FROM=+1234567890,uuid:your-uuid-here
SIGNAL_DM_POLICY=pairing
SIGNAL_GROUP_POLICY=allowlist
SIGNAL_IGNORE_ATTACHMENTS=false
SIGNAL_IGNORE_STORIES=true

# --- ACP (Agent Client Protocol for external coding agents, e.g. OpenCode) ---
# ACP_ENABLED=false
# ACP_TIMEOUT_SECS=1800

# --- Agent ---
AGENT_NAME=ironclaw
# AGENT_MAX_PARALLEL_JOBS=5
# AGENT_USE_PLANNING=true
# AGENT_MAX_TOOL_ITERATIONS=50
# ENGINE_V2=false

# --- Sandbox (WASM tool isolation) ---
SANDBOX_ENABLED=true
SANDBOX_POLICY=readonly

# --- Safety ---
SAFETY_INJECTION_CHECK_ENABLED=true

# --- Heartbeat ---
# HEARTBEAT_ENABLED=false
# HEARTBEAT_INTERVAL_SECS=1800

# --- Memory Hygiene ---
MEMORY_HYGIENE_ENABLED=true
# MEMORY_HYGIENE_VERSION_KEEP_COUNT=50
# MEMORY_HYGIENE_CADENCE_HOURS=12

# --- Logging ---
RUST_LOG=ironclaw=info,tower_http=info

EOF
        chmod 600 "$APP_ENV_FILE"
        echo "Created default application config at $APP_ENV_FILE"
    fi

    write_service_file

    if is_systemd_running; then
        echo "Reloading systemd and enabling service..."
        systemctl --user enable ironclaw.service

        if [ "$no_start" = "true" ]; then
            echo "Stopping service if running (--no-start specified)..."
            systemctl --user stop ironclaw.service || true
        else
            echo "Starting service automatically..."
            systemctl --user start ironclaw.service
        fi
    else
        echo "Systemd is not running. Service file generated but not started/enabled."
    fi

    echo "Done! Type '$0 logs' to see the output."
}

cmd_uninstall() {
    echo "Uninstalling ironclaw systemd service..."
    if is_systemd_running; then
        systemctl --user stop ironclaw.service || true
        systemctl --user disable ironclaw.service || true
    fi

    if [ -f "$SERVICE_FILE" ]; then
        rm "$SERVICE_FILE"
        if is_systemd_running; then
            systemctl --user daemon-reload
        fi
        echo "Removed service file."
    fi
    echo "Uninstalled successfully. Data in $IRONCLAW_HOME is preserved."
}

cmd_start() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Use 'exec' to run the assistant directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user start ironclaw.service
}

cmd_stop() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user stop ironclaw.service
}

cmd_restart() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Use 'exec' to run the assistant directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user restart ironclaw.service
}

cmd_status() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user status ironclaw.service
}

cmd_enable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user enable ironclaw.service
}

cmd_disable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user disable ironclaw.service
}

cmd_logs() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Check direct execution console output instead." >&2
        exit 1
    fi
    journalctl --user -u ironclaw.service "$@"
}

cmd_edit() {
    local app_env_file="$IRONCLAW_HOME/.ironclaw/.env"
    mkdir -p "$(dirname "$ENV_FILE")" "$(dirname "$app_env_file")"
    touch "$ENV_FILE" "$app_env_file"
    ${EDITOR:-nano} "$ENV_FILE" "$app_env_file"
    if is_systemd_running; then
        echo "Restarting service to apply updated environment..."
        cmd_restart
    else
        echo "Systemd is not running. Service restart skipped."
    fi
}

cmd_exec() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running ironclaw directly..."
        if [ -f "$ENV_FILE" ]; then
            set +u
            set -a
            # shellcheck disable=SC1090
            source "$ENV_FILE"
            set +a
            set -u
        fi
        export HOME="$IRONCLAW_HOME"
        export HTTP_PORT="${HTTP_PORT:-8080}"
        export HTTP_HOST="${HTTP_HOST:-127.0.0.1}"
        export DATABASE_URL="${DATABASE_URL:-postgres://localhost/ironclaw}"
        mkdir -p "$IRONCLAW_HOME"
        cd "$IRONCLAW_HOME" || exit 1
        exec /usr/bin/ironclaw "$@"
    fi

    echo "Starting ironclaw as a transient systemd service with args: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" /usr/bin/ironclaw "$@"
}

cmd_shell() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running shell directly..."
        if [ -f "$ENV_FILE" ]; then
            set +u
            set -a
            # shellcheck disable=SC1090
            source "$ENV_FILE"
            set +a
            set -u
        fi
        export HOME="$IRONCLAW_HOME"
        export HTTP_PORT="${HTTP_PORT:-8080}"
        export HTTP_HOST="${HTTP_HOST:-127.0.0.1}"
        export DATABASE_URL="${DATABASE_URL:-postgres://localhost/ironclaw}"
        mkdir -p "$IRONCLAW_HOME"
        cd "$IRONCLAW_HOME" || exit 1
        exec "${SHELL:-/bin/bash}" "$@"
    fi

    echo "Starting interactive shell as a transient systemd service..."

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "${SHELL:-/bin/bash}" "$@"
}

cmd_run() {
    if [ $# -lt 1 ]; then
        echo "Error: run requires a command to execute." >&2
        exit 1
    fi

    if ! is_systemd_running; then
        echo "Running command inside the ironclaw environment: $*"
        if [ -f "$ENV_FILE" ]; then
            set +u
            set -a
            # shellcheck disable=SC1090
            source "$ENV_FILE"
            set +a
            set -u
        fi
        export HOME="$IRONCLAW_HOME"
        export HTTP_PORT="${HTTP_PORT:-8080}"
        export HTTP_HOST="${HTTP_HOST:-127.0.0.1}"
        export DATABASE_URL="${DATABASE_URL:-postgres://localhost/ironclaw}"
        mkdir -p "$IRONCLAW_HOME"
        cd "$IRONCLAW_HOME" || exit 1
        exec "$@"
    fi

    echo "Running command inside the ironclaw environment: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "$@"
}

usage() {
    echo "Usage: $0 <command>"
    echo "Commands:"
    echo "  install [--no-start] [--new-config] - Setup service and ironclaw home directory (do not start service if --no-start is specified, overwrite configs with defaults if --new-config is specified)"
    echo "  uninstall - Stop and remove systemd service"
    echo "  start     - Start the systemd service"
    echo "  stop      - Stop the systemd service"
    echo "  restart   - Restart the systemd service"
    echo "  status    - View systemd service status"
    echo "  enable    - Enable systemd service on boot"
    echo "  disable   - Disable systemd service on boot"
    echo "  logs      - Tail the systemd service logs"
    echo "  edit      - Edit the .env and application config files"
    echo "  exec      - Run ironclaw as a transient systemd user service with args"
    echo "  run       - Run a command inside the ironclaw systemd environment"
    echo "  shell     - Spawn an interactive shell in the ironclaw systemd environment"
}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
install) cmd_install "$@" ;;
uninstall) cmd_uninstall ;;
start) cmd_start ;;
stop) cmd_stop ;;
restart) cmd_restart ;;
status) cmd_status ;;
enable) cmd_enable ;;
disable) cmd_disable ;;
logs) cmd_logs "$@" ;;
edit) cmd_edit ;;
exec) cmd_exec "$@" ;;
run) cmd_run "$@" ;;
shell) cmd_shell "$@" ;;
*)
    echo "Unknown command: $COMMAND"
    usage
    exit 1
    ;;
esac
