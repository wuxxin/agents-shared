cmd_install() {
    local no_start=false
    local new_config=false
    while [ $# -gt 0 ]; do
        case "$1" in
        --no-start) no_start=true ;;
        --new-config) new_config=true ;;
        esac
        shift
    done

    echo "Setting up ironclaw home directory at $IRONCLAW_HOME..."
    mkdir -p "$IRONCLAW_HOME"

    echo "Generating systemd user service..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    if [ ! -f "$ENV_FILE" ] || [ "$new_config" = "true" ]; then
        cat >"$ENV_FILE" <<'EOF'
# ironclaw.env — systemd bootstrap environment

# --- COMMON VARIABLES

# IRONCLAW_REBORN (default: true) to select the newer IronClaw Reborn engine or 'false' for Legacy engine.
# IRONCLAW_REBORN=false
# V2 Engine for IronClaw Legacy: (default: true, only selectable under legacy)
# ENGINE_V2=false

# HTTP_HOST: Web gateway bind address (default 127.0.0.1)
HTTP_HOST=127.0.0.1
# HTTP_PORT: Web gateway listen port (default 8080 for legacy, default 3000 for reborn serve)
HTTP_PORT=8080

# provider keys
LLM_API_KEY=unused
EMBEDDING_API_KEY=unused
RERANK_API_KEY=unused
TRANSCRIPTION_API_KEY=unused
TTS_API_KEY=unused
IMAGE_API_KEY=unused

OPENAI_API_KEY=unused

# signal account settings
# SIGNAL_HTTP_URL (Default: `http://127.0.0.1:50889`): The endpoint of the running `signal-cli` daemon
# SIGNAL_ACCOUNT: The phone number associated with the registered Signal bot account
# SIGNAL_ALLOW_FROM: A comma-separated list of phone numbers or UUIDs allowed to message the bot (e.g. `+1987654321,uuid:xxxx-xxxx-xxxx`)
#     Set to `*` to allow all senders. Leaving it empty forces new senders to go through the pairing flow.
# SIGNAL_DM_POLICY: (Default: `pairing`): The policy for direct messages. Can be `open`, `allowlist`, or `pairing`
# SIGNAL_GROUP_POLICY`** (Default: `allowlist`): The policy for group chats. Can be `allowlist`, `open`, or `disabled`
SIGNAL_HTTP_URL=http://127.0.0.1:50889

# --- REBORN VARIABLES
# IRONCLAW_REBORN_PROFILE: Boot profile selector. Supported values: local-dev, local-dev-yolo, production, migration-dry-run.
IRONCLAW_REBORN_PROFILE=local-dev-yolo

# Production PostgreSQL storage URL and secret master key when profile = production
# IRONCLAW_REBORN_POSTGRES_URL=postgres://localhost/ironclaw_reborn
# IRONCLAW_REBORN_SECRET_MASTER_KEY=your-secret-master-key
# IRONCLAW_REBORN_POSTGRES_POOL_MAX_SIZE=2

# Reborn Web GUI Auth (local authentication)
IRONCLAW_REBORN_WEBUI_TOKEN=local_reborn_token
IRONCLAW_REBORN_WEBUI_USER_ID=default-owner

# Reborn Tracing filter
# IRONCLAW_REBORN_LOG=debug,ironclaw_reborn=info


# --- LEGACY VARIABLES
# DATABASE_URL: PostgreSQL connection string (requires pgvector extension)
DATABASE_URL=postgres://localhost/ironclaw

# Tracing filter
# RUST_LOG=ironclaw=info,tower_http=info

# ACP / OpenCode Coding Agent Integration
# Enable Agent Client Protocol (ACP) for coding agents like OpenCode
ACP_ENABLED=true
# ACP_MEMORY_LIMIT_MB=4096
# ACP_TIMEOUT_SECS=1800


# --- SERVICE CONFIGURATION

# List of submounts from ~/agent-private/* to bind-mount into the sandbox
# (e.g., AGENT_PRIVATE_MOUNTS="health diary" binds ~/agent-private/health and ~/agent-private/diary)
# AGENT_PRIVATE_MOUNTS=""

# List of submounts from other sandboxes (e.g., opencode) to bind-mount into this assistant's sandbox
AGENT_SANDBOX_MOUNTS="\
opencode/.cache/opencode opencode/.config/opencode opencode/.local/share/opencode opencode/.local/state/opencode \
deep-research/.cache/deep-research-profiles deep-research/.config/deep-research-profiles"

EOF
        chmod 600 "$ENV_FILE"
        echo "Created default environment file at $ENV_FILE"
    fi

    local APP_DIR="$IRONCLAW_HOME/.ironclaw"
    local APP_ENV_FILE="$APP_DIR/.env"

    write_toml_configs "$new_config"

    if [ ! -f "$APP_ENV_FILE" ] || [ "$new_config" = "true" ]; then
        mkdir -p "$APP_DIR"
        cat >"$APP_ENV_FILE" <<'EOF'
# .env — IronClaw application environment overrides and secrets
# Generated by ironclaw-ctl install --new-config

ONBOARD_COMPLETED="true"
SIGNAL_HTTP_URL="http://127.0.0.1:50889"
SIGNAL_ACCOUNT="+1234567890"
SIGNAL_ALLOW_FROM="+1234567890,+9876543210"
SIGNAL_DM_POLICY="pairing"
SIGNAL_GROUP_POLICY="allowlist"

EOF
        chmod 600 "$APP_ENV_FILE"
        echo "Created default environment overrides at $APP_ENV_FILE"
    fi

    local ACP_FILE="$APP_DIR/acp-agents.json"
    if [ ! -f "$ACP_FILE" ] || [ "$new_config" = "true" ]; then
        mkdir -p "$APP_DIR"
        cat >"$ACP_FILE" <<'EOF'
{
  "agents": [
    {
      "name": "opencode",
      "command": "opencode",
      "args": [
        "--stdio"
      ],
      "env": {},
      "enabled": true,
      "description": "OpenCode coding agent running via Agent Client Protocol (ACP)"
    }
  ],
  "schema_version": 1
}
EOF
        chmod 600 "$ACP_FILE"
        echo "Created default ACP agents configuration at $ACP_FILE"
    fi

    write_service_file

    if is_systemd_running; then
        echo "Reloading systemd and enabling service..."
        systemctl --user enable ironclaw.service

        if [ "$no_start" = "true" ]; then
            echo "Stopping service if running (--no-start specified)..."
            systemctl --user stop ironclaw.service || true
        else
            echo "Starting service automatically..."
            systemctl --user start ironclaw.service
        fi
    else
        echo "Systemd is not running. Service file generated but not started/enabled."
    fi

    echo "Done! Type '$0 logs' to see the output."
}

cmd_uninstall() {
    echo "Uninstalling ironclaw systemd service..."
    if is_systemd_running; then
        systemctl --user stop ironclaw.service || true
        systemctl --user disable ironclaw.service || true
    fi

    if [ -f "$SERVICE_FILE" ]; then
        rm "$SERVICE_FILE"
        if is_systemd_running; then
            systemctl --user daemon-reload
        fi
        echo "Removed service file."
    fi
    echo "Uninstalled successfully. Data in $IRONCLAW_HOME is preserved."
}

cmd_start() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Use 'exec' to run the assistant directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user start ironclaw.service
}

cmd_stop() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user stop ironclaw.service
}

cmd_restart() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Use 'exec' to run the assistant directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user restart ironclaw.service
}

cmd_status() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user status ironclaw.service
}

cmd_enable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user enable ironclaw.service
}

cmd_disable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
