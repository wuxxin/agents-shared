#!/usr/bin/env bash
set -euo pipefail

# ironclaw-ctl - installation and management wrapper for ironclaw reborn

SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/ironclaw.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/ironclaw.env"
IRONCLAW_HOME="$HOME/.local/sandbox/ironclaw"

# Centralized default configuration values
DEFAULT_HTTP_HOST="127.0.0.1"
DEFAULT_HTTP_PORT="3000"
DEFAULT_IRONCLAW_REBORN_PROFILE="local-dev-yolo"
DEFAULT_IRONCLAW_REBORN_WEBUI_TOKEN="local_reborn_token"
DEFAULT_IRONCLAW_REBORN_WEBUI_USER_ID="default-owner"
DEFAULT_AGENT_WORKSPACE="$IRONCLAW_HOME/.ironclaw/default/workspace"

IRONCLAW_REBORN_HOME="$IRONCLAW_HOME/.ironclaw/reborn"
EXEC_PATH="/usr/bin/ironclaw-reborn"

is_systemd_running() {
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/private" ]
}

setup_fallback_environment() {
    # Set default AGENT_WORKSPACE before sourcing so self-referencing variables expand correctly
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-$DEFAULT_AGENT_WORKSPACE}"

    if [ -f "$ENV_FILE" ]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set +a
        set -u
    fi
    local app_env_file="$IRONCLAW_HOME/.ironclaw/.env"
    if [ -f "$app_env_file" ]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$app_env_file"
        set +a
        set -u
    fi
    export HOME="$IRONCLAW_HOME"
    export HTTP_PORT="${HTTP_PORT:-$DEFAULT_HTTP_PORT}"
    export HTTP_HOST="${HTTP_HOST:-$DEFAULT_HTTP_HOST}"
    export IRONCLAW_REBORN_HOME="$IRONCLAW_REBORN_HOME"
    export IRONCLAW_REBORN_PROFILE="${IRONCLAW_REBORN_PROFILE:-$DEFAULT_IRONCLAW_REBORN_PROFILE}"
    export IRONCLAW_REBORN_WEBUI_TOKEN="${IRONCLAW_REBORN_WEBUI_TOKEN:-$DEFAULT_IRONCLAW_REBORN_WEBUI_TOKEN}"
    export IRONCLAW_REBORN_WEBUI_USER_ID="${IRONCLAW_REBORN_WEBUI_USER_ID:-$DEFAULT_IRONCLAW_REBORN_WEBUI_USER_ID}"

    local ws="${AGENT_WORKSPACE}"
    ws="${ws//%h/$HOME}"
    if [[ "$ws" =~ ^~ ]]; then
        ws="${ws/#\~/$HOME}"
    fi
    export AGENT_WORKSPACE="$ws"
    mkdir -p "$IRONCLAW_HOME" "$AGENT_WORKSPACE"
    cd "$AGENT_WORKSPACE" || exit 1
}

get_exec_cmd_and_args() {
    # Sets variables EXEC_PATH and EXTRA_ARGS
    if [ ! -x "$EXEC_PATH" ]; then
        echo "Error: $EXEC_PATH is not executable." >&2
        echo "Please install the ironclaw-reborn-git package." >&2
        exit 1
    fi
    EXTRA_ARGS=()
    if [ $# -gt 0 ]; then
        local cmd="$1"
        if [ "$cmd" = "serve" ] || [ "$cmd" = "repl" ] || [ "$cmd" = "run" ]; then
            EXTRA_ARGS+=("--confirm-host-access")
        fi
    fi
}

get_shared_options() {
    local mode="$1" # "service" or "transient"
    local home_spec
    if [ "$mode" = "service" ]; then
        home_spec="%h"
    else
        home_spec="$HOME"
    fi

    local AGENT_PRIVATE_MOUNTS=""
    local AGENT_SANDBOX_MOUNTS=""
    local AGENT_EXTRA_MOUNTS=""
    local AGENT_WORKSPACE=""

    local raw_default_workspace
    if [ "$mode" = "service" ]; then
        raw_default_workspace="${home_spec}/.local/sandbox/ironclaw/.ironclaw/default/workspace"
    else
        raw_default_workspace="$DEFAULT_AGENT_WORKSPACE"
    fi

    # Set default AGENT_WORKSPACE before sourcing so self-referencing variables expand correctly
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-$raw_default_workspace}"
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi
    local app_env_file="$IRONCLAW_HOME/.ironclaw/.env"
    if [ -f "$app_env_file" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$app_env_file"
        set -u
    fi

    # Environment & Working Directory
    echo "Environment=HOME=${home_spec}/.local/sandbox/ironclaw"
    echo "Environment=HTTP_HOST=${HTTP_HOST:-$DEFAULT_HTTP_HOST}"
    echo "Environment=HTTP_PORT=${HTTP_PORT:-$DEFAULT_HTTP_PORT}"
    echo "Environment=IRONCLAW_REBORN_HOME=${home_spec}/.local/sandbox/ironclaw/.ironclaw/reborn"
    echo "Environment=IRONCLAW_REBORN_PROFILE=${IRONCLAW_REBORN_PROFILE:-$DEFAULT_IRONCLAW_REBORN_PROFILE}"
    echo "Environment=IRONCLAW_REBORN_POSTGRES_URL=${IRONCLAW_REBORN_POSTGRES_URL:-}"
    echo "Environment=IRONCLAW_REBORN_SECRET_MASTER_KEY=${IRONCLAW_REBORN_SECRET_MASTER_KEY:-}"
    echo "Environment=IRONCLAW_REBORN_WEBUI_TOKEN=${IRONCLAW_REBORN_WEBUI_TOKEN:-$DEFAULT_IRONCLAW_REBORN_WEBUI_TOKEN}"
    echo "Environment=IRONCLAW_REBORN_WEBUI_USER_ID=${IRONCLAW_REBORN_WEBUI_USER_ID:-$DEFAULT_IRONCLAW_REBORN_WEBUI_USER_ID}"

    local ws="${AGENT_WORKSPACE}"
    ws="${ws//%h/$home_spec}"
    ws="${ws//\$HOME/$home_spec}"
    if [[ "$ws" =~ ^~ ]]; then
        ws="${ws/#\~/$home_spec}"
    fi
    echo "Environment=AGENT_WORKSPACE=$ws"
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/ironclaw.env"
    echo "EnvironmentFile=-${home_spec}/.local/sandbox/ironclaw/.ironclaw/.env"
    echo "WorkingDirectory=$ws"

    # Security measures
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet="
    echo "AmbientCapabilities="

    # Filesystem isolation
    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    echo "BindPaths=${home_spec}/.local/sandbox/ironclaw:${home_spec}/.local/sandbox/ironclaw"

    for m in ${AGENT_PRIVATE_MOUNTS:-}; do
        mkdir -p "$HOME/agent-private/$m"
        echo "BindPaths=${home_spec}/agent-private/$m:${home_spec}/agent-private/$m"
    done

    for m in ${AGENT_SANDBOX_MOUNTS:-}; do
        local sandbox_name="${m%%/*}"
        local subpath="${m#*/}"
        mkdir -p "$HOME/.local/sandbox/${sandbox_name}/${subpath}"
        mkdir -p "$HOME/.local/sandbox/ironclaw/${subpath}"
        echo "BindPaths=${home_spec}/.local/sandbox/${sandbox_name}/${subpath}:${home_spec}/.local/sandbox/ironclaw/${subpath}"
    done

    for m in ${AGENT_EXTRA_MOUNTS:-}; do
        local abs_dir="${m%%:*}"
        local rel_dir="${m#*:}"
        mkdir -p "$abs_dir" || true
        mkdir -p "$HOME/$rel_dir"
        echo "BindPaths=${abs_dir}:${home_spec}/${rel_dir}"
    done

    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=yes"
    echo "PrivateMounts=yes"

    # Kernel and IPC constraints
    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "LockPersonality=yes"
    echo "MemoryDenyWriteExecute=no"
    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

sanitize_var_name() {
    local val="$1"
    val="${val//-/_}"
    val="${val//./_}"
    val="${val//\//_}"
    echo "${val^^}"
}

write_service_file() {
    if [ ! -x "$EXEC_PATH" ]; then
        echo "Warning: $EXEC_PATH is not executable. Make sure ironclaw-reborn-git is installed." >&2
    fi
    local exec_args="serve --host \${HTTP_HOST} --port \${HTTP_PORT} --confirm-host-access"

    # Set default AGENT_WORKSPACE before sourcing so self-referencing variables expand correctly
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-$DEFAULT_AGENT_WORKSPACE}"
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi
    local app_env_file="$IRONCLAW_HOME/.ironclaw/.env"
    if [ -f "$app_env_file" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$app_env_file"
        set -u
    fi

    # Ensure host workspace directory exists
    local workspace_dir="${AGENT_WORKSPACE:-$DEFAULT_AGENT_WORKSPACE}"
    workspace_dir="${workspace_dir//%h/$HOME}"
    mkdir -p "$workspace_dir"

    # Manage systemd-tmpfiles configuration file based on AGENT_TMPFILES_CLEANUP
    local tmpfiles_config="${XDG_CONFIG_HOME:-$HOME/.config}/user-tmpfiles.d/ironclaw.conf"
    local tmpfiles_dir
    tmpfiles_dir=$(dirname "$tmpfiles_config")
    mkdir -p "$tmpfiles_dir"

    local tmpfiles_cleanup_enabled="${AGENT_TMPFILES_CLEANUP:-false}"

    if [ "$tmpfiles_cleanup_enabled" = "true" ]; then
        if [ -f "${tmpfiles_config}.disabled" ]; then
            mv "${tmpfiles_config}.disabled" "$tmpfiles_config"
            echo "Enabled systemd-tmpfiles configuration at $tmpfiles_config"
        elif [ ! -f "$tmpfiles_config" ]; then
            cat >"$tmpfiles_config" <<'EOF'
# ~/.config/user-tmpfiles.d/ironclaw.conf
# systemd-tmpfiles configuration for IronClaw Reborn

# Example: Delete all files in workspace/voice-notes/read/ if older than 24 hours
# Type  Path                                                                                Mode UID  GID  Age  Argument
e       %h/.local/sandbox/ironclaw/.ironclaw/default/workspace/voice-notes/read       -    -    -    24h  -
EOF
            echo "Created default systemd-tmpfiles configuration at $tmpfiles_config"
        fi
    else
        if [ -f "$tmpfiles_config" ]; then
            mv "$tmpfiles_config" "${tmpfiles_config}.disabled"
            echo "Disabled systemd-tmpfiles configuration (renamed to ${tmpfiles_config}.disabled)"
        fi
    fi

    local sidecars_val="${AGENT_SIDECARS:-}"
    sidecars_val="${sidecars_val//;/ }"
    sidecars_val="${sidecars_val//$'\n'/ }"

    local sidecars_exec=""
    local sidecar_check=""
    local idx=0

    for sidecar in ${sidecars_val}; do
        local var_name
        var_name=$(sanitize_var_name "$sidecar")
        local cmd_var="AGENT_SIDECAR_${var_name}_CMD"
        local cmd_val="${!cmd_var:-}"
        if [ -z "$cmd_val" ]; then
            cmd_val="$sidecar"
        fi

        # Warn if command doesn't exist on host
        local host_cmd_val="$cmd_val"
        host_cmd_val="${host_cmd_val//\$AGENT_WORKSPACE/$workspace_dir}"
        host_cmd_val="${host_cmd_val//\$HOME/$HOME}"
        host_cmd_val="${host_cmd_val//%h/$HOME}"
        if [[ "$host_cmd_val" =~ ^~ ]]; then
            host_cmd_val="${host_cmd_val/#\~/$HOME}"
        fi
        if ! command -v "$host_cmd_val" >/dev/null 2>&1 && [ ! -x "$host_cmd_val" ]; then
            echo "Warning: Sidecar '$sidecar' executable '$cmd_val' (resolved: '$host_cmd_val') does not exist or is not executable." >&2
        fi

        local args_var="AGENT_SIDECAR_${var_name}_ARGS"
        local args_val="${!args_var:-}"

        # Process env removes and overrides
        local env_remove_var="AGENT_SIDECAR_${var_name}_ENV_REMOVE"
        local env_remove_val="${!env_remove_var:-}"
        local env_flags=""
        for r in ${env_remove_val}; do
            env_flags="$env_flags -u $r"
        done

        local env_override_var="AGENT_SIDECAR_${var_name}_ENV_OVERRIDE"
        local env_override_val="${!env_override_var:-}"
        for o in ${env_override_val}; do
            env_flags="$env_flags $o"
        done

        # Check executable inside sandbox at startup and print clear error if missing
        sidecars_exec="$sidecars_exec if ! command -v $cmd_val >/dev/null 2>&1 && [ ! -x \"$cmd_val\" ]; then echo \"Error: Cannot spawn sidecar $sidecar because its executable '$cmd_val' is missing or not executable.\" >&2 ; exit 1 ; fi ; env$env_flags $cmd_val $args_val & SIDECAR_PID_$idx=\$! ; "
        sidecar_check="$sidecar_check if ! kill -0 \$SIDECAR_PID_$idx 2>/dev/null; then echo \"Sidecar $sidecar (PID \$SIDECAR_PID_$idx) terminated.\" ; fi ; "
        idx=$((idx + 1))
    done

    local exec_start_cmd
    if [ -n "$sidecars_exec" ]; then
        # Spawn daemon first, sleep 2, check if daemon failed to start, spawn sidecars, then wait on daemon
        exec_start_cmd="/bin/bash -c '${EXEC_PATH} ${exec_args} & MAIN_PID=\$! ; sleep 2 ; if ! kill -0 \$MAIN_PID 2>/dev/null; then echo \"Main daemon process (PID \$MAIN_PID) failed to start.\" >&2 ; exit 1 ; fi ; $sidecars_exec wait -n ; if ! kill -0 \$MAIN_PID 2>/dev/null; then echo \"Main daemon process (PID \$MAIN_PID) terminated.\" ; fi ; $sidecar_check exit 1'"
    else
        exec_start_cmd="${EXEC_PATH} ${exec_args}"
    fi

    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=IronClaw Reborn Agent OS Daemon
Documentation=https://github.com/nearai/ironclaw
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=40
StartLimitBurst=4

[Service]
Type=simple
$(get_shared_options service)
ExecStart=${exec_start_cmd}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ironclaw

# Note: ProtectProc=invisible, ProcSubset=pid, and RestrictNamespaces=yes
# are explicitly omitted to allow WASM sandbox and optional Docker workers.

[Install]
WantedBy=default.target
EOF

    if is_systemd_running; then
        systemctl --user daemon-reload
    fi
}

