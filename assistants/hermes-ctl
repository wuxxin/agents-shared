#!/usr/bin/env bash
set -euo pipefail

# hermes-ctl - installation and management wrapper for hermes-agent

# default configuration values
DEFAULT_SERVICE_NAME="hermes-gateway"
DEFAULT_HERMES_SANDBOX_HOME="$HOME/.local/sandbox/hermes"
DEFAULT_HERMES_HOME="$DEFAULT_HERMES_SANDBOX_HOME/.hermes"

# Agent service
DEFAULT_AGENT_WORKSPACE="%h/.local/sandbox/hermes/.hermes/workspace"
DEFAULT_AGENT_SANDBOX_MOUNTS="opencode/.cache/opencode opencode/.config/opencode opencode/.local/share/opencode opencode/.local/state/opencode deep-research/.cache/deep-research-profiles deep-research/.config/deep-research-profiles"
DEFAULT_AGENT_EXTRA_MOUNTS="%h/agent-shared:agent-shared"
DEFAULT_AGENT_TMPFILES_CLEANUP="false"

# Agent sidecars
DEFAULT_AGENT_SIDECARS="dashboard"
DEFAULT_AGENT_SIDECAR_DASHBOARD_CMD="/usr/bin/hermes"
DEFAULT_AGENT_SIDECAR_DASHBOARD_ARGS="dashboard --no-open"

# Local Router Ports/URLS
DEFAULT_ROUTER_BASE_URL="http://localhost:51080/v1"
DEFAULT_ROUTER_KEY="unused"

# Local Inference Ports/URLs
DEFAULT_CHAT_BASE_URL="http://localhost:50080/v1"
DEFAULT_CHAT_KEY="unused"
DEFAULT_CHAT_MODEL="qwen3"

DEFAULT_EMBEDDING_PROVIDER="local"
DEFAULT_EMBEDDING_BASE_URL="http://localhost:50082/v1"
DEFAULT_EMBEDDING_KEY="unused"
DEFAULT_EMBEDDING_MODEL="qwen3-embedding"

DEFAULT_RERANK_PROVIDER="local"
DEFAULT_RERANK_BASE_URL="http://localhost:50086/v1/rerank"
DEFAULT_RERANK_KEY="unused"
DEFAULT_RERANK_MODEL="qwen3-reranker"
DEFAULT_RERANK_TOP_K=30

DEFAULT_STT_BASE_URL="http://localhost:50090/v1"
DEFAULT_STT_KEY="unused"
DEFAULT_STT_MODEL="whisper-1"

# Local TTS Port/URL (for Custom OpenAI-compatible TTS)
DEFAULT_TTS_BASE_URL="http://localhost:50095/v1"
DEFAULT_TTS_KEY="unused"
DEFAULT_TTS_MODEL="qwen3-tts"

# Local Image Port/URL
DEFAULT_IMAGE_BASE_URL="http://localhost:50100/v1"
DEFAULT_IMAGE_KEY="unused"
DEFAULT_IMAGE_MODEL="txt2img"

# Dummy reference to satisfy shellcheck SC2034 (unused variables to be used in the future)
: "${DEFAULT_CHAT_BASE_URL}" "${DEFAULT_CHAT_MODEL}" "${DEFAULT_CHAT_KEY}" "${DEFAULT_EMBEDDING_PROVIDER}" "${DEFAULT_EMBEDDING_BASE_URL}" "${DEFAULT_EMBEDDING_KEY}" "${DEFAULT_EMBEDDING_MODEL}" "${DEFAULT_RERANK_PROVIDER}" "${DEFAULT_RERANK_BASE_URL}" "${DEFAULT_RERANK_KEY}" "${DEFAULT_RERANK_MODEL}" "${DEFAULT_RERANK_TOP_K}" "${DEFAULT_STT_BASE_URL}" "${DEFAULT_STT_MODEL}" "${DEFAULT_STT_KEY}"

# Signal Channel Configuration
DEFAULT_SIGNAL_ACCOUNT="+1234567890"
DEFAULT_SIGNAL_HTTP_URL="http://localhost:50888"
DEFAULT_SIGNAL_HOME_CHANNEL="+9876543210"
DEFAULT_SIGNAL_ALLOWED_USERS="$DEFAULT_SIGNAL_HOME_CHANNEL"

# SCRIPT DEFAULTS
SERVICE_NAME="$DEFAULT_SERVICE_NAME"
SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE_NAME}.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE_NAME}.env"

# Hermes Defaults
HERMES_SANDBOX_HOME="$DEFAULT_HERMES_SANDBOX_HOME"
HERMES_HOME="$DEFAULT_HERMES_HOME"

# Hermes Execution Mode
DEFAULT_TERMINAL_ENV="local"
DEFAULT_HERMES_YOLO_MODE="true"
DEFAULT_DOCKER_BINARY="/usr/bin/podman"

is_systemd_running() {
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/private" ]
}

sanitize_var_name() {
    local val="$1"
    val="${val//-/_}"
    val="${val//./_}"
    val="${val^^}"
    echo "$val"
}

expand_specifiers() {
    local val="$1"
    val="${val//%h/"$HOME"}"
    val="${val/#\~/"$HOME"}"
    echo "$val"
}

get_shared_options() {
    local mode="$1" # "service" or "transient"
    local home_spec
    if [ "$mode" = "service" ]; then
        home_spec="%h"
    else
        home_spec="$HOME"
    fi

    local AGENT_PRIVATE_MOUNTS=""
    local AGENT_SANDBOX_MOUNTS=""
    local AGENT_EXTRA_MOUNTS=""
    local AGENT_WORKSPACE=""
    # Set default AGENT_WORKSPACE before sourcing so self-referencing variables expand correctly
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-${DEFAULT_AGENT_WORKSPACE//%h/$HOME}}"
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u

        # Expand specifiers for transient runs on the host
        if [ "$mode" = "transient" ]; then
            HERMES_SANDBOX_HOME=$(expand_specifiers "${HERMES_SANDBOX_HOME:-$DEFAULT_HERMES_SANDBOX_HOME}")
            HERMES_HOME=$(expand_specifiers "${HERMES_HOME:-$DEFAULT_HERMES_HOME}")
            local temp_mounts=""
            for m in ${AGENT_EXTRA_MOUNTS:-}; do
                temp_mounts+="$(expand_specifiers "$m") "
            done
            AGENT_EXTRA_MOUNTS="$temp_mounts"
        fi
    fi

    local app_env_file="$HERMES_HOME/.env"
    if [ -f "$app_env_file" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$app_env_file"
        set -u
    fi

    # Environment & Working Directory
    echo "Environment=HOME=${home_spec}/.local/sandbox/hermes"
    echo "Environment=HERMES_SANDBOX_HOME=${home_spec}/.local/sandbox/hermes"
    echo "Environment=HERMES_HOME=${home_spec}/.local/sandbox/hermes/.hermes"
    echo "Environment=PATH=${home_spec}/.local/sandbox/hermes/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    echo "Environment=AGENT_WORKSPACE=${AGENT_WORKSPACE:-${DEFAULT_AGENT_WORKSPACE//%h/$home_spec}}"
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/hermes-gateway.env"
    echo "EnvironmentFile=-${home_spec}/.local/sandbox/hermes/.hermes/.env"
    echo "WorkingDirectory=${home_spec}/.local/sandbox/hermes/.hermes"

    # Security measures
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet="
    echo "AmbientCapabilities="

    # Filesystem isolation
    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    # Retain changes by bind mounting the explicit hermes home directory
    echo "BindPaths=${home_spec}/.local/sandbox/hermes:${home_spec}/.local/sandbox/hermes"

    for m in ${AGENT_PRIVATE_MOUNTS:-}; do
        mkdir -p "$HOME/agent-private/$m"
        echo "BindPaths=${home_spec}/agent-private/$m:${home_spec}/agent-private/$m"
    done

    for m in ${AGENT_SANDBOX_MOUNTS:-}; do
        local sandbox_name="${m%%/*}"
        local subpath="${m#*/}"
        mkdir -p "$HOME/.local/sandbox/${sandbox_name}/${subpath}"
        mkdir -p "$HOME/.local/sandbox/hermes/${subpath}"
        echo "BindPaths=${home_spec}/.local/sandbox/${sandbox_name}/${subpath}:${home_spec}/.local/sandbox/hermes/${subpath}"
    done

    for m in ${AGENT_EXTRA_MOUNTS:-}; do
        local abs_dir="${m%%:*}"
        local rel_dir="${m#*:}"
        # Expand %h or ~ using home_spec so it matches the mode (service vs transient)
        local systemd_abs_dir="${abs_dir//%h/"$home_spec"}"
        systemd_abs_dir="${systemd_abs_dir/#\~/"$home_spec"}"

        # But we must run mkdir on the real host path
        local host_abs_dir="${abs_dir//%h/"$HOME"}"
        host_abs_dir="${host_abs_dir/#\~/"$HOME"}"
        mkdir -p "$host_abs_dir" || true
        mkdir -p "$HOME/$rel_dir"
        echo "BindPaths=${systemd_abs_dir}:${home_spec}/${rel_dir}"
    done

    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "InaccessiblePaths=/usr/bin/systemctl /bin/systemctl"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=no"
    echo "PrivateMounts=yes"

    # Kernel and IPC constraints
    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "LockPersonality=yes"
    echo "MemoryDenyWriteExecute=no"
    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

write_service_file() {
    # Set default AGENT_WORKSPACE before sourcing so self-referencing variables expand correctly
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-${DEFAULT_AGENT_WORKSPACE//%h/$HOME}}"
    if [ -f "$ENV_FILE" ]; then
        if grep -q "%h" "$ENV_FILE"; then
            sed -i "s|%h|$HOME|g" "$ENV_FILE"
            echo "Expanded %h to $HOME in $ENV_FILE"
        fi
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    local app_env_file="$HERMES_HOME/.env"
    if [ -f "$app_env_file" ]; then
        if grep -q "%h" "$app_env_file"; then
            sed -i "s|%h|$HOME|g" "$app_env_file"
            echo "Expanded %h to $HOME in $app_env_file"
        fi
        set +u
        # shellcheck disable=SC1090
        source "$app_env_file"
        set -u
    fi

    # Ensure host workspace directory exists
    local workspace_dir="${AGENT_WORKSPACE:-${DEFAULT_AGENT_WORKSPACE//%h/$HOME}}"
    workspace_dir="${workspace_dir//%h/$HOME}"
    mkdir -p "$workspace_dir"

    # Manage systemd-tmpfiles configuration file based on AGENT_TMPFILES_CLEANUP
    local tmpfiles_config="${XDG_CONFIG_HOME:-$HOME/.config}/user-tmpfiles.d/${SERVICE_NAME}.conf"
    local tmpfiles_dir
    tmpfiles_dir=$(dirname "$tmpfiles_config")
    mkdir -p "$tmpfiles_dir"

    local tmpfiles_cleanup_enabled="${AGENT_TMPFILES_CLEANUP:-$DEFAULT_AGENT_TMPFILES_CLEANUP}"

    if [ "$tmpfiles_cleanup_enabled" = "true" ]; then
        if [ -f "${tmpfiles_config}.disabled" ]; then
            mv "${tmpfiles_config}.disabled" "$tmpfiles_config"
            echo "Enabled systemd-tmpfiles configuration at $tmpfiles_config"
        elif [ ! -f "$tmpfiles_config" ]; then
            cat >"$tmpfiles_config" <<EOF
# ~/.config/user-tmpfiles.d/${SERVICE_NAME}.conf
# systemd-tmpfiles configuration for Hermes

# Example: Delete all files in workspace/voice-notes/read/ if older than 24 hours
# Type  Path                                                                                Mode UID  GID  Age  Argument
e       %h/.local/sandbox/hermes/.hermes/agents/default/workspace/voice-notes/read       -    -    -    24h  -
EOF
            echo "Created and enabled default systemd-tmpfiles configuration at $tmpfiles_config"
        fi

        # Run cleanup now
        if is_systemd_running; then
            echo "Running systemd-tmpfiles cleanup..."
            systemd-tmpfiles --user --create --clean || true
        fi
    else
        if [ -f "$tmpfiles_config" ]; then
            mv "$tmpfiles_config" "${tmpfiles_config}.disabled"
            echo "Disabled systemd-tmpfiles configuration (renamed to ${tmpfiles_config}.disabled)"
        fi
    fi

    # Parse sidecars
    local sidecars_val="${AGENT_SIDECARS:-}"
    sidecars_val="${sidecars_val//;/ }"
    sidecars_val="${sidecars_val//$'\n'/ }"

    local sidecars_exec=""
    local sidecar_check=""
    local idx=0
    for sidecar in ${sidecars_val}; do
        local var_name
        var_name=$(sanitize_var_name "$sidecar")
        local cmd_var="AGENT_SIDECAR_${var_name}_CMD"
        local cmd_val="${!cmd_var:-}"
        if [ -z "$cmd_val" ]; then
            cmd_val="$sidecar"
        fi

        # Warn if command doesn't exist on host
        local host_cmd_val="$cmd_val"
        host_cmd_val="${host_cmd_val//\$AGENT_WORKSPACE/$workspace_dir}"
        host_cmd_val="${host_cmd_val//\$HOME/$HOME}"
        host_cmd_val="${host_cmd_val//%h/$HOME}"
        if [[ "$host_cmd_val" =~ ^(/|\.|\~) ]] || [ -f "$host_cmd_val" ]; then
            if [[ "$host_cmd_val" =~ ^~ ]]; then
                host_cmd_val="${host_cmd_val/#\~/$HOME}"
            fi
            if [ ! -x "$host_cmd_val" ]; then
                echo "Warning: Sidecar '$sidecar' executable '$cmd_val' (resolved: '$host_cmd_val') does not exist or is not executable." >&2
            fi
        else
            if ! command -v "$host_cmd_val" >/dev/null 2>&1; then
                echo "Warning: Sidecar '$sidecar' executable '$cmd_val' is not found in PATH." >&2
            fi
        fi

        local args_var="AGENT_SIDECAR_${var_name}_ARGS"
        local args_val="${!args_var:-}"

        # Process env removes and overrides
        local env_remove_var="AGENT_SIDECAR_${var_name}_ENV_REMOVE"
        local env_remove_val="${!env_remove_var:-}"
        local env_flags=""
        for r in ${env_remove_val}; do
            env_flags="$env_flags -u $r"
        done

        local env_override_var="AGENT_SIDECAR_${var_name}_ENV_OVERRIDE"
        local env_override_val="${!env_override_var:-}"
        for o in ${env_override_val}; do
            env_flags="$env_flags $o"
        done

        # Check executable inside sandbox at startup and print clear error if missing
        sidecars_exec="$sidecars_exec if ! command -v $cmd_val >/dev/null 2>&1 && [ ! -x \"$cmd_val\" ]; then echo \"Error: Cannot spawn sidecar $sidecar because its executable '$cmd_val' is missing or not executable.\" >&2 ; exit 1 ; fi ; env$env_flags $cmd_val $args_val & SIDECAR_PID_$idx=\$\$! ; "
        sidecar_check="$sidecar_check if ! kill -0 \$\$SIDECAR_PID_$idx 2>/dev/null; then echo \"Sidecar $sidecar (PID \$\$SIDECAR_PID_$idx) terminated.\" ; fi ; "
        idx=$((idx + 1))
    done

    local exec_start_cmd
    if [ -n "$sidecars_exec" ]; then
        local kill_pids="\$\$MAIN_PID"
        for ((i = 0; i < idx; i++)); do
            kill_pids="$kill_pids \$\$SIDECAR_PID_$i"
        done
        exec_start_cmd="/bin/bash -c 'trap \"kill $kill_pids 2>/dev/null || true\" EXIT ; /usr/bin/hermes gateway run --force --no-supervise & MAIN_PID=\$\$! ; $sidecars_exec wait -n'"
    else
        exec_start_cmd="/usr/bin/hermes gateway run --force --no-supervise"
    fi

    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=Hermes Agent Messaging Gateway
Documentation=https://hermes-agent.nousresearch.com/docs/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=40
StartLimitBurst=4

[Service]
Type=simple
$(get_shared_options service)
ExecStart=$exec_start_cmd
Restart=always
RestartSec=60
RestartMaxDelaySec=300
RestartSteps=5
# 75 is GATEWAY_SERVICE_RESTART_EXIT_CODE from hermes source
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 \$MAINPID
# Budget for graceful drain (default 180s) + cleanup
TimeoutStopSec=210

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-gateway

[Install]
WantedBy=default.target
EOF

    if is_systemd_running; then
        systemctl --user daemon-reload
    fi
}

cmd_install() {
    local no_start=false
    local new_config=false
    while [ $# -gt 0 ]; do
        case "$1" in
        --no-start) no_start=true ;;
        --new-config) new_config=true ;;
        esac
        shift
    done

    echo "Setting up Hermes sandbox directory at $HERMES_SANDBOX_HOME and home at $HERMES_HOME..."
    mkdir -p "$HERMES_SANDBOX_HOME" "$HERMES_HOME" "$HERMES_SANDBOX_HOME/.local/bin"

    echo "Generating systemd user service..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    # Write default env file if it doesn't exist or --new-config is specified
    if [ ! -f "$ENV_FILE" ] || [ "$new_config" = "true" ]; then
        cat >"$ENV_FILE" <<EOF
# Hermes Agent Environment Configuration

# Path to the sandbox home and hermes home directories
HERMES_SANDBOX_HOME="${DEFAULT_HERMES_SANDBOX_HOME}"
HERMES_HOME="${DEFAULT_HERMES_HOME}"

# List of submounts from ~/agent-private/* to bind-mount into the sandbox
# (e.g., AGENT_PRIVATE_MOUNTS="health diary" binds ~/agent-private/health and ~/agent-private/diary)
# AGENT_PRIVATE_MOUNTS=""

# List of submounts from other sandboxes (e.g., opencode) to bind-mount into this assistant's sandbox
# (e.g., AGENT_SANDBOX_MOUNTS="opencode/.cache/opencode opencode/.config/opencode opencode/.local/share/opencode opencode/.local/state/opencode")
AGENT_SANDBOX_MOUNTS="${DEFAULT_AGENT_SANDBOX_MOUNTS}"

# List of extra mounts to bind-mount into the sandbox (syntax: absolute-dir:relative-dir-to-HOME)
AGENT_EXTRA_MOUNTS="${DEFAULT_AGENT_EXTRA_MOUNTS}"

# Agent sandbox workspace path
AGENT_WORKSPACE="${DEFAULT_AGENT_WORKSPACE}"

# Agent sidecar list
AGENT_SIDECARS="${DEFAULT_AGENT_SIDECARS}"
AGENT_SIDECAR_DASHBOARD_CMD="${DEFAULT_AGENT_SIDECAR_DASHBOARD_CMD}"
AGENT_SIDECAR_DASHBOARD_ARGS="${DEFAULT_AGENT_SIDECAR_DASHBOARD_ARGS}"

# systemd-tmpfiles cleanup policy status
AGENT_TMPFILES_CLEANUP="${DEFAULT_AGENT_TMPFILES_CLEANUP}"

EOF
        chmod 600 "$ENV_FILE"
        echo "Created default service environment file at $ENV_FILE"
    fi

    local app_env_file="$HERMES_HOME/.env"
    if [ ! -f "$app_env_file" ] || [ "$new_config" = "true" ]; then
        cat >"$app_env_file" <<EOF
# .hermes/.env
# Set your API keys and other configuration here.

# Default openai compatible backend URL,
# Local-Router (OpenAI compatible on port 51080 for all services)
OPENAI_API_BASE_URL="${DEFAULT_ROUTER_BASE_URL}"
OPENAI_API_KEY="${DEFAULT_ROUTER_KEY}"
# XXX stt:base_url is ignored , but STT_OPENAI_BASE_URL is recognized
STT_OPENAI_BASE_URL="$DEFAULT_ROUTER_BASE_URL"

# Hermes Execution Mode
TERMINAL_ENV="${DEFAULT_TERMINAL_ENV}"
HERMES_DOCKER_BINARY="${DEFAULT_DOCKER_BINARY}"
HERMES_YOLO_MODE="${DEFAULT_HERMES_YOLO_MODE}"
# HERMES_DISABLE_LAZY_INSTALLS=true

# Signal Channel Configuration
SIGNAL_HTTP_URL="${DEFAULT_SIGNAL_HTTP_URL}"
SIGNAL_ACCOUNT="${DEFAULT_SIGNAL_ACCOUNT}"
SIGNAL_ALLOWED_USERS="${DEFAULT_SIGNAL_ALLOWED_USERS}"
SIGNAL_HOME_CHANNEL="${DEFAULT_SIGNAL_HOME_CHANNEL}"
SIGNAL_HOME_CHANNEL_THREAD_ID=""

# Messaging gateway settings
# GATEWAY_ALLOW_ALL_USERS=false

# Example API keys (uncomment and fill)
# OPENROUTER_API_KEY=sk-or-v1-...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_ALLOWED_USERS=your_user_id

EOF
        chmod 600 "$app_env_file"
        echo "Created default agent environment file at $app_env_file"
    fi

    local config_yaml="$HERMES_HOME/config.yaml"
    if [ ! -f "$config_yaml" ] || [ "$new_config" = "true" ]; then
        cat >"$config_yaml" <<EOF
_config_version: 32
agent:
  max_turns: 150
web:
  backend: ddgs
  use_gateway: false
browser:
  cloud_provider: local
  use_gateway: false
display:
  tool_progress: all
  tui_compact: false
  details_mode: expanded
  sections:
    thinking: expanded
    tools: expanded
    subagents: expanded
    activity: expanded
dashboard:
  theme: default-large
  font: work-sans
session_reset:
  mode: none
model:
  provider: custom
  default: $DEFAULT_CHAT_MODEL
  context_length: 80128
  base_url: http://localhost:51080/v1
  api_key: unused
image_gen:
  enabled: true
  provider: openai
  model: $DEFAULT_IMAGE_MODEL
  use_gateway: false
tts:
  enabled: true
  provider: openai
  base_url: $DEFAULT_ROUTER_BASE_URL

  openai:
    model: $DEFAULT_TTS_MODEL
    base_url: $DEFAULT_ROUTER_BASE_URL
    # voice: "alloy"              # alloy, echo, fable, onyx, nova, shimmer
    # speed: 1.0
  use_gateway: false
stt:
  enabled: true
  provider: openai
  # XXX stt:base_url is ignored , but STT_OPENAI_BASE_URL is recognized
  base_url: $DEFAULT_ROUTER_BASE_URL

  openai:
    model: $DEFAULT_STT_MODEL
    base_url: $DEFAULT_ROUTER_BASE_URL
voice:
  auto_tts: true

custom_providers:
  - name: local-openapi
    base_url: http://localhost:51080/v1
    api_key: unused
    model: qwen3
    models:
      qwen3:
        context_length: 80128
plugins:
  enabled:
    - image_gen/openai
  disabled: []
platforms:
  signal:
    enabled: true
platform_toolsets:
  cli:
    - browser
    - clarify
    - code_execution
    - computer_use
    - context_engine
    - cronjob
    - delegation
    - file
    - image_gen
    - memory
    - session_search
    - skills
    - terminal
    - todo
    - tts
    - video
    - vision
    - web

# ── Security ──────────────────────────────────────────────────────────
# Secret redaction is ON by default — strings that look like API keys,
# tokens, and passwords are masked in tool output, logs, and chat
# responses before the model or user ever sees them. Set redact_secrets
# to false to disable (e.g. when developing the redactor itself).
# tirith pre-exec scanning is enabled by default when the tirith binary
# is available. Configure via security.tirith_* keys or env vars
# (TIRITH_ENABLED, TIRITH_BIN, TIRITH_TIMEOUT, TIRITH_FAIL_OPEN).
#
# security:
#   redact_secrets: true
#   tirith_enabled: true
#   tirith_path: "tirith"
#   tirith_timeout: 5
#   tirith_fail_open: true

EOF
        echo "Created default config.yaml at $config_yaml"
    fi

    write_service_file

    if is_systemd_running; then
        echo "Reloading systemd and enabling service..."
        systemctl --user enable "${SERVICE_NAME}.service"

        if [ "$no_start" = "true" ]; then
            echo "Stopping service if running (--no-start specified)..."
            systemctl --user stop "${SERVICE_NAME}.service" || true
        else
            echo "Starting service automatically..."
            systemctl --user start "${SERVICE_NAME}.service"
        fi
    else
        echo "Systemd is not running/available in this environment. Skipping systemd service activation."
    fi

    echo "---------------------------------------------------------------------------"
    echo "Hermes installation complete!"
    echo "---------------------------------------------------------------------------"
    echo "Done! Type '$0 logs' to see the output."
}

cmd_uninstall() {
    echo "Uninstalling hermes systemd service..."
    if is_systemd_running; then
        systemctl --user stop "${SERVICE_NAME}.service" || true
        systemctl --user disable "${SERVICE_NAME}.service" || true
    fi

    if [ -f "$SERVICE_FILE" ]; then
        rm "$SERVICE_FILE"
        if is_systemd_running; then
            systemctl --user daemon-reload
        fi
        echo "Removed service file."
    fi
    echo "Uninstalled successfully. Data in $HERMES_SANDBOX_HOME and configuration in $ENV_FILE are preserved."
}

cmd_start() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user start "${SERVICE_NAME}.service"
}

cmd_stop() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user stop "${SERVICE_NAME}.service"
}

cmd_restart() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user restart "${SERVICE_NAME}.service"
}

cmd_status() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user status "${SERVICE_NAME}.service"
}

cmd_enable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user enable "${SERVICE_NAME}.service"
}

cmd_disable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user disable "${SERVICE_NAME}.service"
}

cmd_logs() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    journalctl --user -u "${SERVICE_NAME}.service" "$@"
}

cmd_edit() {
    local app_env_file="$HERMES_HOME/.env"
    mkdir -p "$(dirname "$ENV_FILE")" "$(dirname "$app_env_file")"
    touch "$ENV_FILE" "$app_env_file"

    local config_yaml="$HERMES_HOME/config.yaml"
    mkdir -p "$(dirname "$config_yaml")"
    touch "$config_yaml"

    local tmpfiles_config="${XDG_CONFIG_HOME:-$HOME/.config}/user-tmpfiles.d/${SERVICE_NAME}.conf"
    local edit_files=("$ENV_FILE" "$app_env_file" "$config_yaml")
    if [ -f "$tmpfiles_config" ]; then
        edit_files+=("$tmpfiles_config")
    elif [ -f "${tmpfiles_config}.disabled" ]; then
        edit_files+=("${tmpfiles_config}.disabled")
    fi

    ${EDITOR:-nano} "${edit_files[@]}"
    if is_systemd_running; then
        if systemctl --user is-active "${SERVICE_NAME}.service" &>/dev/null; then
            echo "Restarting service to apply updated environment..."
            cmd_restart
        else
            echo "Service is not active. Service restart skipped."
        fi
    else
        echo "Systemd is not running. Service restart skipped."
    fi
}

setup_fallback_environment() {
    # Keep track of the original user home directory
    local real_home="$HOME"

    # Set defaults before sourcing so self-referencing variables expand correctly
    export HERMES_SANDBOX_HOME="${HERMES_SANDBOX_HOME:-$DEFAULT_HERMES_SANDBOX_HOME}"
    export HERMES_HOME="${HERMES_HOME:-$DEFAULT_HERMES_HOME}"
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-${DEFAULT_AGENT_WORKSPACE//%h/$HERMES_SANDBOX_HOME}}"

    if [ -f "$ENV_FILE" ]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set +a
        set -u
    fi

    # Expand specifiers using the real home directory on the host
    HERMES_SANDBOX_HOME="${HERMES_SANDBOX_HOME//%h/"$real_home"}"
    HERMES_SANDBOX_HOME="${HERMES_SANDBOX_HOME/#\~/"$real_home"}"
    HERMES_HOME="${HERMES_HOME//%h/"$real_home"}"
    HERMES_HOME="${HERMES_HOME/#\~/"$real_home"}"

    local app_env_file="$HERMES_HOME/.env"
    if [ -f "$app_env_file" ]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$app_env_file"
        set +a
        set -u
    fi

    export HOME="$HERMES_SANDBOX_HOME"
    export HERMES_SANDBOX_HOME="$HERMES_SANDBOX_HOME"
    export HERMES_HOME="$HERMES_HOME"
    export PATH="$HERMES_SANDBOX_HOME/.local/bin:$PATH"

    local ws="${AGENT_WORKSPACE}"
    ws="${ws//%h/$HOME}"
    if [[ "$ws" =~ ^~ ]]; then
        ws="${ws/#\~/$HOME}"
    fi
    export AGENT_WORKSPACE="$ws"

    mkdir -p "$HERMES_SANDBOX_HOME" "$HERMES_HOME" "$AGENT_WORKSPACE" "$HERMES_SANDBOX_HOME/.local/bin"
    cd "$HERMES_HOME" || exit 1
}

FALLBACK_SIDECAR_PIDS=()
FALLBACK_SIDECAR_NAMES=()

spawn_fallback_sidecars() {
    local sidecars_val="${AGENT_SIDECARS:-}"
    sidecars_val="${sidecars_val//;/ }"
    sidecars_val="${sidecars_val//$'\n'/ }"

    for sidecar in ${sidecars_val}; do
        local var_name
        var_name=$(sanitize_var_name "$sidecar")
        local cmd_var="AGENT_SIDECAR_${var_name}_CMD"
        local cmd_val="${!cmd_var:-}"
        if [ -z "$cmd_val" ]; then
            cmd_val="$sidecar"
        fi

        local args_var="AGENT_SIDECAR_${var_name}_ARGS"
        local args_val="${!args_var:-}"

        # Resolve paths
        local check_cmd="$cmd_val"
        check_cmd="${check_cmd//\$AGENT_WORKSPACE/$AGENT_WORKSPACE}"
        check_cmd="${check_cmd//\$HOME/$HOME}"
        check_cmd="${check_cmd//%h/$HOME}"
        if [[ "$check_cmd" =~ ^~ ]]; then
            check_cmd="${check_cmd/#\~/$HOME}"
        fi
        if ! command -v "$check_cmd" >/dev/null 2>&1 && [ ! -x "$check_cmd" ]; then
            echo "Error: Cannot spawn sidecar $sidecar because its executable '$cmd_val' (resolved: '$check_cmd') is missing or not executable." >&2
            exit 1
        fi

        # Process env removes and overrides
        local env_remove_var="AGENT_SIDECAR_${var_name}_ENV_REMOVE"
        local env_remove_val="${!env_remove_var:-}"

        local env_override_var="AGENT_SIDECAR_${var_name}_ENV_OVERRIDE"
        local env_override_val="${!env_override_var:-}"

        (
            # Apply removes
            for r in ${env_remove_val}; do
                unset "$r"
            done
            # Apply overrides
            for o in ${env_override_val}; do
                # shellcheck disable=SC2163
                export "$o"
            done
            # Execute
            eval "exec $cmd_val $args_val"
        ) &
        FALLBACK_SIDECAR_PIDS+=($!)
        FALLBACK_SIDECAR_NAMES+=("$sidecar")
    done
}

cmd_exec() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running hermes directly..."
        setup_fallback_environment

        if [ "${1:-}" = "gateway" ] && [ "${2:-}" = "run" ]; then
            # Run cleanup if enabled
            if [ "${AGENT_TMPFILES_CLEANUP:-false}" = "true" ]; then
                echo "Running systemd-tmpfiles cleanup..."
                systemd-tmpfiles --user --create --clean || true
            fi
            # Run daemon in the background
            /usr/bin/hermes "$@" &
            local main_pid=$!
            spawn_fallback_sidecars
            wait -n

            # Kill all other processes on termination
            kill "$main_pid" "${FALLBACK_SIDECAR_PIDS[@]}" 2>/dev/null || true
            exit 1
        else
            exec /usr/bin/hermes "$@"
        fi
    fi

    echo "Starting hermes as a transient systemd service with args: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" /usr/bin/hermes "$@"
}

cmd_shell() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running shell directly..."
        setup_fallback_environment
        exec "${SHELL:-/bin/bash}" "$@"
    fi

    echo "Starting interactive shell as a transient systemd service..."

    local opts=(
        --user
        --pty
        --wait
        --collect
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "${SHELL:-/bin/bash}" "$@"
}

cmd_run() {
    if [ $# -lt 1 ]; then
        echo "Error: run requires a command to execute." >&2
        exit 1
    fi

    if ! is_systemd_running; then
        echo "Running command inside the hermes environment: $*"
        setup_fallback_environment
        exec "$@"
    fi

    echo "Running command inside the hermes environment: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "$@"
}

usage() {
    echo "Usage: $0 <command>"
    echo "Commands:"
    echo "  install [--no-start] [--new-config] - Setup service and hermes home directory (do not start service if --no-start is specified, overwrite configs with defaults if --new-config is specified)"
    echo "  uninstall - Stop and remove systemd service"
    echo "  start     - Start the systemd service"
    echo "  stop      - Stop the systemd service"
    echo "  restart   - Restart the systemd service"
    echo "  status    - View systemd service status"
    echo "  enable    - Enable systemd service on boot"
    echo "  disable   - Disable systemd service on boot"
    echo "  logs      - Tail the systemd service logs"
    echo "  edit      - Edit the .env file and restart the service upon exit"
    echo "  exec      - Run hermes as a transient systemd user service with args"
    echo "  run       - Run a command inside the hermes systemd environment"
    echo "  shell     - Spawn an interactive shell in the hermes systemd environment"
}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
install) cmd_install "$@" ;;
uninstall) cmd_uninstall ;;
start) cmd_start ;;
stop) cmd_stop ;;
restart) cmd_restart ;;
status) cmd_status ;;
enable) cmd_enable ;;
disable) cmd_disable ;;
logs) cmd_logs "$@" ;;
edit) cmd_edit ;;
exec) cmd_exec "$@" ;;
run) cmd_run "$@" ;;
shell) cmd_shell "$@" ;;
*)
    echo "Unknown command: $COMMAND"
    usage
    exit 1
    ;;
esac
