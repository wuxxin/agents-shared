#!/usr/bin/env bash
set -euo pipefail

# hermes-ctl - installation and management wrapper for hermes-agent

# default configuration values
DEFAULT_SERVICE_NAME="hermes-gateway"
DEFAULT_HERMES_SANDBOX_HOME="%h/.local/sandbox/hermes"
DEFAULT_HERMES_HOME="%h/.local/sandbox/hermes/.hermes"

# Agent service
DEFAULT_AGENT_PROFILE="assistant"
DEFAULT_AGENT_PROFILE_ROOT="%h/.local/sandbox/hermes/.hermes/profiles/${DEFAULT_AGENT_PROFILE}"
DEFAULT_AGENT_WORKSPACE="${DEFAULT_AGENT_PROFILE_ROOT}/workspace"

# Mounts
DEFAULT_AGENT_SANDBOX_MOUNTS="opencode/.cache/opencode opencode/.opencode-mem opencode/.config/opencode opencode/.local/share/opencode opencode/.local/state/opencode deep-research/.cache/deep-research-profiles deep-research/.config/deep-research-profiles"
DEFAULT_AGENT_EXTRA_MOUNTS="%h/agent-shared:agent-shared"
DEFAULT_AGENT_TMPFILES_CLEANUP="false"

# Agent sidecars
DEFAULT_AGENT_SIDECARS="dashboard hindsight"
DEFAULT_AGENT_SIDECAR_DASHBOARD_CMD="/usr/bin/hermes"
DEFAULT_AGENT_SIDECAR_DASHBOARD_ARGS="-p ${DEFAULT_AGENT_PROFILE} dashboard --no-open"
DEFAULT_AGENT_SIDECAR_HINDSIGHT_CMD="/opt/hermes-agent/venv/bin/hindsight-api"
DEFAULT_AGENT_SIDECAR_HINDSIGHT_ARGS="--port 8888 --host 127.0.0.1"

# Local Router Ports/URLS
DEFAULT_ROUTER_BASE_URL="http://localhost:51080/v1"
DEFAULT_ROUTER_KEY="unused"

# Local Inference Ports/URLs
DEFAULT_CHAT_BASE_URL="http://localhost:50080/v1"
DEFAULT_CHAT_KEY="unused"
DEFAULT_CHAT_MODEL="qwen3"

DEFAULT_EMBEDDING_PROVIDER="local"
DEFAULT_EMBEDDING_BASE_URL="http://localhost:50082/v1"
DEFAULT_EMBEDDING_KEY="unused"
DEFAULT_EMBEDDING_MODEL="qwen3-embedding"

DEFAULT_RERANK_PROVIDER="local"
DEFAULT_RERANK_BASE_URL="http://localhost:50086/v1/rerank"
DEFAULT_RERANK_KEY="unused"
DEFAULT_RERANK_MODEL="qwen3-reranker"
DEFAULT_RERANK_TOP_K=30

DEFAULT_STT_BASE_URL="http://localhost:50090/v1"
DEFAULT_STT_KEY="unused"
DEFAULT_STT_MODEL="whisper-1"

# Local TTS Port/URL (for Custom OpenAI-compatible TTS)
DEFAULT_TTS_BASE_URL="http://localhost:50095/v1"
DEFAULT_TTS_KEY="unused"
DEFAULT_TTS_MODEL="qwen3-tts"

# Local Image Port/URL
DEFAULT_IMAGE_BASE_URL="http://localhost:50100/v1"
DEFAULT_IMAGE_KEY="unused"
DEFAULT_IMAGE_MODEL="z-image-turbo"

# Dummy reference to satisfy shellcheck SC2034 (unused variables to be used in the future)
: "${DEFAULT_TTS_BASE_URL}" "${DEFAULT_TTS_KEY}" "${DEFAULT_CHAT_BASE_URL}" "${DEFAULT_CHAT_MODEL}" "${DEFAULT_CHAT_KEY}" "${DEFAULT_EMBEDDING_PROVIDER}" "${DEFAULT_EMBEDDING_BASE_URL}" "${DEFAULT_EMBEDDING_KEY}" "${DEFAULT_EMBEDDING_MODEL}" "${DEFAULT_RERANK_PROVIDER}" "${DEFAULT_RERANK_BASE_URL}" "${DEFAULT_RERANK_KEY}" "${DEFAULT_RERANK_MODEL}" "${DEFAULT_RERANK_TOP_K}" "${DEFAULT_STT_BASE_URL}" "${DEFAULT_STT_MODEL}" "${DEFAULT_STT_KEY}"

resolve_profile_vars() {
    local val="$1"
    local home_val="$2"
    local profile_val="${3:-}"
    local profile_root_val="${4:-}"

    val="${val//%h/"$home_val"}"
    val="${val//\$HOME/"$home_val"}"
    if [[ "$val" =~ ^~ ]]; then
        val="${val/#\~/"$home_val"}"
    fi

    val="${val//\${AGENT_PROFILE\}/"$profile_val"}"
    val="${val//\$AGENT_PROFILE/"$profile_val"}"

    val="${val//\${AGENT_PROFILE_ROOT\}/"$profile_root_val"}"
    val="${val//\$AGENT_PROFILE_ROOT/"$profile_root_val"}"

    echo "$val"
}

# Signal Channel Configuration
DEFAULT_SIGNAL_ACCOUNT="+1234567890"
DEFAULT_SIGNAL_HTTP_URL="http://localhost:50888"
DEFAULT_SIGNAL_HOME_CHANNEL="+9876543210"
DEFAULT_SIGNAL_ALLOWED_USERS="$DEFAULT_SIGNAL_HOME_CHANNEL"

# SCRIPT DEFAULTS
SERVICE_NAME="$DEFAULT_SERVICE_NAME"
SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE_NAME}.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE_NAME}.env"

## Save any command line environment overrides
CMD_AGENT_PROFILE="${AGENT_PROFILE:-}"
CMD_AGENT_PROFILE_ROOT="${AGENT_PROFILE_ROOT:-}"
CMD_AGENT_WORKSPACE="${AGENT_WORKSPACE:-}"
CMD_HERMES_SANDBOX_HOME="${HERMES_SANDBOX_HOME:-}"
CMD_HERMES_HOME="${HERMES_HOME:-}"

# Load env file to get AGENT_PROFILE overrides before global resolution
if [ -f "$ENV_FILE" ]; then
    set +u
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set -u
fi

# If AGENT_PROFILE was overridden, clear the loaded profile root and workspace
# from ENV_FILE so they fall back to templates and resolve using the new profile name.
if [ -n "$CMD_AGENT_PROFILE" ] && [ "${CMD_AGENT_PROFILE}" != "${AGENT_PROFILE:-}" ]; then
    AGENT_PROFILE_ROOT=""
    AGENT_WORKSPACE=""
fi

# Restore overrides if they were passed in environment
AGENT_PROFILE="${CMD_AGENT_PROFILE:-${AGENT_PROFILE:-}}"
AGENT_PROFILE_ROOT="${CMD_AGENT_PROFILE_ROOT:-${AGENT_PROFILE_ROOT:-}}"
AGENT_WORKSPACE="${CMD_AGENT_WORKSPACE:-${AGENT_WORKSPACE:-}}"
HERMES_SANDBOX_HOME="${CMD_HERMES_SANDBOX_HOME:-${HERMES_SANDBOX_HOME:-}}"
HERMES_HOME="${CMD_HERMES_HOME:-${HERMES_HOME:-}}"

# Resolve profile variables globally for host commands
AGENT_PROFILE="${AGENT_PROFILE:-$DEFAULT_AGENT_PROFILE}"
AGENT_PROFILE_ROOT=$(resolve_profile_vars "${AGENT_PROFILE_ROOT:-$DEFAULT_AGENT_PROFILE_ROOT}" "$HOME" "$AGENT_PROFILE")
AGENT_WORKSPACE=$(resolve_profile_vars "${AGENT_WORKSPACE:-$DEFAULT_AGENT_WORKSPACE}" "$HOME" "$AGENT_PROFILE" "$AGENT_PROFILE_ROOT")
HERMES_SANDBOX_HOME=$(resolve_profile_vars "${HERMES_SANDBOX_HOME:-$DEFAULT_HERMES_SANDBOX_HOME}" "$HOME")
HERMES_HOME=$(resolve_profile_vars "${HERMES_HOME:-$DEFAULT_HERMES_HOME}" "$HOME")

# Hermes Execution Mode
DEFAULT_TERMINAL_ENV="local"
DEFAULT_HERMES_YOLO_MODE="true"
DEFAULT_DOCKER_BINARY="/usr/bin/podman"

is_systemd_running() {
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/private" ]
}

sanitize_var_name() {
    local val="$1"
    val="${val//-/_}"
    val="${val//./_}"
    val="${val^^}"
    echo "$val"
}

expand_specifiers() {
    local val="$1"
    val="${val//%h/"$HOME"}"
    val="${val/#\~/"$HOME"}"
    echo "$val"
}

get_shared_options() {
    local mode="$1" # "service" or "transient"
    local home_spec
    if [ "$mode" = "service" ]; then
        home_spec="%h"
    else
        home_spec="$HOME"
    fi

    local cmd_profile="${AGENT_PROFILE:-}"
    local cmd_profile_root="${AGENT_PROFILE_ROOT:-}"
    local cmd_workspace="${AGENT_WORKSPACE:-}"
    local cmd_hermes_sandbox_home="${HERMES_SANDBOX_HOME:-}"
    local cmd_hermes_home="${HERMES_HOME:-}"

    local AGENT_PRIVATE_MOUNTS=""
    local AGENT_SANDBOX_MOUNTS=""
    local AGENT_EXTRA_MOUNTS=""
    local AGENT_PROFILE=""
    local AGENT_PROFILE_ROOT=""
    local AGENT_WORKSPACE=""

    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    if [ -n "$cmd_profile" ] && [ "${cmd_profile}" != "${AGENT_PROFILE:-}" ]; then
        AGENT_PROFILE_ROOT=""
        AGENT_WORKSPACE=""
    fi

    AGENT_PROFILE="${cmd_profile:-${AGENT_PROFILE:-}}"
    AGENT_PROFILE_ROOT="${cmd_profile_root:-${AGENT_PROFILE_ROOT:-}}"
    AGENT_WORKSPACE="${cmd_workspace:-${AGENT_WORKSPACE:-}}"
    local h_sandbox_home="${cmd_hermes_sandbox_home:-${HERMES_SANDBOX_HOME:-}}"
    local h_home_override="${cmd_hermes_home:-${HERMES_HOME:-}}"

    local profile="${AGENT_PROFILE:-$DEFAULT_AGENT_PROFILE}"
    local profile_root
    local ws
    local h_home
    local sandbox_home
    profile_root=$(resolve_profile_vars "${AGENT_PROFILE_ROOT:-$DEFAULT_AGENT_PROFILE_ROOT}" "$home_spec" "$profile")
    ws=$(resolve_profile_vars "${AGENT_WORKSPACE:-$DEFAULT_AGENT_WORKSPACE}" "$home_spec" "$profile" "$profile_root")
    h_home=$(resolve_profile_vars "${h_home_override:-$DEFAULT_HERMES_HOME}" "$home_spec")
    sandbox_home=$(resolve_profile_vars "${h_sandbox_home:-$DEFAULT_HERMES_SANDBOX_HOME}" "$home_spec")

    if [ "$mode" = "transient" ]; then
        local temp_mounts=""
        for m in ${AGENT_EXTRA_MOUNTS:-}; do
            temp_mounts+="$(expand_specifiers "$m") "
        done
        AGENT_EXTRA_MOUNTS="$temp_mounts"
    fi

    local app_env_file
    local host_profile_root
    host_profile_root=$(resolve_profile_vars "${AGENT_PROFILE_ROOT:-$DEFAULT_AGENT_PROFILE_ROOT}" "$HOME" "$profile")
    app_env_file="$host_profile_root/.env"
    if [ -f "$app_env_file" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$app_env_file"
        set -u
    fi

    # Environment & Working Directory
    echo "Environment=HOME=$sandbox_home"
    echo "Environment=HERMES_SANDBOX_HOME=$sandbox_home"
    echo "Environment=HERMES_HOME=$h_home"
    echo "Environment=PATH=$sandbox_home/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    echo "Environment=AGENT_PROFILE=$profile"
    echo "Environment=AGENT_PROFILE_ROOT=$profile_root"
    echo "Environment=AGENT_WORKSPACE=$ws"
    echo "Environment=TERMINAL_CWD=$ws"
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/hermes-gateway.env"
    echo "EnvironmentFile=-${profile_root}/.env"
    echo "WorkingDirectory=$ws"

    # Security measures
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet="
    echo "AmbientCapabilities="

    # Filesystem isolation
    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    # Retain changes by bind mounting the explicit hermes home directory
    echo "BindPaths=$sandbox_home:$sandbox_home"

    for m in ${AGENT_PRIVATE_MOUNTS:-}; do
        mkdir -p "$HOME/agent-private/$m"
        echo "BindPaths=${home_spec}/agent-private/$m:${home_spec}/agent-private/$m"
    done

    for m in ${AGENT_SANDBOX_MOUNTS:-}; do
        local sandbox_name="${m%%/*}"
        local subpath="${m#*/}"
        mkdir -p "$HOME/.local/sandbox/${sandbox_name}/${subpath}"
        mkdir -p "$HOME/.local/sandbox/hermes/${subpath}"
        echo "BindPaths=${home_spec}/.local/sandbox/${sandbox_name}/${subpath}:${home_spec}/.local/sandbox/hermes/${subpath}"
    done

    for m in ${AGENT_EXTRA_MOUNTS:-}; do
        local abs_dir="${m%%:*}"
        local rel_dir="${m#*:}"
        # Expand %h or ~ using home_spec so it matches the mode (service vs transient)
        local systemd_abs_dir="${abs_dir//%h/"$home_spec"}"
        systemd_abs_dir="${systemd_abs_dir/#\~/"$home_spec"}"

        # But we must run mkdir on the real host path
        local host_abs_dir="${abs_dir//%h/"$HOME"}"
        host_abs_dir="${host_abs_dir/#\~/"$HOME"}"
        mkdir -p "$host_abs_dir" || true
        mkdir -p "$HOME/$rel_dir"
        echo "BindPaths=${systemd_abs_dir}:${home_spec}/${rel_dir}"
    done

    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "InaccessiblePaths=/usr/bin/systemctl /bin/systemctl"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=no"
    echo "PrivateMounts=yes"

    # Kernel and IPC constraints
    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "LockPersonality=yes"
    echo "MemoryDenyWriteExecute=no"
    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

write_service_file() {
    if [ -f "$ENV_FILE" ]; then
        if grep -q "%h" "$ENV_FILE"; then
            sed -i "s|%h|$HOME|g" "$ENV_FILE"
            echo "Expanded %h to $HOME in $ENV_FILE"
        fi
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    local profile="${AGENT_PROFILE:-$DEFAULT_AGENT_PROFILE}"
    local profile_root
    profile_root=$(resolve_profile_vars "${AGENT_PROFILE_ROOT:-$DEFAULT_AGENT_PROFILE_ROOT}" "$HOME" "$profile")
    local workspace_dir
    workspace_dir=$(resolve_profile_vars "${AGENT_WORKSPACE:-$DEFAULT_AGENT_WORKSPACE}" "$HOME" "$profile" "$profile_root")

    local app_env_file="$profile_root/.env"
    if [ -f "$app_env_file" ]; then
        if grep -q "%h" "$app_env_file"; then
            sed -i "s|%h|$HOME|g" "$app_env_file"
            echo "Expanded %h to $HOME in $app_env_file"
        fi
        set +u
        # shellcheck disable=SC1090
        source "$app_env_file"
        set -u
    fi
    mkdir -p "$workspace_dir"

    # Manage systemd-tmpfiles configuration file based on AGENT_TMPFILES_CLEANUP
    local tmpfiles_config="${XDG_CONFIG_HOME:-$HOME/.config}/user-tmpfiles.d/${SERVICE_NAME}.conf"
    local tmpfiles_dir
    tmpfiles_dir=$(dirname "$tmpfiles_config")
    mkdir -p "$tmpfiles_dir"

    local tmpfiles_cleanup_enabled="${AGENT_TMPFILES_CLEANUP:-$DEFAULT_AGENT_TMPFILES_CLEANUP}"

    if [ "$tmpfiles_cleanup_enabled" = "true" ]; then
        if [ -f "${tmpfiles_config}.disabled" ]; then
            mv "${tmpfiles_config}.disabled" "$tmpfiles_config"
            echo "Enabled systemd-tmpfiles configuration at $tmpfiles_config"
        elif [ ! -f "$tmpfiles_config" ]; then
            cat >"$tmpfiles_config" <<EOF
# ~/.config/user-tmpfiles.d/${SERVICE_NAME}.conf
# systemd-tmpfiles configuration for Hermes

# Example: Delete all files in workspace/voice-notes/read/ if older than 24 hours
# Type  Path                                  Mode UID  GID  Age  Argument
e       $workspace_dir/voice-notes/read       -    -    -    24h  -
EOF
            echo "Created and enabled default systemd-tmpfiles configuration at $tmpfiles_config"
        fi

        # Run cleanup now
        if is_systemd_running; then
            echo "Running systemd-tmpfiles cleanup..."
            systemd-tmpfiles --user --create --clean || true
        fi
    else
        if [ -f "$tmpfiles_config" ]; then
            mv "$tmpfiles_config" "${tmpfiles_config}.disabled"
            echo "Disabled systemd-tmpfiles configuration (renamed to ${tmpfiles_config}.disabled)"
        fi
    fi

    # Parse sidecars
    local sidecars_val="${AGENT_SIDECARS:-}"
    sidecars_val="${sidecars_val//;/ }"
    sidecars_val="${sidecars_val//$'\n'/ }"

    local sidecars_exec=""
    local sidecar_check=""
    local idx=0
    for sidecar in ${sidecars_val}; do
        local var_name
        var_name=$(sanitize_var_name "$sidecar")
        local cmd_var="AGENT_SIDECAR_${var_name}_CMD"
        local cmd_val="${!cmd_var:-}"
        if [ -z "$cmd_val" ]; then
            cmd_val="$sidecar"
        fi

        # Warn if command doesn't exist on host
        local host_cmd_val="$cmd_val"
        host_cmd_val="${host_cmd_val//\$AGENT_WORKSPACE/$workspace_dir}"
        host_cmd_val="${host_cmd_val//\$HOME/$HOME}"
        host_cmd_val="${host_cmd_val//%h/$HOME}"
        if [[ "$host_cmd_val" =~ ^(/|\.|\~) ]] || [ -f "$host_cmd_val" ]; then
            if [[ "$host_cmd_val" =~ ^~ ]]; then
                host_cmd_val="${host_cmd_val/#\~/$HOME}"
            fi
            if [ ! -x "$host_cmd_val" ]; then
                echo "Warning: Sidecar '$sidecar' executable '$cmd_val' (resolved: '$host_cmd_val') does not exist or is not executable." >&2
            fi
        else
            if ! command -v "$host_cmd_val" >/dev/null 2>&1; then
                echo "Warning: Sidecar '$sidecar' executable '$cmd_val' is not found in PATH." >&2
            fi
        fi

        local args_var="AGENT_SIDECAR_${var_name}_ARGS"
        local args_val="${!args_var:-}"

        # Process env removes and overrides
        local env_remove_var="AGENT_SIDECAR_${var_name}_ENV_REMOVE"
        local env_remove_val="${!env_remove_var:-}"
        local env_flags=""
        for r in ${env_remove_val}; do
            env_flags="$env_flags -u $r"
        done

        local env_override_var="AGENT_SIDECAR_${var_name}_ENV_OVERRIDE"
        local env_override_val="${!env_override_var:-}"
        for o in ${env_override_val}; do
            env_flags="$env_flags $o"
        done

        # Check executable inside sandbox at startup and print clear error if missing
        sidecars_exec="$sidecars_exec if ! command -v $cmd_val >/dev/null 2>&1 && [ ! -x \"$cmd_val\" ]; then echo \"Error: Cannot spawn sidecar $sidecar because its executable '$cmd_val' is missing or not executable.\" >&2 ; exit 1 ; fi ; env$env_flags $cmd_val $args_val & SIDECAR_PID_$idx=\$\$! ; "
        sidecar_check="$sidecar_check if ! kill -0 \$\$SIDECAR_PID_$idx 2>/dev/null; then echo \"Sidecar $sidecar (PID \$\$SIDECAR_PID_$idx) terminated.\" ; fi ; "
        idx=$((idx + 1))
    done

    local exec_start_cmd
    if [ -n "$sidecars_exec" ]; then
        local kill_pids="\$\$MAIN_PID"
        for ((i = 0; i < idx; i++)); do
            kill_pids="$kill_pids \$\$SIDECAR_PID_$i"
        done
        exec_start_cmd="/bin/bash -c 'trap \"kill $kill_pids 2>/dev/null || true\" EXIT ; /usr/bin/hermes -p $profile gateway run --force --no-supervise & MAIN_PID=\$\$! ; $sidecars_exec wait -n'"
    else
        exec_start_cmd="/usr/bin/hermes -p $profile gateway run --force --no-supervise"
    fi

    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=Hermes Agent Messaging Gateway
Documentation=https://hermes-agent.nousresearch.com/docs/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=40
StartLimitBurst=4

[Service]
Type=simple
$(get_shared_options service)
ExecStart=$exec_start_cmd
Restart=always
RestartSec=60
RestartMaxDelaySec=300
RestartSteps=5
# 75 is GATEWAY_SERVICE_RESTART_EXIT_CODE from hermes source
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 \$MAINPID
# Budget for graceful drain (default 180s) + cleanup
TimeoutStopSec=210

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-gateway

[Install]
WantedBy=default.target
EOF

    if is_systemd_running; then
        systemctl --user daemon-reload
    fi
}

cmd_install() {
    local no_start=false
    local new_config=false
    while [ $# -gt 0 ]; do
        case "$1" in
        --no-start) no_start=true ;;
        --new-config) new_config=true ;;
        esac
        shift
    done

    # Resolve profile first
    local cmd_profile="${AGENT_PROFILE:-}"
    local cmd_profile_root="${AGENT_PROFILE_ROOT:-}"
    local cmd_workspace="${AGENT_WORKSPACE:-}"
    local cmd_hermes_sandbox_home="${HERMES_SANDBOX_HOME:-}"
    local cmd_hermes_home="${HERMES_HOME:-}"

    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    if [ -n "$cmd_profile" ] && [ "${cmd_profile}" != "${AGENT_PROFILE:-}" ]; then
        AGENT_PROFILE_ROOT=""
        AGENT_WORKSPACE=""
    fi

    AGENT_PROFILE="${cmd_profile:-${AGENT_PROFILE:-}}"
    AGENT_PROFILE_ROOT="${cmd_profile_root:-${AGENT_PROFILE_ROOT:-}}"
    AGENT_WORKSPACE="${cmd_workspace:-${cmd_workspace:-}}"
    local h_sandbox_home="${cmd_hermes_sandbox_home:-${HERMES_SANDBOX_HOME:-}}"
    local h_home_override="${cmd_hermes_home:-${HERMES_HOME:-}}"

    local profile="${AGENT_PROFILE:-$DEFAULT_AGENT_PROFILE}"
    local profile_root
    local workspace_dir
    local root_hermes_home
    local sandbox_home
    profile_root=$(resolve_profile_vars "${AGENT_PROFILE_ROOT:-$DEFAULT_AGENT_PROFILE_ROOT}" "$HOME" "$profile")
    workspace_dir=$(resolve_profile_vars "${AGENT_WORKSPACE:-$DEFAULT_AGENT_WORKSPACE}" "$HOME" "$profile" "$profile_root")
    root_hermes_home=$(resolve_profile_vars "${h_home_override:-$DEFAULT_HERMES_HOME}" "$HOME")
    sandbox_home=$(resolve_profile_vars "${h_sandbox_home:-$DEFAULT_HERMES_SANDBOX_HOME}" "$HOME")

    echo "Setting up Hermes sandbox directory at $sandbox_home and profile root at $profile_root..."
    mkdir -p "$sandbox_home" "$root_hermes_home" "$profile_root" "$workspace_dir" \
        "$profile_root/cron" \
        "$profile_root/home" \
        "$profile_root/logs" \
        "$profile_root/memories" \
        "$profile_root/pairing" \
        "$profile_root/plans" \
        "$profile_root/sessions" \
        "$profile_root/skills" \
        "$profile_root/skins" \
        "$profile_root/audio_cache" \
        "$profile_root/image_cache" \
        "$sandbox_home/.local/bin"

    # Write active_profile file to root hermes home
    mkdir -p "$root_hermes_home"
    echo "$profile" >"$root_hermes_home/active_profile"
    echo "Set active_profile to $profile in $root_hermes_home/active_profile"

    echo "Generating systemd user service..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    # Write default env file if it doesn't exist or --new-config is specified
    if [ ! -f "$ENV_FILE" ] || [ "$new_config" = "true" ]; then
        cat >"$ENV_FILE" <<EOF
# Hermes Agent Environment Configuration

# Path to the sandbox home and hermes home directories
HERMES_SANDBOX_HOME="${DEFAULT_HERMES_SANDBOX_HOME}"
HERMES_HOME="${DEFAULT_HERMES_HOME}"

# Agent profile configuration
AGENT_PROFILE="${DEFAULT_AGENT_PROFILE}"
AGENT_PROFILE_ROOT="${DEFAULT_AGENT_PROFILE_ROOT}"

# List of submounts from ~/agent-private/* to bind-mount into the sandbox
# (e.g., AGENT_PRIVATE_MOUNTS="health diary" binds ~/agent-private/health and ~/agent-private/diary)
# AGENT_PRIVATE_MOUNTS=""

# List of submounts from other sandboxes (e.g., opencode) to bind-mount into this assistant's sandbox
AGENT_SANDBOX_MOUNTS="${DEFAULT_AGENT_SANDBOX_MOUNTS}"

# List of extra mounts to bind-mount into the sandbox (syntax: absolute-dir:relative-dir-to-HOME)
AGENT_EXTRA_MOUNTS="${DEFAULT_AGENT_EXTRA_MOUNTS}"

# Agent sandbox workspace path
AGENT_WORKSPACE="${DEFAULT_AGENT_WORKSPACE}"

# Agent sidecar list
AGENT_SIDECARS="${DEFAULT_AGENT_SIDECARS}"
AGENT_SIDECAR_DASHBOARD_CMD="${DEFAULT_AGENT_SIDECAR_DASHBOARD_CMD}"
AGENT_SIDECAR_DASHBOARD_ARGS="${DEFAULT_AGENT_SIDECAR_DASHBOARD_ARGS}"
AGENT_SIDECAR_HINDSIGHT_CMD="${DEFAULT_AGENT_SIDECAR_HINDSIGHT_CMD}"
AGENT_SIDECAR_HINDSIGHT_ARGS="${DEFAULT_AGENT_SIDECAR_HINDSIGHT_ARGS}"

# systemd-tmpfiles cleanup policy status
AGENT_TMPFILES_CLEANUP="${DEFAULT_AGENT_TMPFILES_CLEANUP}"

# Hindsight daemon configuration
HINDSIGHT_API_RUN_MIGRATIONS_ON_STARTUP="true"
HINDSIGHT_API_WORKER_ENABLED="true"
HINDSIGHT_API_MCP_ENABLED="true"

# multilingual support needs the following parts to be multilingual:
# chat model, embedding model, reranking model and database (postgresql) text search extension

