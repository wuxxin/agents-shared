#!/usr/bin/env bash
set -euo pipefail

# syncthing-ctl - installation and management wrapper for syncthing

SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/syncthing.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/syncthing.env"
SYNCTHING_HOME="$HOME/.local/sandbox/syncthing"

is_systemd_running() {
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/private" ]
}

sanitize_var_name() {
    local val="$1"
    val="${val//-/_}"
    val="${val//./_}"
    val="${val//\//_}"
    echo "${val^^}"
}

get_shared_options() {
    local mode="$1" # "service" or "transient"
    local home_spec
    if [ "$mode" = "service" ]; then
        home_spec="%h"
    else
        home_spec="$HOME"
    fi

    local SYNCTHING_PRIVATE_MOUNTS=""
    local SYNCTHING_SANDBOX_MOUNTS=""
    local SYNCTHING_EXTRA_MOUNTS=""

    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    # Environment & Working Directory
    echo "Environment=HOME=${home_spec}/.local/sandbox/syncthing"
    echo "Environment=STCONFDIR=${home_spec}/.local/sandbox/syncthing/.config/syncthing"
    echo "Environment=STDATADIR=${home_spec}/.local/sandbox/syncthing/.local/state/syncthing"
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/syncthing.env"
    echo "WorkingDirectory=${home_spec}/.local/sandbox/syncthing"

    # Security measures
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet="
    echo "AmbientCapabilities="

    # Filesystem hiding
    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    echo "BindPaths=${home_spec}/.local/sandbox/syncthing:${home_spec}/.local/sandbox/syncthing"
    echo "BindPaths=${home_spec}/.config/syncthing:${home_spec}/.local/sandbox/syncthing/.config/syncthing"
    echo "BindPaths=${home_spec}/.local/state/syncthing:${home_spec}/.local/sandbox/syncthing/.local/state/syncthing"

    for m in ${SYNCTHING_PRIVATE_MOUNTS:-}; do
        mkdir -p "$HOME/agent-private/$m"
        echo "BindPaths=${home_spec}/agent-private/$m:${home_spec}/agent-private/$m"
    done

    for m in ${SYNCTHING_SANDBOX_MOUNTS:-}; do
        local sandbox_name="${m%%/*}"
        local subpath="${m#*/}"
        mkdir -p "$HOME/.local/sandbox/${sandbox_name}/${subpath}"
        mkdir -p "$HOME/.local/sandbox/syncthing/${subpath}"
        echo "BindPaths=${home_spec}/.local/sandbox/${sandbox_name}/${subpath}:${home_spec}/.local/sandbox/syncthing/${subpath}"
    done

    for m in ${SYNCTHING_EXTRA_MOUNTS:-}; do
        local abs_dir="${m%%:*}"
        local rel_dir="${m#*:}"
        mkdir -p "$abs_dir" || true
        mkdir -p "$HOME/$rel_dir"
        echo "BindPaths=${abs_dir}:${home_spec}/${rel_dir}"
    done

    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=yes"
    echo "PrivateMounts=yes"

    # Kernel and IPC constraints
    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "LockPersonality=yes"
    echo "MemoryDenyWriteExecute=no"
    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

write_service_file() {
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    # Manage systemd-tmpfiles configuration file based on SYNCTHING_TMPFILES_CLEANUP
    local tmpfiles_config="${XDG_CONFIG_HOME:-$HOME/.config}/user-tmpfiles.d/syncthing.conf"
    local tmpfiles_dir
    tmpfiles_dir=$(dirname "$tmpfiles_config")
    mkdir -p "$tmpfiles_dir"

    local tmpfiles_cleanup_enabled="${SYNCTHING_TMPFILES_CLEANUP:-false}"

    if [ "$tmpfiles_cleanup_enabled" = "true" ]; then
        if [ -f "${tmpfiles_config}.disabled" ]; then
            mv "${tmpfiles_config}.disabled" "$tmpfiles_config"
            echo "Enabled systemd-tmpfiles configuration at $tmpfiles_config"
        elif [ ! -f "$tmpfiles_config" ]; then
            cat >"$tmpfiles_config" <<'EOF'
# ~/.config/user-tmpfiles.d/syncthing.conf
# systemd-tmpfiles configuration for Syncthing

# Example: Delete temporary / conflict files inside synchronized directories
# Type  Path                                            Mode UID  GID  Age  Argument
# e     %h/agent-shared/.syncthing.*.tmp                -    -    -    7d   -
EOF
            echo "Created and enabled default systemd-tmpfiles configuration at $tmpfiles_config"
        fi

        # Run cleanup now
        if is_systemd_running; then
            echo "Running systemd-tmpfiles cleanup..."
            systemd-tmpfiles --user --create --clean || true
        fi
    else
        if [ -f "$tmpfiles_config" ]; then
            mv "$tmpfiles_config" "${tmpfiles_config}.disabled"
            echo "Disabled systemd-tmpfiles configuration (renamed to ${tmpfiles_config}.disabled)"
        fi
    fi

    # Parse sidecars
    local sidecars_val="${SYNCTHING_SIDECARS:-}"
    sidecars_val="${sidecars_val//;/ }"
    sidecars_val="${sidecars_val//$'\n'/ }"

    local sidecars_exec=""
    local sidecar_check=""
    local idx=0
    for sidecar in ${sidecars_val}; do
        local var_name
        var_name=$(sanitize_var_name "$sidecar")
        local cmd_var="SYNCTHING_SIDECAR_${var_name}_CMD"
        local cmd_val="${!cmd_var:-}"
        if [ -z "$cmd_val" ]; then
            cmd_val="$sidecar"
        fi

        # Warn if command doesn't exist on host
        local host_cmd_val="$cmd_val"
        host_cmd_val="${host_cmd_val//\$HOME/$HOME}"
        host_cmd_val="${host_cmd_val//%h/$HOME}"
        if [[ "$host_cmd_val" =~ ^(/|\.|\~) ]] || [ -f "$host_cmd_val" ]; then
            if [[ "$host_cmd_val" =~ ^~ ]]; then
                host_cmd_val="${host_cmd_val/#\~/$HOME}"
            fi
            if [ ! -x "$host_cmd_val" ]; then
                echo "Warning: Sidecar '$sidecar' executable '$cmd_val' (resolved: '$host_cmd_val') does not exist or is not executable." >&2
            fi
        else
            if ! command -v "$host_cmd_val" >/dev/null 2>&1; then
                echo "Warning: Sidecar '$sidecar' executable '$cmd_val' is not found in PATH." >&2
            fi
        fi

        local args_var="SYNCTHING_SIDECAR_${var_name}_ARGS"
        local args_val="${!args_var:-}"

        # Process env removes and overrides
        local env_remove_var="SYNCTHING_SIDECAR_${var_name}_ENV_REMOVE"
        local env_remove_val="${!env_remove_var:-}"
        local env_flags=""
        for r in ${env_remove_val}; do
            env_flags="$env_flags -u $r"
        done

        local env_override_var="SYNCTHING_SIDECAR_${var_name}_ENV_OVERRIDE"
        local env_override_val="${!env_override_var:-}"
        for o in ${env_override_val}; do
            env_flags="$env_flags $o"
        done

        # Check executable inside sandbox at startup and print clear error if missing
        sidecars_exec="$sidecars_exec if ! command -v $cmd_val >/dev/null 2>&1 && [ ! -x \"$cmd_val\" ]; then echo \"Error: Cannot spawn sidecar $sidecar because its executable '$cmd_val' is missing or not executable.\" >&2 ; exit 1 ; fi ; env$env_flags $cmd_val $args_val & SIDECAR_PID_$idx=\$! ; "
        sidecar_check="$sidecar_check if ! kill -0 \$SIDECAR_PID_$idx 2>/dev/null; then echo \"Sidecar $sidecar (PID \$SIDECAR_PID_$idx) terminated.\" ; fi ; "
        idx=$((idx + 1))
    done

    local exec_start_cmd
    if [ -n "$sidecars_exec" ]; then
        exec_start_cmd="/bin/bash -c '/usr/bin/syncthing serve --no-browser --no-restart --logflags=0 & MAIN_PID=\$! ; sleep 2 ; if ! kill -0 \$MAIN_PID 2>/dev/null; then echo \"Main syncthing process (PID \$MAIN_PID) failed to start.\" >&2 ; exit 1 ; fi ; $sidecars_exec wait -n ; if ! kill -0 \$MAIN_PID 2>/dev/null; then echo \"Main syncthing process (PID \$MAIN_PID) terminated.\" ; fi ; $sidecar_check exit 1'"
    else
        exec_start_cmd="/usr/bin/syncthing serve --no-browser --no-restart --logflags=0"
    fi

    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=Confined Syncthing - Open Source Continuous File Synchronization
Documentation=man:syncthing(1)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=simple
$(get_shared_options service)
ExecStart=$exec_start_cmd
Restart=on-failure
RestartSec=1
SuccessExitStatus=3 4
RestartForceExitStatus=3 4

StandardOutput=journal
StandardError=journal
SyslogIdentifier=syncthing

[Install]
WantedBy=default.target
EOF

    if is_systemd_running; then
        systemctl --user daemon-reload
    fi
}

cmd_install() {
    local no_start=false
    local new_config=false
    while [ $# -gt 0 ]; do
        case "$1" in
        --no-start) no_start=true ;;
        --new-config) new_config=true ;;
        esac
        shift
    done

    echo "Setting up syncthing sandbox home directory at $SYNCTHING_HOME..."
    mkdir -p "$SYNCTHING_HOME"

    echo "Generating systemd user service..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    if [ ! -f "$ENV_FILE" ] || [ "$new_config" = "true" ]; then
        cat >"$ENV_FILE" <<'EOF'
# syncthing.env

# List of submounts from ~/agent-private/* to bind-mount into the sandbox
# (e.g., SYNCTHING_PRIVATE_MOUNTS="health diary" binds ~/agent-private/health and ~/agent-private/diary)
# SYNCTHING_PRIVATE_MOUNTS=""

# List of submounts from other sandboxes to bind-mount into this sandbox
# SYNCTHING_SANDBOX_MOUNTS=""

# List of extra mounts to bind-mount into the sandbox (syntax: absolute-dir:relative-dir-to-HOME)
# Default to bind-mounting the host's agent-shared workspace:
SYNCTHING_EXTRA_MOUNTS="$HOME/agent-shared:agent-shared"

# --- Sidecars Configuration (Optional)
# Space or semicolon separated list of sidecar names.
# SYNCTHING_SIDECARS="monitor"
#
# For each sidecar, configure its command, optional args and environment modifications:
# SYNCTHING_SIDECAR_MONITOR_CMD="$HOME/scripts/monitor-syncthing.sh"
# SYNCTHING_SIDECAR_MONITOR_ARGS=""
# SYNCTHING_SIDECAR_MONITOR_ENV_REMOVE=""
# SYNCTHING_SIDECAR_MONITOR_ENV_OVERRIDE="LOG_LEVEL=debug"

# --- Systemd Tmpfiles Cleanup Configuration (Optional)
# Enable or disable the user-level systemd-tmpfiles cleanup (true/false)
SYNCTHING_TMPFILES_CLEANUP=false

EOF
        chmod 600 "$ENV_FILE"
        echo "Created default environment file at $ENV_FILE"
    fi

    # Ensure configuration directories exist
    mkdir -p "$HOME/.config/syncthing"
    mkdir -p "$HOME/.local/state/syncthing"

    local config_file="$HOME/.config/syncthing/config.xml"
    if [ ! -f "$config_file" ] || [ "$new_config" = "true" ]; then
        echo "Generating default syncthing configuration..."
        /usr/bin/syncthing generate --config="$HOME/.config/syncthing" --data="$HOME/.local/state/syncthing"
    fi

    write_service_file

    if is_systemd_running; then
        echo "Reloading systemd and enabling service..."
        systemctl --user enable syncthing.service

        if [ "$no_start" = "true" ]; then
            echo "Stopping service if running (--no-start specified)..."
            systemctl --user stop syncthing.service || true
        else
            echo "Starting service automatically..."
            systemctl --user start syncthing.service
        fi
    else
        echo "Systemd is not running. Service file generated but not started/enabled."
    fi

    echo "Done! Type '$0 logs' to see the output."
}

cmd_uninstall() {
    echo "Uninstalling syncthing systemd service..."
    if is_systemd_running; then
        systemctl --user stop syncthing.service || true
        systemctl --user disable syncthing.service || true
    fi

    if [ -f "$SERVICE_FILE" ]; then
        rm "$SERVICE_FILE"
        if is_systemd_running; then
            systemctl --user daemon-reload
        fi
        echo "Removed service file."
    fi
    echo "Uninstalled successfully. Configuration and data are preserved."
}

cmd_start() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Use 'exec' to run syncthing directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user start syncthing.service
}

cmd_stop() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user stop syncthing.service
}

cmd_restart() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Use 'exec' to run syncthing directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user restart syncthing.service
}

cmd_status() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user status syncthing.service
}

cmd_enable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user enable syncthing.service
}

cmd_disable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user disable syncthing.service
}

cmd_logs() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Check direct execution console output instead." >&2
        exit 1
    fi
    journalctl --user -u syncthing.service "$@"
}

cmd_edit() {
    local config_file="$HOME/.config/syncthing/config.xml"
    local tmpfiles_config="${XDG_CONFIG_HOME:-$HOME/.config}/user-tmpfiles.d/syncthing.conf"
    local edit_tmpfiles="$tmpfiles_config"
    if [ ! -f "$tmpfiles_config" ] && [ -f "${tmpfiles_config}.disabled" ]; then
        edit_tmpfiles="${tmpfiles_config}.disabled"
    fi

    mkdir -p "$(dirname "$ENV_FILE")" "$(dirname "$config_file")" "$(dirname "$edit_tmpfiles")"
    touch "$ENV_FILE" "$config_file"

    if [ ! -f "$edit_tmpfiles" ]; then
        cat >"$edit_tmpfiles" <<'EOF'
# ~/.config/user-tmpfiles.d/syncthing.conf
# systemd-tmpfiles configuration for Syncthing

# Example: Delete temporary / conflict files inside synchronized directories
# Type  Path                                            Mode UID  GID  Age  Argument
# e     %h/agent-shared/.syncthing.*.tmp                -    -    -    7d   -
EOF
    fi

    ${EDITOR:-nano} "$ENV_FILE" "$config_file" "$edit_tmpfiles"
    if is_systemd_running; then
        echo "Restarting service to apply updated environment..."
        cmd_restart
    else
        echo "Systemd is not running. Service restart skipped."
    fi
}

FALLBACK_SIDECAR_PIDS=()
FALLBACK_SIDECAR_NAMES=()

setup_fallback_environment() {
    local real_home="$HOME"
    if [ -f "$ENV_FILE" ]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set +a
        set -u
    fi
    export HOME="$SYNCTHING_HOME"
    export STCONFDIR="$real_home/.config/syncthing"
    export STDATADIR="$real_home/.local/state/syncthing"
    mkdir -p "$SYNCTHING_HOME" "$STCONFDIR" "$STDATADIR"
    cd "$SYNCTHING_HOME" || exit 1
}

spawn_fallback_sidecars() {
    local sidecars_val="${SYNCTHING_SIDECARS:-}"
    sidecars_val="${sidecars_val//;/ }"
    sidecars_val="${sidecars_val//$'\n'/ }"

    for sidecar in ${sidecars_val}; do
        local var_name
        var_name=$(sanitize_var_name "$sidecar")
        local cmd_var="SYNCTHING_SIDECAR_${var_name}_CMD"
        local cmd_val="${!cmd_var:-}"
        if [ -z "$cmd_val" ]; then
            cmd_val="$sidecar"
        fi

        local args_var="SYNCTHING_SIDECAR_${var_name}_ARGS"
        local args_val="${!args_var:-}"

        # Host-side check before fork
        local check_cmd="$cmd_val"
        check_cmd="${check_cmd//\$HOME/$HOME}"
        check_cmd="${check_cmd//%h/$HOME}"
        if [[ "$check_cmd" =~ ^~ ]]; then
            check_cmd="${check_cmd/#\~/$HOME}"
        fi
        if ! command -v "$check_cmd" >/dev/null 2>&1 && [ ! -x "$check_cmd" ]; then
            echo "Error: Cannot spawn sidecar $sidecar because its executable '$cmd_val' (resolved: '$check_cmd') is missing or not executable." >&2
            exit 1
        fi

        # Process env removes and overrides
        local env_remove_var="SYNCTHING_SIDECAR_${var_name}_ENV_REMOVE"
        local env_remove_val="${!env_remove_var:-}"

        local env_override_var="SYNCTHING_SIDECAR_${var_name}_ENV_OVERRIDE"
        local env_override_val="${!env_override_var:-}"

        (
            # Apply removes
            for r in ${env_remove_val}; do
                unset "$r"
            done
            # Apply overrides
            for o in ${env_override_val}; do
                # shellcheck disable=SC2163
                export "$o"
            done
            # Execute
            eval "exec $cmd_val $args_val"
        ) &
        FALLBACK_SIDECAR_PIDS+=($!)
        FALLBACK_SIDECAR_NAMES+=("$sidecar")
    done
}

cmd_exec() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running syncthing directly..."
        setup_fallback_environment

        if [ "${1:-}" = "serve" ] || [ $# -eq 0 ]; then
            # Run cleanup if enabled
            if [ "${SYNCTHING_TMPFILES_CLEANUP:-false}" = "true" ]; then
                echo "Running systemd-tmpfiles cleanup..."
                systemd-tmpfiles --user --create --clean || true
            fi
            # Run syncthing in the background
            /usr/bin/syncthing serve --no-browser --no-restart --logflags=0 &
            local main_pid=$!
            sleep 2
            if ! kill -0 "$main_pid" 2>/dev/null; then
                echo "Main syncthing process (PID $main_pid) failed to start." >&2
                exit 1
            fi
            spawn_fallback_sidecars
            wait -n

            # Identify which process died
            if ! kill -0 "$main_pid" 2>/dev/null; then
                echo "Main syncthing process (PID $main_pid) terminated."
            fi
            for i in "${!FALLBACK_SIDECAR_PIDS[@]}"; do
                local pid="${FALLBACK_SIDECAR_PIDS[$i]}"
                local name="${FALLBACK_SIDECAR_NAMES[$i]}"
                if ! kill -0 "$pid" 2>/dev/null; then
                    echo "Sidecar $name (PID $pid) terminated."
                fi
            done
            exit 1
        else
            exec /usr/bin/syncthing "$@"
        fi
    fi

    echo "Starting syncthing as a transient systemd service with args: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" /usr/bin/syncthing "$@"
}

cmd_shell() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running shell directly..."
        setup_fallback_environment
        exec "${SHELL:-/bin/bash}" "$@"
    fi

    echo "Starting interactive shell as a transient systemd service..."

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "${SHELL:-/bin/bash}" "$@"
}

cmd_run() {
    if [ $# -lt 1 ]; then
        echo "Error: run requires a command to execute." >&2
        exit 1
    fi

    if ! is_systemd_running; then
        echo "Running command inside the syncthing environment: $*"
        setup_fallback_environment
        exec "$@"
    fi

    echo "Running command inside the syncthing environment: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "$@"
}

usage() {
    echo "Usage: $0 <command>"
    echo "Commands:"
    echo "  install [--no-start] [--new-config] - Setup service and syncthing home directory (do not start service if --no-start is specified, overwrite configs with defaults if --new-config is specified)"
    echo "  uninstall - Stop and remove systemd service"
    echo "  start     - Start the systemd service"
    echo "  stop      - Stop the systemd service"
    echo "  restart   - Restart the systemd service"
    echo "  status    - View systemd service status"
    echo "  enable    - Enable systemd service on boot"
    echo "  disable   - Disable systemd service on boot"
    echo "  logs      - Tail the systemd service logs"
    echo "  edit      - Edit the .env and config.xml files"
    echo "  exec      - Run syncthing as a transient systemd user service with args"
    echo "  run       - Run a command inside the syncthing systemd environment"
    echo "  shell     - Spawn an interactive shell in the syncthing systemd environment"
}

main() {
    if [ $# -lt 1 ]; then
        usage
        exit 1
    fi

    COMMAND="$1"
    shift

    case "$COMMAND" in
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    status) cmd_status ;;
    enable) cmd_enable ;;
    disable) cmd_disable ;;
    logs) cmd_logs "$@" ;;
    edit) cmd_edit ;;
    exec) cmd_exec "$@" ;;
    run) cmd_run "$@" ;;
    shell) cmd_shell "$@" ;;
    *)
        echo "Unknown command: $COMMAND"
        usage
        exit 1
        ;;
    esac
}

main "$@"
