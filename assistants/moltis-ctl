#!/usr/bin/env bash
set -euo pipefail

# moltis-ctl - installation and management wrapper for moltis

SERVICE_NAME="moltis"
SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE_NAME}.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/${SERVICE_NAME}.env"
MOLTIS_HOME="$HOME/.local/sandbox/moltis"

get_shared_options() {
    local mode="$1" # "service" or "transient"
    local home_spec
    if [ "$mode" = "service" ]; then
        home_spec="%h"
    else
        home_spec="$HOME"
    fi

    local AGENT_PRIVATE_MOUNTS=""
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    # Environment & Working Directory
    echo "Environment=HOME=${home_spec}/.local/sandbox/moltis"
    echo "Environment=MOLTIS_PORT=${MOLTIS_PORT:-13131}"
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/moltis.env"
    echo "WorkingDirectory=${home_spec}/.local/sandbox/moltis"

    # Security measures
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet=CAP_NET_BIND_SERVICE"
    echo "AmbientCapabilities=CAP_NET_BIND_SERVICE"

    # Filesystem isolation
    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    # Retain changes by bind mounting the explicit moltis home directory
    echo "BindPaths=${home_spec}/.local/sandbox/moltis:${home_spec}/.local/sandbox/moltis"
    # Allow access to agent-shared as requested for integration
    echo "BindPaths=${home_spec}/agent-shared:${home_spec}/agent-shared"

    for m in ${AGENT_PRIVATE_MOUNTS:-}; do
        mkdir -p "$HOME/agent-private/$m"
        echo "BindPaths=${home_spec}/agent-private/$m:${home_spec}/agent-private/$m"
    done

    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=no"
    echo "PrivateMounts=yes"

    # Kernel and IPC constraints
    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "LockPersonality=yes"
    echo "MemoryDenyWriteExecute=no"
    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

write_service_file() {
    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=Moltis Agent Server
Documentation=https://docs.moltis.org
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
$(get_shared_options service)
ExecStart=/usr/bin/moltis --bind 0.0.0.0 --port \$MOLTIS_PORT
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=moltis

[Install]
WantedBy=default.target
EOF

    if systemctl --user is-systemd-running &>/dev/null; then
        systemctl --user daemon-reload
    fi
}

cmd_install() {
    local no_start=false
    local new_config=false
    while [ $# -gt 0 ]; do
        case "$1" in
        --no-start) no_start=true ;;
        --new-config) new_config=true ;;
        esac
        shift
    done

    echo "Setting up Moltis home directory at $MOLTIS_HOME..."
    mkdir -p "$MOLTIS_HOME"

    echo "Generating systemd user service..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    # Write default env file if it doesn't exist or --new-config is specified
    if [ ! -f "$ENV_FILE" ] || [ "$new_config" = "true" ]; then
        cat >"$ENV_FILE" <<'EOF'
# Moltis Environment Configuration
# ---------------------------------------------------------------------------
# Set your password or other configuration here.
# For unattended deployment, set these before first boot:
# MOLTIS_PASSWORD=your_secure_password
# MOLTIS_PROVIDER=openai
# MOLTIS_API_KEY=sk-...
# ---------------------------------------------------------------------------

# Bind address and ports
# MOLTIS_BIND=0.0.0.0
# MOLTIS_PORT=13131

# Directories (default to sandboxed HOME at ~/.local/sandbox/moltis)
# MOLTIS_DATA_DIR=
# MOLTIS_CONFIG_DIR=

# List of submounts from ~/agent-private/* to bind-mount into the sandbox
# (e.g., AGENT_PRIVATE_MOUNTS="health diary" binds ~/agent-private/health and ~/agent-private/diary)
# AGENT_PRIVATE_MOUNTS=""

# Local Inference Split Services Overrides
# Default OpenAI-compatible LLM provider
MOLTIS_PROVIDERS__MODELS__OPENAI__LOCAL__URI="http://localhost:50080/v1"
MOLTIS_PROVIDERS__MODELS__OPENAI__LOCAL__API_KEY="unused"
MOLTIS_PROVIDERS__MODELS__OPENAI__LOCAL__MODEL="qwen3"
MOLTIS_PROVIDERS__MODELS__OPENAI__LOCAL__CONTEXT_WINDOW=80000

# Embeddings endpoint (llama-server on port 50080)
MOLTIS_EMBEDDINGS__URI="http://localhost:50080/v1"
MOLTIS_EMBEDDINGS__API_KEY="unused"
MOLTIS_EMBEDDINGS__PROVIDER="local"
MOLTIS_EMBEDDINGS__MODEL="text-embedding-3-small"

# Reranker endpoint (llama-server on port 50086)
MOLTIS_RETRIEVAL__RERANKER__URI="http://localhost:50086/v1/rerank"
MOLTIS_RETRIEVAL__RERANKER__PROVIDER="local"
MOLTIS_RETRIEVAL__RERANKER__MODEL="qwen3-reranker"
MOLTIS_RETRIEVAL__RERANKER__TOP_K=30

# Local Speech-to-Text endpoint (whisper-server on port 50090)
MOLTIS_VOICE__STT__ENABLED="true"
MOLTIS_VOICE__STT__PROVIDER="whisper_local"
MOLTIS_VOICE__STT__WHISPER_LOCAL__ENABLED="true"
MOLTIS_VOICE__STT__WHISPER_LOCAL__ENDPOINT="http://localhost:50090"
MOLTIS_VOICE__STT__WHISPER_LOCAL__MODEL="whisper-1"

# Local Text-to-Speech (TTS) endpoint (qwen3-tts on port 50095)
MOLTIS_VOICE__TTS__ENABLED="true"
MOLTIS_VOICE__TTS__PROVIDER="openai"
MOLTIS_VOICE__TTS__OPENAI__ENABLED="true"
MOLTIS_VOICE__TTS__OPENAI__BASE_URL="http://localhost:50095/v1"
MOLTIS_VOICE__TTS__OPENAI__MODEL="qwen3-tts"
MOLTIS_VOICE__TTS__OPENAI__VOICE="alloy"
MOLTIS_VOICE__TTS__OPENAI__API_KEY="unused"

# Signal channel configuration
MOLTIS_CHANNELS__SIGNAL__PERSONAL__ENABLED="true"
MOLTIS_CHANNELS__SIGNAL__PERSONAL__ACCOUNT="+1234567890"
MOLTIS_CHANNELS__SIGNAL__PERSONAL__HTTP_URL="http://localhost:50889"
MOLTIS_CHANNELS__SIGNAL__PERSONAL__DM_POLICY="open"
EOF
        chmod 600 "$ENV_FILE"
        echo "Created default environment file at $ENV_FILE"
    fi

    write_service_file

    if systemctl --user is-systemd-running &>/dev/null; then
        echo "Reloading systemd and enabling service..."
        systemctl --user enable "${SERVICE_NAME}.service"

        if [ "$no_start" = "true" ]; then
            echo "Stopping service if running (--no-start specified)..."
            systemctl --user stop "${SERVICE_NAME}.service" || true
        else
            echo "Starting service automatically..."
            systemctl --user start "${SERVICE_NAME}.service"
        fi
    else
        echo "Systemd is not running. Service file generated but not started/enabled."
    fi

    echo "---------------------------------------------------------------------------"
    echo "Moltis installation complete!"
    echo "---------------------------------------------------------------------------"
    echo "IMPORTANT: On the first run, Moltis prints a setup code to the journal."
    echo "Run '$0 logs' to see the setup code, then visit https://localhost:13131"
    echo "to complete the setup."
    echo "---------------------------------------------------------------------------"
    echo "Done! Type '$0 logs' to see the output."
}

cmd_uninstall() {
    echo "Uninstalling moltis systemd service..."
    if systemctl --user is-systemd-running &>/dev/null; then
        systemctl --user stop "${SERVICE_NAME}.service" || true
        systemctl --user disable "${SERVICE_NAME}.service" || true
    fi

    if [ -f "$SERVICE_FILE" ]; then
        rm "$SERVICE_FILE"
        if systemctl --user is-systemd-running &>/dev/null; then
            systemctl --user daemon-reload
        fi
        echo "Removed service file."
    fi
    echo "Uninstalled successfully. Data in $MOLTIS_HOME and configuration in $ENV_FILE are preserved."
}

cmd_start() {
    if ! systemctl --user is-systemd-running &>/dev/null; then
        echo "Error: Systemd is not running. Use 'exec' to run the assistant directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user start "${SERVICE_NAME}.service"
}

cmd_stop() {
    if ! systemctl --user is-systemd-running &>/dev/null; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user stop "${SERVICE_NAME}.service"
}

cmd_restart() {
    if ! systemctl --user is-systemd-running &>/dev/null; then
        echo "Error: Systemd is not running. Use 'exec' to run the assistant directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user restart "${SERVICE_NAME}.service"
}

cmd_status() {
    if ! systemctl --user is-systemd-running &>/dev/null; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user status "${SERVICE_NAME}.service"
}

cmd_enable() {
    if ! systemctl --user is-systemd-running &>/dev/null; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user enable "${SERVICE_NAME}.service"
}

cmd_disable() {
    if ! systemctl --user is-systemd-running &>/dev/null; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user disable "${SERVICE_NAME}.service"
}

cmd_logs() {
    if ! systemctl --user is-systemd-running &>/dev/null; then
        echo "Error: Systemd is not running. Check direct execution console output instead." >&2
        exit 1
    fi
    journalctl --user -u "${SERVICE_NAME}.service" "$@"
}

cmd_edit() {
    mkdir -p "$(dirname "$ENV_FILE")"
    touch "$ENV_FILE"
    ${EDITOR:-nano} "$ENV_FILE"
    echo "Restarting service to apply updated environment..."
    cmd_restart
}

cmd_exec() {
    if ! systemctl --user is-systemd-running &>/dev/null; then
        echo "Systemd is not running. Running moltis directly..."
        if [ -f "$ENV_FILE" ]; then
            set +u
            set -a
            # shellcheck disable=SC1090
            source "$ENV_FILE"
            set +a
            set -u
        fi
        export HOME="$MOLTIS_HOME"
        export MOLTIS_PORT="${MOLTIS_PORT:-13131}"
        mkdir -p "$MOLTIS_HOME"
        cd "$MOLTIS_HOME" || exit 1
        exec /usr/bin/moltis "$@"
    fi

    echo "Starting moltis as a transient systemd service with args: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" /usr/bin/moltis "$@"
}

cmd_shell() {
    if ! systemctl --user is-systemd-running &>/dev/null; then
        echo "Systemd is not running. Running shell directly..."
        if [ -f "$ENV_FILE" ]; then
            set +u
            set -a
            # shellcheck disable=SC1090
            source "$ENV_FILE"
            set +a
            set -u
        fi
        export HOME="$MOLTIS_HOME"
        export MOLTIS_PORT="${MOLTIS_PORT:-13131}"
        mkdir -p "$MOLTIS_HOME"
        cd "$MOLTIS_HOME" || exit 1
        exec "${SHELL:-/bin/bash}" "$@"
    fi

    echo "Starting interactive shell in the moltis systemd environment..."

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "${SHELL:-/bin/bash}" "$@"
}

cmd_run() {
    if [ $# -lt 1 ]; then
        echo "Error: run requires a command to execute." >&2
        exit 1
    fi

    if ! systemctl --user is-systemd-running &>/dev/null; then
        echo "Running command inside the moltis environment: $*"
        if [ -f "$ENV_FILE" ]; then
            set +u
            set -a
            # shellcheck disable=SC1090
            source "$ENV_FILE"
            set +a
            set -u
        fi
        export HOME="$MOLTIS_HOME"
        export MOLTIS_PORT="${MOLTIS_PORT:-13131}"
        mkdir -p "$MOLTIS_HOME"
        cd "$MOLTIS_HOME" || exit 1
        exec "$@"
    fi

    echo "Running command inside the moltis environment: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "$@"
}

usage() {
    echo "Usage: $0 <command>"
    echo "Commands:"
    echo "  install [--no-start] [--new-config] - Setup service and moltis home directory (do not start service if --no-start is specified, overwrite configs with defaults if --new-config is specified)"
    echo "  uninstall - Stop and remove systemd service"
    echo "  start     - Start the systemd service"
    echo "  stop      - Stop the systemd service"
    echo "  restart   - Restart the systemd service"
    echo "  status    - View systemd service status"
    echo "  enable    - Enable systemd service on boot"
    echo "  disable   - Disable systemd service on boot"
    echo "  logs      - Tail the systemd service logs"
    echo "  edit      - Edit the .env file and restart the service upon exit"
    echo "  exec      - Run moltis as a transient systemd user service with args"
    echo "  run       - Run a command inside the moltis systemd environment"
    echo "  shell     - Spawn an interactive shell in the moltis systemd environment"
}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
install) cmd_install "$@" ;;
uninstall) cmd_uninstall ;;
start) cmd_start ;;
stop) cmd_stop ;;
restart) cmd_restart ;;
status) cmd_status ;;
enable) cmd_enable ;;
disable) cmd_disable ;;
logs) cmd_logs "$@" ;;
edit) cmd_edit ;;
exec) cmd_exec "$@" ;;
run) cmd_run "$@" ;;
shell) cmd_shell "$@" ;;
*)
    echo "Unknown command: $COMMAND"
    usage
    exit 1
    ;;
esac
