#!/usr/bin/env bash
set -euo pipefail

# signal-cfg.sh - installation and management wrapper for signal-cli
#
# Manages a systemd user service (signal-cli.service) that runs signal-cli
# in daemon mode, exposing a JSON-RPC HTTP interface at 127.0.5.1:50888.
#
# Register/link an account first with signal-cli directly before starting
# the service. Configuration is read from the env file.

SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/signal-cli.service"
SERVICE_REST_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/signal-rest-api.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/signal-cli.env"
ENV_REST_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/signal-api.env"
SANDBOX_HOME="$HOME/.local/sandbox/signal-cli"
SIGNAL_DATA_DIR="$SANDBOX_HOME/.local/share/signal-cli"
JSONRPC_CONFIG_FILE="$SIGNAL_DATA_DIR/jsonrpc2.yml"

# Helper: Get value of a config key from an env file
_get_env_val() {
    local file="$1"
    local key="$2"
    local default="${3:-}"
    if [ -f "$file" ]; then
        grep "^${key}=" "$file" | cut -d'=' -f2- | tr -d ' "' || echo "$default"
    else
        echo "$default"
    fi
}

# Helper: Run a command inside a transient hardened systemd sandbox
_transient_run() {
    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "$@"
}

# Helper: Query the JSON-RPC UNIX socket daemon interface
_query_socket() {
    local socket="$1"
    local payload="$2"
    if [ ! -S "$socket" ]; then
        return 1
    fi
    if command -v socat &>/dev/null; then
        echo "$payload" | socat - "UNIX-CONNECT:$socket" 2>/dev/null || true
    elif command -v nc &>/dev/null && nc -U /dev/null &>/dev/null; then
        echo "$payload" | nc -U "$socket" 2>/dev/null || true
    else
        python3 -c "import socket; s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.connect('$socket'); s.sendall(b'$payload\n'); print(s.recv(4096).decode())" 2>/dev/null || true
    fi
}

# Helper: Query JSON-RPC HTTP endpoint (with fallback path /api/v1/rpc)
_query_http_rpc() {
    local host="$1"
    local port="$2"
    local payload="$3"
    local res
    res=$(curl -s -X POST -H "Content-Type: application/json" -d "$payload" "http://$host:$port/" || echo "")
    if ! echo "$res" | grep -q "result"; then
        res=$(curl -s -X POST -H "Content-Type: application/json" -d "$payload" "http://$host:$port/api/v1/rpc" || echo "")
    fi
    echo "$res"
}

# Shared Sandboxing Configuration
get_shared_options() {
    local mode="${1:-}" # "service" or "transient"
    : "$mode"
    local home_spec
    home_spec="$(getent passwd "$(whoami)" | cut -d: -f6)"
    if [ -z "$home_spec" ]; then
        home_spec="$HOME"
    fi

    # Environment & Working Directory
    echo "Environment=HOME=${home_spec}"
    echo "Environment=XDG_DATA_HOME=${home_spec}/.local/share"
    echo "Environment=XDG_CONFIG_HOME=${home_spec}/.config"
    echo "Environment=XDG_CACHE_HOME=${home_spec}/.cache"
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/signal-cli.env"
    echo "WorkingDirectory=/tmp"

    # Basic hardening (no bwrap/podman needed)
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet="
    echo "AmbientCapabilities="

    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    echo "BindPaths=${home_spec}/.local/sandbox/signal-cli:${home_spec}"
    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=yes"
    echo "PrivateMounts=yes"

    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "ProtectProc=invisible"
    echo "RestrictNamespaces=yes"
    echo "LockPersonality=yes"

    # Note: MemoryDenyWriteExecute is intentionally omitted because the JVM
    # requires the ability to create W+X memory mappings (JIT compilation).
    #
    # Note: ProcSubset=pid is intentionally omitted because the JVM requires
    # access to global /proc files (like /proc/meminfo and /proc/cpuinfo)
    # to inspect system resource limits and initialize garbage collection / JIT threads.

    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

cmd_install() {
    local no_start=false
    if [ "${1:-}" = "--no-start" ]; then
        no_start=true
    fi

    echo "Setting up signal-cli data directory at $SIGNAL_DATA_DIR..."
    mkdir -p "$SIGNAL_DATA_DIR"

    echo "Generating systemd user service..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=Signal CLI daemon
Documentation=https://github.com/AsamK/signal-cli
After=network.target

[Service]
Type=simple
$(get_shared_options service)

# signal-cli daemon with JSON-RPC over UNIX socket or TCP/HTTP ports.
# SC_ACCOUNT may be empty to run in multi-account mode (all registered accounts).
# SC_EXTRA_SUFFIXES can hold additional flags like --send-read-receipts, --ignore-stories.
ExecStart=/bin/sh -c 'exec signal-cli \\
    \$\$SC_EXTRA_PREFIXES \\
    \$\${SC_ACCOUNT:+--account "\$\$SC_ACCOUNT"} \\
    daemon \\
    --socket "\$\${SC_SOCKET_PATH:-\$\$HOME/signal.sock}" \\
    \$\${SC_HOST:+\$\${SC_TCP_PORT:+--tcp "\$\$SC_HOST:\$\$SC_TCP_PORT"}} \\
    \$\${SC_HOST:+\$\${SC_HTTP_PORT:+--http "\$\$SC_HOST:\$\$SC_HTTP_PORT"}} \\
    --receive-mode on-start \\
    \$\$SC_EXTRA_SUFFIXES'

Restart=on-failure
RestartSec=10s
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=signal-cli

[Install]
WantedBy=default.target
EOF

    echo "Generating Signal REST API systemd user service..."
    cat >"$SERVICE_REST_FILE" <<EOF
[Unit]
Description=Signal CLI REST API Wrapper
After=signal-cli.service

[Service]
Type=simple
$(get_shared_options service)
EnvironmentFile=-$HOME/.config/systemd/user/signal-api.env
ExecStart=/usr/bin/signal-cli-rest-api --signal-cli-config $HOME/.local/share/signal-cli
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
EOF

    if [ -f "$ENV_FILE" ]; then
        echo "Env file already exists, skipping: $ENV_FILE"
        echo "Remove it manually if you want to regenerate the defaults."
    else
        echo "Writing default env file: $ENV_FILE"
        cat >"$ENV_FILE" <<'EOF'
# signal-cli.env
# ---------------------------------------------------------------------------
# Configuration for the signal-cli.service daemon instance.
# Edit this file to set your account number or adjust runtime options.
# Reload with:  signal-ctl edit   (reloads daemon and restarts automatically)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ACCOUNT SETTINGS
# ---------------------------------------------------------------------------

# Your registered Signal phone number in E.164 format, e.g. +491234567890.
# Leave empty to run in multi-account mode (serves all registered accounts).
SC_ACCOUNT=

# ---------------------------------------------------------------------------
# NETWORK SETTINGS
# ---------------------------------------------------------------------------

# UNIX domain socket path (recommended for security; isolates daemon access).
# Real path on host: ~/.local/sandbox/signal-cli/signal.sock
# Leave empty to default to $HOME/signal.sock
SC_SOCKET_PATH=

# TCP/HTTP bind address and ports (optional).
# Keep these empty to disable TCP/HTTP JSON-RPC and use UNIX socket only.
SC_HOST=
SC_TCP_PORT=
SC_HTTP_PORT=

# ---------------------------------------------------------------------------
# EXTRA FLAGS (optional, space-separated)

# Valid options:
#   --no-receive-stdout    Don't print received messages to stdout
#   --send-read-receipts   Send read receipts automatically
#   --ignore-attachments   Skip downloading attachments
#   --ignore-stories       Suppress story messages
#   --ignore-avatars       Don't download avatars of received messages.
#   --ignore-stickers      Don't download sticker packs of received messages.
# ---------------------------------------------------------------------------
SC_EXTRA_SUFFIXES="--no-receive-stdout --ignore-stories --ignore-stickers"

# Valid options:
#   --verbose for debug, can be repeated for more verbosity
# ---------------------------------------------------------------------------
SC_EXTRA_PREFIXES=""

EOF
        chmod 600 "$ENV_FILE"
    fi

    if [ -f "$ENV_REST_FILE" ]; then
        echo "REST API env file already exists, skipping: $ENV_REST_FILE"
    else
        echo "Writing default REST API env file: $ENV_REST_FILE"
        cat >"$ENV_REST_FILE" <<EOF
# signal-api.env
# ---------------------------------------------------------------------------
# Configuration for the signal-cli-rest-api.service wrapper.
# ---------------------------------------------------------------------------

# Public bind address and port for the REST API.
HOST_IP=127.0.0.1
PORT=50889

# Execution mode. 'json-rpc' connects to the external signal-cli daemon.
MODE=json-rpc
LOG_LEVEL=warning

# Set to false to disable starting the REST API service automatically
SIGNAL_REST_API_ENABLED=true

# Security token for the REST API. If set, clients must provide this token
# via "Authorization: Bearer <token>" header or "?token=<token>" query parameter.
# Leave empty to disable authentication.
AUTH_TOKEN=

# Webhook for incoming messages (optional)
# RECEIVE_WEBHOOK_URL=http://localhost:port/webhook
EOF
        chmod 600 "$ENV_REST_FILE"
    fi

    echo "Writing JSON-RPC bridge config: $JSONRPC_CONFIG_FILE"
    cat >"$JSONRPC_CONFIG_FILE" <<EOF
config:
  "<multi-account>":
    socket_path: "$HOME/signal.sock"
EOF

    echo "Reloading systemd and enabling services..."
    systemctl --user daemon-reload
    systemctl --user enable signal-cli.service

    # Load rest api enabled status from env file
    local rest_enabled
    rest_enabled=$(_get_env_val "$ENV_REST_FILE" "SIGNAL_REST_API_ENABLED" "true")

    if [ "$rest_enabled" = "true" ]; then
        systemctl --user enable signal-rest-api.service
    else
        echo "REST API is disabled in $ENV_REST_FILE, skipping enable."
    fi

    if [ "$no_start" = "true" ]; then
        echo "Stopping services if running (--no-start specified)..."
        systemctl --user stop signal-rest-api.service 2>/dev/null || true
        systemctl --user stop signal-cli.service 2>/dev/null || true
    else
        echo "Starting services..."
        systemctl --user start signal-cli.service
        if [ "$rest_enabled" = "true" ]; then
            systemctl --user start signal-rest-api.service
        fi
    fi

    echo ""
    echo "Done! signal-cli service is configured."
    if [ "$no_start" = "true" ]; then
        echo "Services were NOT started (--no-start specified)."
    else
        echo "signal-cli service is running."
        if [ "$rest_enabled" = "true" ]; then
            echo "signal-rest-api service is running."
            echo "  REST API endpoint: http://127.0.0.1:50889"
        fi
    fi
    echo ""
    local socket_path="${SC_SOCKET_PATH:-}"
    if [ -z "$socket_path" ] || [ "$socket_path" = "%h/signal.sock" ] || [ "$socket_path" = "\$HOME/signal.sock" ]; then
        socket_path="$SANDBOX_HOME/signal.sock"
    fi
    echo "  UNIX RPC socket:   $socket_path"
    if [ -n "${SC_HOST:-}" ]; then
        echo "  TCP RPC endpoint:  $SC_HOST:${SC_TCP_PORT:-50887}"
        echo "  HTTP RPC endpoint: $SC_HOST:${SC_HTTP_PORT:-50888}"
    fi
    echo "  Logs: signal-ctl logs"
}

cmd_uninstall() {
    echo "Uninstalling signal-cli and REST API systemd services..."
    systemctl --user stop signal-rest-api.service 2>/dev/null || true
    systemctl --user stop signal-cli.service 2>/dev/null || true
    systemctl --user disable signal-rest-api.service 2>/dev/null || true
    systemctl --user disable signal-cli.service 2>/dev/null || true

    [ -f "$SERVICE_FILE" ] && rm "$SERVICE_FILE"
    [ -f "$SERVICE_REST_FILE" ] && rm "$SERVICE_REST_FILE"

    systemctl --user daemon-reload
    echo "Removed service files."

    echo ""
    echo "Uninstalled successfully."
    echo "Note: Env files and signal-cli data were NOT removed."
}

_run_service_cmd() {
    local cmd="$1"
    local rest_enabled
    rest_enabled=$(_get_env_val "$ENV_REST_FILE" "SIGNAL_REST_API_ENABLED" "true")

    systemctl --user "$cmd" signal-cli.service
    if [ "$rest_enabled" = "true" ]; then
        systemctl --user "$cmd" signal-rest-api.service
    fi
}

cmd_start() { _run_service_cmd start; }
cmd_stop() { _run_service_cmd stop; }
cmd_restart() { _run_service_cmd restart; }
cmd_status() { _run_service_cmd status; }
cmd_enable() { _run_service_cmd enable; }
cmd_disable() { _run_service_cmd disable; }
cmd_logs() {
    local rest_enabled
    rest_enabled=$(_get_env_val "$ENV_REST_FILE" "SIGNAL_REST_API_ENABLED" "true")

    if [ "$rest_enabled" = "true" ]; then
        journalctl --user -u signal-cli.service -u signal-rest-api.service "$@"
    else
        journalctl --user -u signal-cli.service "$@"
    fi
}

cmd_edit() {
    local files=("$ENV_FILE" "$ENV_REST_FILE")
    local editor
    editor="${VISUAL:-${EDITOR:-}}"
    if [ -z "$editor" ]; then
        for e in sensible-editor nano vim vi; do
            if command -v "$e" &>/dev/null; then
                editor="$e"
                break
            fi
        done
    fi
    if [ -z "$editor" ]; then
        echo "No editor found. Set \$VISUAL or \$EDITOR."
        exit 1
    fi
    "$editor" "${files[@]}"
    echo "Reloading daemon and restarting services to apply updated environment..."
    systemctl --user daemon-reload
    cmd_restart
}

cmd_exec() {
    echo "Starting signal-cli as a transient systemd service with args: $*"
    _transient_run signal-cli "$@"
}

cmd_shell() {
    echo "Starting interactive shell in the signal-cli systemd environment..."
    _transient_run "${SHELL:-/bin/bash}" "$@"
}

cmd_relink() {
    if [ $# -lt 1 ]; then
        echo "Usage: $(basename "$0") relink <device-name>" >&2
        exit 1
    fi
    local device_name="$1"
    _transient_run signal-cli link --name "$device_name" | tee >(head -n 1 | tr -d '\r' | qrencode -t ANSIUTF8 >&2)
}

cmd_test() {
    local interactive=false
    if [ "${1:-}" = "--interactive" ]; then
        interactive=true
    fi

    # Read configuration values using helper function
    local sc_host
    sc_host=$(_get_env_val "$ENV_FILE" "SC_HOST")
    local sc_http_port
    sc_http_port=$(_get_env_val "$ENV_FILE" "SC_HTTP_PORT")
    local sc_socket_path
    sc_socket_path=$(_get_env_val "$ENV_FILE" "SC_SOCKET_PATH")

    local rest_host
    rest_host=$(_get_env_val "$ENV_REST_FILE" "HOST_IP" "127.0.0.1")
    local rest_port
    rest_port=$(_get_env_val "$ENV_REST_FILE" "PORT" "50889")
    local rest_auth_token
    rest_auth_token=$(_get_env_val "$ENV_REST_FILE" "AUTH_TOKEN")

    local socket_path="$sc_socket_path"
    if [ -z "$socket_path" ] || [ "$socket_path" = "%h/signal.sock" ] || [ "$socket_path" = "\$HOME/signal.sock" ]; then
        socket_path="$SANDBOX_HOME/signal.sock"
    fi

    echo "=== Signal Service Test ==="
    echo "Checking configured service endpoints..."
    echo ""

    local rest_ok=false
    local rpc_http_ok=false
    local rpc_socket_ok=false
    local accounts=""

    # 1. Check REST API
    local auth_header=()
    if [ -n "$rest_auth_token" ]; then
        auth_header=(-H "Authorization: Bearer $rest_auth_token")
    fi

    echo -n "Checking REST API (http://$rest_host:$rest_port/v1/health)... "
    local rest_status
    rest_status=$(curl -s -o /dev/null -w "%{http_code}" "${auth_header[@]}" "http://$rest_host:$rest_port/v1/health" || echo "000")
    if [ "$rest_status" = "204" ] || [ "$rest_status" = "200" ]; then
        echo "OK (Status $rest_status)"
        rest_ok=true
    else
        echo "FAIL (Status $rest_status)"
    fi

    # 2. Check JSON-RPC HTTP API (if configured)
    if [ -n "$sc_host" ] && [ -n "$sc_http_port" ]; then
        echo -n "Checking JSON-RPC HTTP API (http://$sc_host:$sc_http_port/)... "
        local rpc_res
        rpc_res=$(_query_http_rpc "$sc_host" "$sc_http_port" '{"jsonrpc":"2.0","method":"listAccounts","id":1}')
        if echo "$rpc_res" | grep -q "result"; then
            echo "OK"
            rpc_http_ok=true
        else
            echo "FAIL"
        fi
    else
        echo "JSON-RPC HTTP API: Not configured in env (SC_HOST and SC_HTTP_PORT are empty)"
    fi

    # 3. Check UNIX Socket
    if [ -S "$socket_path" ]; then
        echo -n "Checking UNIX Socket ($socket_path)... "
        local socket_res
        socket_res=$(_query_socket "$socket_path" '{"jsonrpc":"2.0","method":"listAccounts","id":1}')
        if echo "$socket_res" | grep -q "result"; then
            echo "OK"
            rpc_socket_ok=true
        else
            echo "FAIL (Invalid response)"
        fi
    else
        echo "UNIX Socket: Not found at $socket_path (normal if running inside isolated model sandbox)"
    fi

    echo ""
    echo "=== Registered Accounts ==="
    local fetched_accounts=false

    # Try REST API first
    if [ "$rest_ok" = "true" ]; then
        local rest_acc
        rest_acc=$(curl -s "${auth_header[@]}" "http://$rest_host:$rest_port/v1/accounts" || echo "")
        if [ -n "$rest_acc" ] && [ "$rest_acc" != "null" ] && [ "$rest_acc" != "[]" ]; then
            echo "Accounts (via REST API):"
            if command -v jq &>/dev/null; then
                echo "$rest_acc" | jq -r '.[]'
            else
                echo "$rest_acc"
            fi
            accounts="$rest_acc"
            fetched_accounts=true
        fi
    fi

    # Try HTTP RPC if REST API failed or returned empty
    if [ "$fetched_accounts" = "false" ] && [ "$rpc_http_ok" = "true" ]; then
        local rpc_acc
        rpc_acc=$(_query_http_rpc "$sc_host" "$sc_http_port" '{"jsonrpc":"2.0","method":"listAccounts","id":1}')
        if [ -n "$rpc_acc" ] && echo "$rpc_acc" | grep -q "result"; then
            echo "Accounts (via JSON-RPC HTTP):"
            if command -v jq &>/dev/null; then
                echo "$rpc_acc" | jq -r '.result[].number'
                accounts=$(echo "$rpc_acc" | jq -r '[.result[].number]')
            else
                echo "$rpc_acc"
                accounts=$(echo "$rpc_acc" | grep -oP '"number":"\K[^"]+')
            fi
            fetched_accounts=true
        fi
    fi

    # Try UNIX Socket if both failed or returned empty
    if [ "$fetched_accounts" = "false" ] && [ "$rpc_socket_ok" = "true" ]; then
        local socket_acc
        socket_acc=$(_query_socket "$socket_path" '{"jsonrpc":"2.0","method":"listAccounts","id":1}')
        if [ -n "$socket_acc" ] && echo "$socket_acc" | grep -q "result"; then
            echo "Accounts (via UNIX Socket):"
            if command -v jq &>/dev/null; then
                echo "$socket_acc" | jq -r '.result[].number'
                accounts=$(echo "$socket_acc" | jq -r '[.result[].number]')
            else
                echo "$socket_acc"
                accounts=$(echo "$socket_acc" | grep -oP '"number":"\K[^"]+')
            fi
            fetched_accounts=true
        fi
    fi

    if [ "$fetched_accounts" = "false" ]; then
        echo "Warning: Could not retrieve accounts list from running service endpoints."
        echo "Check if the daemon is registered and running."
    fi

    # Interactive check
    if [ "$interactive" = "true" ]; then
        echo ""
        echo "=== Interactive Verification ==="
        if [ "$rest_ok" != "true" ]; then
            echo "Error: Interactive verification requires a running REST API." >&2
            return 1
        fi

        local test_account=""
        local sc_acc_env
        sc_acc_env=$(_get_env_val "$ENV_FILE" "SC_ACCOUNT")

        if [ -n "$sc_acc_env" ]; then
            test_account="$sc_acc_env"
        elif [ -n "$accounts" ] && [ "$accounts" != "[]" ]; then
            if command -v jq &>/dev/null; then
                if echo "$accounts" | jq -e . &>/dev/null; then
                    test_account=$(echo "$accounts" | jq -r '.[0]' 2>/dev/null || echo "")
                else
                    test_account=$(echo "$accounts" | head -n 1)
                fi
            else
                test_account=$(echo "$accounts" | head -n 1)
            fi
        fi

        if [ -z "$test_account" ] || [ "$test_account" = "null" ]; then
            echo "Error: No accounts available for interactive testing." >&2
            return 1
        fi

        echo "Selected testing account: $test_account"
        echo "Please send a test message to '$test_account' from another Signal device now."
        echo "Polling REST API (http://$rest_host:$rest_port/v1/receive/$test_account) for new messages..."
        echo "Press Ctrl+C to cancel."
        echo ""

        local timeout=60
        local elapsed=0
        local message_found=false

        while [ $elapsed -lt $timeout ]; do
            local recv_res
            recv_res=$(curl -s "${auth_header[@]}" "http://$rest_host:$rest_port/v1/receive/$test_account" || echo "[]")

            if [ -n "$recv_res" ] && [ "$recv_res" != "[]" ] && [ "$recv_res" != "null" ]; then
                echo "Success! Message received:"
                if command -v jq &>/dev/null; then
                    echo "$recv_res" | jq -r '.[] | "  From: \(.envelope.sourceName // .envelope.sourceNumber // .envelope.source) - Message: \(.envelope.dataMessage.message // "<no text message>")"'
                else
                    echo "$recv_res"
                fi
                message_found=true
                break
            fi

            sleep 2
            elapsed=$((elapsed + 2))
        done

        if [ "$message_found" = "false" ]; then
            echo "Timeout: No messages received within $timeout seconds." >&2
            return 1
        fi
    fi

    return 0
}

usage() {
    cat <<EOF
Usage: $(basename "$0") <command>

Manage the signal-cli systemd user service (JSON-RPC daemon).

Commands:
  install [--no-start]
            - Install service file, create default env file (if not present),
              enable and start the service (do not start if --no-start is specified)
  uninstall - Stop, disable and remove the service file (data preserved)
  start     - Start the systemd service
  stop      - Stop the systemd service
  restart   - Restart the systemd service
  status    - View systemd service status
  enable    - Enable systemd service on login
  disable   - Disable systemd service on login
  logs      - Tail the systemd service logs
  edit      - Edit the env files (CLI and REST) in \$VISUAL/\$EDITOR and restart daemon
  exec      - Run signal-cli as a transient hardened systemd unit with args
  shell     - Spawn an interactive shell in the signal-cli systemd environment
  relink <device-name>
            - Link an account and display QR code (passes name of link for Signal GUI)
  test [--interactive]
            - Run health check on service endpoints (REST, HTTP RPC, UNIX socket) and list active accounts.
              If --interactive, polls the REST API for a test message sent by the user.

Files managed:
  Service:  $SERVICE_FILE
  Env:      $ENV_FILE
  Data:     $SIGNAL_DATA_DIR

Environment variables (set in the env file):
  SC_ACCOUNT      Phone number in E.164 format (+49...) for single-account mode.
                  Leave empty to serve all registered accounts (multi-account).
  SC_SOCKET_PATH  UNIX domain socket path (default: %h/signal.sock)
  SC_HOST         TCP/HTTP bind address (default: empty / disabled)
  SC_TCP_PORT     TCP bind port    (default: empty / disabled)
  SC_HTTP_PORT    HTTP bind port   (default: empty / disabled)
  SC_EXTRA_SUFFIXES Additional daemon flags, space-separated, e.g.:
                    --send-read-receipts
                    --ignore-attachments
                    --ignore-stories
  SC_EXTRA_PREFIXES Additional daemon flags, space-separated, e.g.:
                    --verbose

JSON-RPC socket (internal):
  %h/signal.sock

REST API endpoint:
  http://127.0.0.1:50889


Account setup (one-time, before first start):
  signal-ctl stop
  signal-ctl shell

    signal-cli link --name "$(hostname)" | \
        tee >(head -1 | qrencode -t ANSIUTF8 >&2)
    signal-cli verify <code>

    # or: signal-cli register --account +49...    # register new number
    # then: signal-cli verify --account +49... <CODE>
    # then set SC_ACCOUNT in $ENV_FILE

  signal-ctl start
EOF
}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
install) cmd_install "$@" ;;
uninstall) cmd_uninstall ;;
start) cmd_start ;;
stop) cmd_stop ;;
restart) cmd_restart ;;
status) cmd_status ;;
enable) cmd_enable ;;
disable) cmd_disable ;;
logs) cmd_logs "$@" ;;
edit) cmd_edit ;;
exec) cmd_exec "$@" ;;
shell) cmd_shell "$@" ;;
relink) cmd_relink "$@" ;;
test) cmd_test "$@" ;;
*)
    echo "Unknown command: $COMMAND"
    usage
    exit 1
    ;;
esac
