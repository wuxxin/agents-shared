# --- Default Agent Workspace Configuration (Optional)
# The directory where the agent's workspace data and files are kept, available as ENV Variable.
# If unset, defaults to $HOME/.local/sandbox/zeroclaw/.zeroclaw/agents/default/workspace.
# This does not set the config for the agent, but makes the workspace directory known to scripts.
# AGENT_WORKSPACE="$HOME/.local/sandbox/zeroclaw/.zeroclaw/agents/default/workspace"

# --- Sidecars Configuration (Optional)
