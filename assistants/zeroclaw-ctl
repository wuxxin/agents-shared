# AGENT_SIDECAR_AUDIONOTES_ARGS="$AGENT_WORKSPACE/audionotes"
# AGENT_SIDECAR_AUDIONOTES_ENV_REMOVE="ZEROCLAW_PORT"
# AGENT_SIDECAR_AUDIONOTES_ENV_OVERRIDE="TARGET_DIR=$AGENT_WORKSPACE/audionotes"

# --- Systemd Tmpfiles Cleanup Configuration (Optional)
# Enable or disable the user-level systemd-tmpfiles cleanup (true/false)
AGENT_TMPFILES_CLEANUP=false

EOF
        chmod 600 "$ENV_FILE"
        echo "Created default environment file at $ENV_FILE"
    fi

    local CONFIG_DIR="$ZEROCLAW_HOME/.zeroclaw"
    local CONFIG_FILE="$CONFIG_DIR/config.toml"
    if [ ! -f "$CONFIG_FILE" ] || [ "$new_config" = "true" ]; then
        mkdir -p "$CONFIG_DIR"
        cat >"$CONFIG_FILE" <<'EOF'
