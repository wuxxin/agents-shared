cmd_uninstall() {
    echo "Uninstalling zeroclaw systemd service..."
    if is_systemd_running; then
        systemctl --user stop zeroclaw.service || true
        systemctl --user disable zeroclaw.service || true
    fi

    if [ -f "$SERVICE_FILE" ]; then
        rm "$SERVICE_FILE"
        if is_systemd_running; then
            systemctl --user daemon-reload
        fi
        echo "Removed service file."
    fi
    echo "Uninstalled successfully. Data in $ZEROCLAW_HOME is preserved."
}

cmd_start() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Use 'exec' to run the assistant directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user start zeroclaw.service
}

cmd_stop() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user stop zeroclaw.service
}

cmd_restart() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Use 'exec' to run the assistant directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user restart zeroclaw.service
}

cmd_status() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user status zeroclaw.service
}

cmd_enable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user enable zeroclaw.service
}

cmd_disable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user disable zeroclaw.service
}

cmd_logs() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Check direct execution console output instead." >&2
        exit 1
    fi
    journalctl --user -u zeroclaw.service "$@"
}

cmd_edit() {
    local config_file="$ZEROCLAW_HOME/.zeroclaw/config.toml"
    local tmpfiles_config="${XDG_CONFIG_HOME:-$HOME/.config}/user-tmpfiles.d/zeroclaw.conf"
    local edit_tmpfiles="$tmpfiles_config"
    if [ ! -f "$tmpfiles_config" ] && [ -f "${tmpfiles_config}.disabled" ]; then
        edit_tmpfiles="${tmpfiles_config}.disabled"
    fi

    mkdir -p "$(dirname "$ENV_FILE")" "$(dirname "$config_file")" "$(dirname "$edit_tmpfiles")"
    touch "$ENV_FILE" "$config_file"

    if [ ! -f "$edit_tmpfiles" ]; then
        cat >"$edit_tmpfiles" <<'EOF'
# ~/.config/user-tmpfiles.d/zeroclaw.conf
# systemd-tmpfiles configuration for ZeroClaw

# Example: Delete all files in workspace/voice-notes/read/ if older than 24 hours
# Type  Path                                                                                Mode UID  GID  Age  Argument
e       %h/.local/sandbox/zeroclaw/.zeroclaw/agents/default/workspace/voice-notes/read       -    -    -    24h  -
EOF
    fi

    ${EDITOR:-nano} "$ENV_FILE" "$config_file" "$edit_tmpfiles"
    if is_systemd_running; then
        echo "Restarting service to apply updated environment..."
        cmd_restart
    else
        echo "Systemd is not running. Service restart skipped."
    fi
}
FALLBACK_SIDECAR_PIDS=()
FALLBACK_SIDECAR_NAMES=()

setup_fallback_environment() {
    # Set default AGENT_WORKSPACE before sourcing so self-referencing variables expand correctly
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-$ZEROCLAW_HOME/.zeroclaw/agents/default/workspace}"
    if [ -f "$ENV_FILE" ]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set +a
        set -u
    fi
    export HOME="$ZEROCLAW_HOME"
    export ZEROCLAW_PORT="${ZEROCLAW_PORT:-42617}"
    export ZEROCLAW_HOST="${ZEROCLAW_HOST:-127.0.0.1}"
    local ws="${AGENT_WORKSPACE:-$ZEROCLAW_HOME/.zeroclaw/agents/default/workspace}"
    ws="${ws//%h/$HOME}"
    if [[ "$ws" =~ ^~ ]]; then
        ws="${ws/#\~/$HOME}"
    fi
    export AGENT_WORKSPACE="$ws"
    mkdir -p "$ZEROCLAW_HOME" "$AGENT_WORKSPACE"
    cd "$ZEROCLAW_HOME" || exit 1
}

spawn_fallback_sidecars() {
    local sidecars_val="${AGENT_SIDECARS:-}"
    sidecars_val="${sidecars_val//;/ }"
    sidecars_val="${sidecars_val//$'\n'/ }"

    for sidecar in ${sidecars_val}; do
        local var_name
        var_name=$(sanitize_var_name "$sidecar")
        local cmd_var="AGENT_SIDECAR_${var_name}_CMD"
        local cmd_val="${!cmd_var:-}"
        if [ -z "$cmd_val" ]; then
            cmd_val="$sidecar"
        fi

        local args_var="AGENT_SIDECAR_${var_name}_ARGS"
        local args_val="${!args_var:-}"

        # Host-side check before fork
        local check_cmd="$cmd_val"
        check_cmd="${check_cmd//\$AGENT_WORKSPACE/$AGENT_WORKSPACE}"
        check_cmd="${check_cmd//\$HOME/$HOME}"
        check_cmd="${check_cmd//%h/$HOME}"
        if [[ "$check_cmd" =~ ^~ ]]; then
            check_cmd="${check_cmd/#\~/$HOME}"
        fi
        if ! command -v "$check_cmd" >/dev/null 2>&1 && [ ! -x "$check_cmd" ]; then
            echo "Error: Cannot spawn sidecar $sidecar because its executable '$cmd_val' (resolved: '$check_cmd') is missing or not executable." >&2
            exit 1
        fi

        # Process env removes and overrides
        local env_remove_var="AGENT_SIDECAR_${var_name}_ENV_REMOVE"
        local env_remove_val="${!env_remove_var:-}"

        local env_override_var="AGENT_SIDECAR_${var_name}_ENV_OVERRIDE"
        local env_override_val="${!env_override_var:-}"

        (
            # Apply removes
            for r in ${env_remove_val}; do
                unset "$r"
            done
            # Apply overrides
            for o in ${env_override_val}; do
                # shellcheck disable=SC2163
                export "$o"
            done
            # Execute
            eval "exec $cmd_val $args_val"
        ) &
        FALLBACK_SIDECAR_PIDS+=($!)
        FALLBACK_SIDECAR_NAMES+=("$sidecar")
    done
}

cmd_exec() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running zeroclaw directly..."
        setup_fallback_environment

        if [ "${1:-}" = "daemon" ]; then
            # Run cleanup if enabled
            if [ "${AGENT_TMPFILES_CLEANUP:-false}" = "true" ]; then
                echo "Running systemd-tmpfiles cleanup..."
                systemd-tmpfiles --user --create --clean || true
            fi
            # Run daemon in the background
            /usr/bin/zeroclaw "$@" &
            local main_pid=$!
            sleep 2
            if ! kill -0 "$main_pid" 2>/dev/null; then
                echo "Main daemon process (PID $main_pid) failed to start." >&2
                exit 1
            fi
            spawn_fallback_sidecars
            wait -n

            # Identify which process died
            if ! kill -0 "$main_pid" 2>/dev/null; then
                echo "Main daemon process (PID $main_pid) terminated."
            fi
            for i in "${!FALLBACK_SIDECAR_PIDS[@]}"; do
                local pid="${FALLBACK_SIDECAR_PIDS[$i]}"
                local name="${FALLBACK_SIDECAR_NAMES[$i]}"
                if ! kill -0 "$pid" 2>/dev/null; then
                    echo "Sidecar $name (PID $pid) terminated."
                fi
            done
            exit 1
        else
            exec /usr/bin/zeroclaw "$@"
        fi
    fi

    echo "Starting zeroclaw as a transient systemd service with args: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" /usr/bin/zeroclaw "$@"
}

cmd_shell() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running shell directly..."
        setup_fallback_environment
        exec "${SHELL:-/bin/bash}" "$@"
    fi

    echo "Starting interactive shell as a transient systemd service..."

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "${SHELL:-/bin/bash}" "$@"
}

cmd_run() {
    if [ $# -lt 1 ]; then
        echo "Error: run requires a command to execute." >&2
        exit 1
    fi

    if ! is_systemd_running; then
        echo "Running command inside the zeroclaw environment: $*"
        setup_fallback_environment
        exec "$@"
    fi

    echo "Running command inside the zeroclaw environment: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "$@"
}

usage() {
    echo "Usage: $0 <command>"
    echo "Commands:"
    echo "  install [--no-start] [--new-config] - Setup service and zeroclaw home directory (do not start service if --no-start is specified, overwrite configs with defaults if --new-config is specified)"
    echo "  uninstall - Stop and remove systemd service"
    echo "  start     - Start the systemd service"
    echo "  stop      - Stop the systemd service"
    echo "  restart   - Restart the systemd service"
    echo "  status    - View systemd service status"
    echo "  enable    - Enable systemd service on boot"
    echo "  disable   - Disable systemd service on boot"
    echo "  logs      - Tail the systemd service logs"
    echo "  edit      - Edit the .env and config.toml files"
    echo "  exec      - Run zeroclaw as a transient systemd user service with args"
    echo "  run       - Run a command inside the zeroclaw systemd environment"
    echo "  shell     - Spawn an interactive shell in the zeroclaw systemd environment"
}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
install) cmd_install "$@" ;;
uninstall) cmd_uninstall ;;
start) cmd_start ;;
stop) cmd_stop ;;
restart) cmd_restart ;;
status) cmd_status ;;
enable) cmd_enable ;;
disable) cmd_disable ;;
logs) cmd_logs "$@" ;;
edit) cmd_edit ;;
exec) cmd_exec "$@" ;;
run) cmd_run "$@" ;;
shell) cmd_shell "$@" ;;
*)
    echo "Unknown command: $COMMAND"
    usage
    exit 1
    ;;
esac
