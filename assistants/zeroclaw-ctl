#!/usr/bin/env bash
set -euo pipefail

# zeroclaw-ctl - installation and management wrapper for zeroclaw

SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/zeroclaw.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/zeroclaw.env"
ZEROCLAW_HOME="$HOME/.local/sandbox/zeroclaw"

is_systemd_running() {
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/private" ]
}

get_shared_options() {
    local mode="$1" # "service" or "transient"
    local home_spec
    if [ "$mode" = "service" ]; then
        home_spec="%h"
    else
        home_spec="$HOME"
    fi

    local AGENT_PRIVATE_MOUNTS=""
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    # Environment & Working Directory
    echo "Environment=HOME=${home_spec}/.local/sandbox/zeroclaw"
    echo "Environment=ZEROCLAW_PORT=${ZEROCLAW_PORT:-42617}"
    echo "Environment=ZEROCLAW_HOST=${ZEROCLAW_HOST:-127.0.0.1}"
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/zeroclaw.env"
    echo "WorkingDirectory=${home_spec}/.local/sandbox/zeroclaw"

    # Security measures
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet="
    echo "AmbientCapabilities="

    # Filesystem hiding
    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    echo "BindPaths=${home_spec}/.local/sandbox/zeroclaw:${home_spec}/.local/sandbox/zeroclaw"
    echo "BindPaths=${home_spec}/agent-shared:${home_spec}/agent-shared"

    for m in ${AGENT_PRIVATE_MOUNTS:-}; do
        mkdir -p "$HOME/agent-private/$m"
        echo "BindPaths=${home_spec}/agent-private/$m:${home_spec}/agent-private/$m"
    done

    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=yes"
    echo "PrivateMounts=yes"

    # Kernel and IPC constraints
    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "LockPersonality=yes"
    echo "MemoryDenyWriteExecute=no"
    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

write_service_file() {
    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=ZeroClaw Agent OS Daemon
Documentation=https://github.com/zeroclaw-labs/zeroclaw
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
$(get_shared_options service)
ExecStart=/usr/bin/zeroclaw daemon --host \$ZEROCLAW_HOST --port \$ZEROCLAW_PORT
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zeroclaw

# Note: ProtectProc=invisible, ProcSubset=pid, and RestrictNamespaces=yes
# are explicitly omitted to allow child processes to use bwrap.

[Install]
WantedBy=default.target
EOF

    if is_systemd_running; then
        systemctl --user daemon-reload
    fi
}

cmd_install() {
    local no_start=false
    local new_config=false
    while [ $# -gt 0 ]; do
        case "$1" in
        --no-start) no_start=true ;;
        --new-config) new_config=true ;;
        esac
        shift
    done

    echo "Setting up zeroclaw home directory at $ZEROCLAW_HOME..."
    mkdir -p "$ZEROCLAW_HOME"

    echo "Generating systemd user service..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    if [ ! -f "$ENV_FILE" ] || [ "$new_config" = "true" ]; then
        cat >"$ENV_FILE" <<'EOF'
# zeroclaw.env
# ZEROCLAW_PORT: Gateway port for ZeroClaw (default 42617)
ZEROCLAW_PORT=42617
# ZEROCLAW_HOST: Gateway host for ZeroClaw (default *)
ZEROCLAW_HOST=127.0.0.1

# List of submounts from ~/agent-private/* to bind-mount into the sandbox
# (e.g., AGENT_PRIVATE_MOUNTS="health diary" binds ~/agent-private/health and ~/agent-private/diary)
# AGENT_PRIVATE_MOUNTS=""
EOF
        chmod 600 "$ENV_FILE"
        echo "Created default environment file at $ENV_FILE"
    fi

    local CONFIG_DIR="$ZEROCLAW_HOME/.zeroclaw"
    local CONFIG_FILE="$CONFIG_DIR/config.toml"
    if [ ! -f "$CONFIG_FILE" ] || [ "$new_config" = "true" ]; then
        mkdir -p "$CONFIG_DIR"
        cat >"$CONFIG_FILE" <<'EOF'
# config.toml — ZeroClaw local inference configuration
# Generated by zeroclaw-ctl install --new-config
# All settings below target the local inference split services.

schema_version = 3

# --- Chat / LLM Provider
[providers.models.openai.local]
uri = "http://localhost:50080/v1"
model = "qwen3"
api_key = "unused"
max_tokens = 80000

# --- Default Agent Settings
[agents.default]
model_provider = "openai.local"
max_context_tokens = 80000
tts_provider = "openai.local"
transcription_provider = "local_whisper.localstt"
channels = ["signal.default"]

[agents.default.memory]
backend = "sqlite"

# --- Memory & Embeddings
[memory]
backend = "storage.sqlite.default"
embedding_model = "qwen3-embedding"
embedding_provider = "custom:http://localhost:50080/v1"
rerank_enabled = false
retrieval_stages = ["cache", "fts", "vector"]
search_mode = "hybrid"

# --- Speech-to-Text
[transcription]
enabled = true

[providers.transcription.local_whisper.localstt]
uri = "http://localhost:50090/v1/audio/transcriptions"
bearer_token = "dummy"
model = "whisper-1"

# --- Text-to-Speech
[tts]
enabled = true

[providers.tts.openai.local]
uri = "http://localhost:50095/v1/audio/speech"
model = "qwen3-tts"
api_key = "unused"

# --- Signal Channel
[channels.signal.default]
enabled = true
http_url = "http://localhost:50889"
account = "+1234567890"
approval_timeout_secs = 0
dm_only = true
ignore_attachments = false
ignore_stories = true
default_target = "+0000000000"

EOF
        echo "Created default configuration at $CONFIG_FILE"
    fi

    write_service_file

    if is_systemd_running; then
        echo "Reloading systemd and enabling service..."
        systemctl --user enable zeroclaw.service

        if [ "$no_start" = "true" ]; then
            echo "Stopping service if running (--no-start specified)..."
            systemctl --user stop zeroclaw.service || true
        else
            echo "Starting service automatically..."
            systemctl --user start zeroclaw.service
        fi
    else
        echo "Systemd is not running. Service file generated but not started/enabled."
    fi

    echo "Done! Type '$0 logs' to see the output."
}

cmd_uninstall() {
    echo "Uninstalling zeroclaw systemd service..."
    if is_systemd_running; then
        systemctl --user stop zeroclaw.service || true
        systemctl --user disable zeroclaw.service || true
    fi

    if [ -f "$SERVICE_FILE" ]; then
        rm "$SERVICE_FILE"
        if is_systemd_running; then
            systemctl --user daemon-reload
        fi
        echo "Removed service file."
    fi
    echo "Uninstalled successfully. Data in $ZEROCLAW_HOME is preserved."
}

cmd_start() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Use 'exec' to run the assistant directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user start zeroclaw.service
}

cmd_stop() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user stop zeroclaw.service
}

cmd_restart() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Use 'exec' to run the assistant directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user restart zeroclaw.service
}

cmd_status() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user status zeroclaw.service
}

cmd_enable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user enable zeroclaw.service
}

cmd_disable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user disable zeroclaw.service
}

cmd_logs() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Check direct execution console output instead." >&2
        exit 1
    fi
    journalctl --user -u zeroclaw.service "$@"
}

cmd_edit() {
    local config_file="$ZEROCLAW_HOME/.zeroclaw/config.toml"
    mkdir -p "$(dirname "$ENV_FILE")" "$(dirname "$config_file")"
    touch "$ENV_FILE" "$config_file"
    ${EDITOR:-nano} "$ENV_FILE" "$config_file"
    if is_systemd_running; then
        echo "Restarting service to apply updated environment..."
        cmd_restart
    else
        echo "Systemd is not running. Service restart skipped."
    fi
}

cmd_exec() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running zeroclaw directly..."
        if [ -f "$ENV_FILE" ]; then
            set +u
            set -a
            # shellcheck disable=SC1090
            source "$ENV_FILE"
            set +a
            set -u
        fi
        export HOME="$ZEROCLAW_HOME"
        export ZEROCLAW_PORT="${ZEROCLAW_PORT:-42617}"
        export ZEROCLAW_HOST="${ZEROCLAW_HOST:-127.0.0.1}"
        mkdir -p "$ZEROCLAW_HOME"
        cd "$ZEROCLAW_HOME" || exit 1
        exec /usr/bin/zeroclaw "$@"
    fi

    echo "Starting zeroclaw as a transient systemd service with args: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" /usr/bin/zeroclaw "$@"
}

cmd_shell() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running shell directly..."
        if [ -f "$ENV_FILE" ]; then
            set +u
            set -a
            # shellcheck disable=SC1090
            source "$ENV_FILE"
            set +a
            set -u
        fi
        export HOME="$ZEROCLAW_HOME"
        export ZEROCLAW_PORT="${ZEROCLAW_PORT:-42617}"
        export ZEROCLAW_HOST="${ZEROCLAW_HOST:-127.0.0.1}"
        mkdir -p "$ZEROCLAW_HOME"
        cd "$ZEROCLAW_HOME" || exit 1
        exec "${SHELL:-/bin/bash}" "$@"
    fi

    echo "Starting interactive shell as a transient systemd service..."

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "${SHELL:-/bin/bash}" "$@"
}

cmd_run() {
    if [ $# -lt 1 ]; then
        echo "Error: run requires a command to execute." >&2
        exit 1
    fi

    if ! is_systemd_running; then
        echo "Running command inside the zeroclaw environment: $*"
        if [ -f "$ENV_FILE" ]; then
            set +u
            set -a
            # shellcheck disable=SC1090
            source "$ENV_FILE"
            set +a
            set -u
        fi
        export HOME="$ZEROCLAW_HOME"
        export ZEROCLAW_PORT="${ZEROCLAW_PORT:-42617}"
        export ZEROCLAW_HOST="${ZEROCLAW_HOST:-127.0.0.1}"
        mkdir -p "$ZEROCLAW_HOME"
        cd "$ZEROCLAW_HOME" || exit 1
        exec "$@"
    fi

    echo "Running command inside the zeroclaw environment: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "$@"
}

usage() {
    echo "Usage: $0 <command>"
    echo "Commands:"
    echo "  install [--no-start] [--new-config] - Setup service and zeroclaw home directory (do not start service if --no-start is specified, overwrite configs with defaults if --new-config is specified)"
    echo "  uninstall - Stop and remove systemd service"
    echo "  start     - Start the systemd service"
    echo "  stop      - Stop the systemd service"
    echo "  restart   - Restart the systemd service"
    echo "  status    - View systemd service status"
    echo "  enable    - Enable systemd service on boot"
    echo "  disable   - Disable systemd service on boot"
    echo "  logs      - Tail the systemd service logs"
    echo "  edit      - Edit the .env and config.toml files"
    echo "  exec      - Run zeroclaw as a transient systemd user service with args"
    echo "  run       - Run a command inside the zeroclaw systemd environment"
    echo "  shell     - Spawn an interactive shell in the zeroclaw systemd environment"
}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
install) cmd_install "$@" ;;
uninstall) cmd_uninstall ;;
start) cmd_start ;;
stop) cmd_stop ;;
restart) cmd_restart ;;
status) cmd_status ;;
enable) cmd_enable ;;
disable) cmd_disable ;;
logs) cmd_logs "$@" ;;
edit) cmd_edit ;;
exec) cmd_exec "$@" ;;
run) cmd_run "$@" ;;
shell) cmd_shell "$@" ;;
*)
    echo "Unknown command: $COMMAND"
    usage
    exit 1
    ;;
esac
