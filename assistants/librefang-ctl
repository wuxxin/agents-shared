#!/usr/bin/env bash
set -euo pipefail

# librefang-ctl - installation and management wrapper for librefang

SERVICE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/librefang.service"
ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/librefang.env"
LIBREFANG_HOME="$HOME/.local/sandbox/librefang"

is_systemd_running() {
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/systemd/private" ]
}

get_shared_options() {
    local mode="$1" # "service" or "transient"
    local home_spec
    if [ "$mode" = "service" ]; then
        home_spec="%h"
    else
        home_spec="$HOME"
    fi

    local AGENT_PRIVATE_MOUNTS=""
    local AGENT_SANDBOX_MOUNTS=""
    local AGENT_EXTRA_MOUNTS=""
    local AGENT_WORKSPACE=""

    # Set default AGENT_WORKSPACE before sourcing so self-referencing variables expand correctly
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-$HOME/.local/sandbox/librefang/.librefang/workspaces/agents/assistant}"
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    local app_env_file="$LIBREFANG_HOME/.librefang/.env"
    if [ -f "$app_env_file" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$app_env_file"
        set -u
    fi

    # Environment & Working Directory
    echo "Environment=HOME=${home_spec}/.local/sandbox/librefang"
    echo "Environment=AGENT_WORKSPACE=${AGENT_WORKSPACE}"
    echo "EnvironmentFile=-${home_spec}/.config/systemd/user/librefang.env"
    echo "EnvironmentFile=-${home_spec}/.local/sandbox/librefang/.librefang/.env"
    echo "WorkingDirectory=${home_spec}/.local/sandbox/librefang"

    # Security measures
    echo "NoNewPrivileges=yes"
    echo "CapabilityBoundingSet="
    echo "AmbientCapabilities="

    # Filesystem hiding
    echo "ProtectSystem=strict"
    echo "TemporaryFileSystem=${home_spec}"
    # Retain changes by bind mounting the explicit librefang home directory
    echo "BindPaths=${home_spec}/.local/sandbox/librefang:${home_spec}/.local/sandbox/librefang"

    for m in ${AGENT_PRIVATE_MOUNTS:-}; do
        mkdir -p "$HOME/agent-private/$m"
        echo "BindPaths=${home_spec}/agent-private/$m:${home_spec}/agent-private/$m"
    done

    for m in ${AGENT_SANDBOX_MOUNTS:-}; do
        local sandbox_name="${m%%/*}"
        local subpath="${m#*/}"
        mkdir -p "$HOME/.local/sandbox/${sandbox_name}/${subpath}"
        mkdir -p "$HOME/.local/sandbox/librefang/${subpath}"
        echo "BindPaths=${home_spec}/.local/sandbox/${sandbox_name}/${subpath}:${home_spec}/.local/sandbox/librefang/${subpath}"
    done

    for m in ${AGENT_EXTRA_MOUNTS:-}; do
        local abs_dir="${m%%:*}"
        local rel_dir="${m#*:}"
        mkdir -p "$abs_dir" || true
        mkdir -p "$HOME/$rel_dir"
        echo "BindPaths=${abs_dir}:${home_spec}/${rel_dir}"
    done

    echo "ReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/resolv.conf /etc/hosts /etc/nsswitch.conf"
    echo "PrivateTmp=yes"
    echo "PrivateDevices=yes"
    echo "PrivateMounts=yes"

    # Kernel and IPC constraints
    echo "ProtectKernelTunables=yes"
    echo "ProtectKernelModules=yes"
    echo "ProtectKernelLogs=yes"
    echo "ProtectControlGroups=yes"
    echo "ProtectClock=yes"
    echo "ProtectHostname=yes"
    echo "LockPersonality=yes"
    echo "MemoryDenyWriteExecute=no"
    echo "SystemCallArchitectures=native"
    echo "PrivateIPC=yes"
    echo "RestrictSUIDSGID=yes"
    echo "RestrictRealtime=yes"
    echo "KeyringMode=private"
    echo "UMask=0077"
}

sanitize_var_name() {
    local val="$1"
    val="${val//-/_}"
    val="${val//./_}"
    val="${val//\//_}"
    echo "${val^^}"
}

write_service_file() {
    # Set default AGENT_WORKSPACE before sourcing so self-referencing variables expand correctly
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-$HOME/.local/sandbox/librefang/.librefang/workspaces/agents/assistant}"
    if [ -f "$ENV_FILE" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set -u
    fi

    local app_env_file="$LIBREFANG_HOME/.librefang/.env"
    if [ -f "$app_env_file" ]; then
        set +u
        # shellcheck disable=SC1090
        source "$app_env_file"
        set -u
    fi

    # Ensure host workspace directory exists
    local workspace_dir="${AGENT_WORKSPACE:-$HOME/.local/sandbox/librefang/.librefang/agents/default/workspace}"
    workspace_dir="${workspace_dir//%h/$HOME}"
    mkdir -p "$workspace_dir"

    # Manage systemd-tmpfiles configuration file based on AGENT_TMPFILES_CLEANUP
    local tmpfiles_config="${XDG_CONFIG_HOME:-$HOME/.config}/user-tmpfiles.d/librefang.conf"
    local tmpfiles_dir
    tmpfiles_dir=$(dirname "$tmpfiles_config")
    mkdir -p "$tmpfiles_dir"

    local tmpfiles_cleanup_enabled="${AGENT_TMPFILES_CLEANUP:-false}"

    if [ "$tmpfiles_cleanup_enabled" = "true" ]; then
        if [ -f "${tmpfiles_config}.disabled" ]; then
            mv "${tmpfiles_config}.disabled" "$tmpfiles_config"
            echo "Enabled systemd-tmpfiles configuration at $tmpfiles_config"
        elif [ ! -f "$tmpfiles_config" ]; then
            cat >"$tmpfiles_config" <<'EOF'
# ~/.config/user-tmpfiles.d/librefang.conf
# systemd-tmpfiles configuration for LibreFang

# Example: Delete all files in workspace/voice-notes/read/ if older than 24 hours
# Type  Path                                                                                Mode UID  GID  Age  Argument
e       %h/.local/sandbox/librefang/.librefang/agents/default/workspace/voice-notes/read       -    -    -    24h  -
EOF
            echo "Created default systemd-tmpfiles configuration at $tmpfiles_config"
        fi
    else
        if [ -f "$tmpfiles_config" ]; then
            mv "$tmpfiles_config" "${tmpfiles_config}.disabled"
            echo "Disabled systemd-tmpfiles configuration (renamed to ${tmpfiles_config}.disabled)"
        fi
    fi

    local sidecars_val="${AGENT_SIDECARS:-}"
    sidecars_val="${sidecars_val//;/ }"
    sidecars_val="${sidecars_val//$'\n'/ }"

    local sidecars_exec=""
    local sidecar_check=""
    local idx=0

    for sidecar in ${sidecars_val}; do
        local var_name
        var_name=$(sanitize_var_name "$sidecar")
        local cmd_var="AGENT_SIDECAR_${var_name}_CMD"
        local cmd_val="${!cmd_var:-}"
        if [ -z "$cmd_val" ]; then
            cmd_val="$sidecar"
        fi

        # Warn if command doesn't exist on host
        local host_cmd_val="$cmd_val"
        host_cmd_val="${host_cmd_val//\$AGENT_WORKSPACE/$workspace_dir}"
        host_cmd_val="${host_cmd_val//\$HOME/$HOME}"
        host_cmd_val="${host_cmd_val//%h/$HOME}"
        if [[ "$host_cmd_val" =~ ^~ ]]; then
            host_cmd_val="${host_cmd_val/#\~/$HOME}"
        fi
        if ! command -v "$host_cmd_val" >/dev/null 2>&1 && [ ! -x "$host_cmd_val" ]; then
            echo "Warning: Sidecar '$sidecar' executable '$cmd_val' (resolved: '$host_cmd_val') does not exist or is not executable." >&2
        fi

        local args_var="AGENT_SIDECAR_${var_name}_ARGS"
        local args_val="${!args_var:-}"

        # Process env removes and overrides
        local env_remove_var="AGENT_SIDECAR_${var_name}_ENV_REMOVE"
        local env_remove_val="${!env_remove_var:-}"
        local env_flags=""
        for r in ${env_remove_val}; do
            env_flags="$env_flags -u $r"
        done

        local env_override_var="AGENT_SIDECAR_${var_name}_ENV_OVERRIDE"
        local env_override_val="${!env_override_var:-}"
        for o in ${env_override_val}; do
            env_flags="$env_flags $o"
        done

        # Check executable inside sandbox at startup and print clear error if missing
        sidecars_exec="$sidecars_exec if ! command -v $cmd_val >/dev/null 2>&1 && [ ! -x \"$cmd_val\" ]; then echo \"Error: Cannot spawn sidecar $sidecar because its executable '$cmd_val' is missing or not executable.\" >&2 ; exit 1 ; fi ; env$env_flags $cmd_val $args_val & SIDECAR_PID_$idx=\$! ; "
        sidecar_check="$sidecar_check if ! kill -0 \$SIDECAR_PID_$idx 2>/dev/null; then echo \"Sidecar $sidecar (PID \$SIDECAR_PID_$idx) terminated.\" ; fi ; "
        idx=$((idx + 1))
    done

    local exec_start_cmd
    if [ -n "$sidecars_exec" ]; then
        # Spawn daemon first, sleep 2, check if daemon failed to start, spawn sidecars, then wait on daemon
        exec_start_cmd="/bin/bash -c '/usr/bin/librefang start --foreground & MAIN_PID=\$! ; sleep 2 ; if ! kill -0 \$MAIN_PID 2>/dev/null; then echo \"Main daemon process (PID \$MAIN_PID) failed to start.\" >&2 ; exit 1 ; fi ; $sidecars_exec wait -n ; if ! kill -0 \$MAIN_PID 2>/dev/null; then echo \"Main daemon process (PID \$MAIN_PID) terminated.\" ; fi ; $sidecar_check exit 1'"
    else
        exec_start_cmd="/usr/bin/librefang start --foreground"
    fi

    cat >"$SERVICE_FILE" <<EOF
[Unit]
Description=LibreFang Agent OS Daemon
Documentation=https://github.com/librefang/librefang
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=40
StartLimitBurst=4

[Service]
Type=simple
$(get_shared_options service)
ExecStart=${exec_start_cmd}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=librefang

# Note: ProtectProc=invisible, ProcSubset=pid, and RestrictNamespaces=yes
# are explicitly omitted to allow child processes to use bwrap (which needs
# CLONE_NEWUSER and CLONE_NEWNS).

[Install]
WantedBy=default.target
EOF

    if is_systemd_running; then
        systemctl --user daemon-reload
    fi
}

write_default_provider_toml() {
    local type="$1"
    local dest="$2"
    mkdir -p "$(dirname "$dest")"
    case "$type" in
    chat)
        cat >"$dest" <<'EOF'
[[models]]
id = "qwen3"
display_name = "Qwen3"
tier = "local"
context_window = 80128
max_output_tokens = 8192
input_cost_per_m = 1.5
output_cost_per_m = 9.0
supports_tools = true
supports_vision = true
supports_streaming = true
supports_thinking = true
aliases = ["local-chat/qwen3"]

[provider]
id = "local-chat"
display_name = "Local Chat"
api_key_env = "LOCAL_CHAT_API_KEY"
base_url = "http://localhost:50080/v1"
key_required = false
EOF
        ;;
    embedding)
        cat >"$dest" <<'EOF'
[[models]]
id = "qwen3-embedding"
display_name = "Qwen3 Embedding"
tier = "local"
context_window = 4096
max_output_tokens = 4096
input_cost_per_m = 0.02
output_cost_per_m = 0.0
aliases = ["local-embedding/qwen3-embedding"]

[provider]
id = "local-embedding"
display_name = "Local Embedding"
api_key_env = "LOCAL_EMBEDDING_API_KEY"
base_url = "http://localhost:50082/v1"
key_required = false
EOF
        ;;
    esac
    chmod 600 "$dest"
}

cmd_install() {
    local no_start=false
    local new_config=false
    while [ $# -gt 0 ]; do
        case "$1" in
        --no-start) no_start=true ;;
        --new-config) new_config=true ;;
        esac
        shift
    done

    echo "Setting up librefang home directory at $LIBREFANG_HOME..."
    mkdir -p "$LIBREFANG_HOME"

    echo "Generating systemd user service..."
    mkdir -p "$(dirname "$SERVICE_FILE")"

    if [ ! -f "$ENV_FILE" ] || [ "$new_config" = "true" ]; then
        cat >"$ENV_FILE" <<'EOF'
# librefang.env
# LibreFang Environment Configuration

# List of submounts from ~/agent-private/* to bind-mount into the sandbox
# (e.g., AGENT_PRIVATE_MOUNTS="health diary" binds ~/agent-private/health and ~/agent-private/diary)
# AGENT_PRIVATE_MOUNTS=""

# List of submounts from other sandboxes (e.g., opencode) to bind-mount into this assistant's sandbox
AGENT_SANDBOX_MOUNTS="opencode/.cache/opencode opencode/.opencode-mem opencode/.config/opencode opencode/.local/share/opencode opencode/.local/state/opencode deep-research/.cache/deep-research-profiles deep-research/.config/deep-research-profiles"

# List of extra mounts to bind-mount into the sandbox (syntax: absolute-dir:relative-dir-to-HOME)
AGENT_EXTRA_MOUNTS="$HOME/agent-shared:agent-shared /data/download:download /data/download/librefang-assistant:.local/sandbox/librefang/.librefang/workspaces/agents/assistant/downloads"

# --- Sidecars Configuration (Optional)
# Space or semicolon separated list of sidecar names.
# AGENT_SIDECARS="audionotes"
#
# For each sidecar, configure its command, optional args and environment modifications:
# AGENT_SIDECAR_AUDIONOTES_CMD="$AGENT_WORKSPACE/scripts/audionotes.sh"
# AGENT_SIDECAR_AUDIONOTES_ARGS="$AGENT_WORKSPACE/audionotes"
# AGENT_SIDECAR_AUDIONOTES_ENV_REMOVE="ZEROCLAW_PORT"
# AGENT_SIDECAR_AUDIONOTES_ENV_OVERRIDE="TARGET_DIR=$AGENT_WORKSPACE/audionotes"

# --- systemd-tmpfiles Confinement Cleanup
# Enable to automatically clean up temporary/workspace folders:
# AGENT_TMPFILES_CLEANUP=true

# --- Librefang Dashboard Username and Pass
LIBREFANG_DASHBOARD_USER="user"
LIBREFANG_DASHBOARD_PASS="my_password"

# --- Standard Cloud API Keys (loaded by model providers at runtime)
# ensure OPENAI_API_KEY is set, so tts, stt and image provider mimicking openai work
OPENAI_API_KEY="unused"
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
# GROQ_API_KEY=""
# ELEVENLABS_API_KEY=""

EOF
        chmod 600 "$ENV_FILE"
        echo "Created default environment file at $ENV_FILE"
    fi

    local CONFIG_DIR="$LIBREFANG_HOME/.librefang"
    local CONFIG_FILE="$CONFIG_DIR/config.toml"
    if [ ! -f "$CONFIG_FILE" ] || [ "$new_config" = "true" ]; then
        mkdir -p "$CONFIG_DIR"
        cat >"$CONFIG_FILE" <<'EOF'
# config.toml — LibreFang local inference configuration
# Generated by librefang-ctl install --new-config
# All settings below target the local inference split services.

# --- Chat Provider
[default_model]
provider = "local-chat"
model = "qwen3"
api_key_env = "LOCAL_CHAT_API_KEY"

# --- Memory & Embeddings
[memory]
embedding_provider = "local-embedding"
embedding_model = "qwen3-embedding"

# --- Speech-to-Text and Image
[media]
audio_transcription = true
audio_provider = "openai"
audio_model = "whisper-1"
audio_base_url = "http://localhost:50090/v1"
image_description = true
image_provider = "openai"
image_base_url = "http://localhost:50100/v1"
image_model = ""
video_description = false

# --- Text-to-Speech
[tts]
enabled = true
provider = "openai"
timeout_secs = 60

[tts.openai]
base_url = "http://localhost:50095/v1"
model = "qwen3-tts"
voice = "serena"
format = "wav"

# --- Signal Sidecar Channel
[[sidecar_channels]]
name = "signal"
command = "python3"
args = ["-m", "librefang.sidecar.adapters.signal"]
channel_type = "signal"

[sidecar_channels.env]
SIGNAL_API_URL = "http://localhost:50889/"
SIGNAL_NUMBER = "+1234567890"
SIGNAL_ALLOW_LOCAL = "1"

[tool_timeouts]
# Set specific timeout for image generation tool in seconds
image_generate = 120
# Set specific timeout for shell_exec command executions (Default: 30)
shell_exec = 120

[[users]]
name = "user"
# Roles: owner, admin, user, viewer
role = "owner"
# Ties phone number to user
channel_bindings = { signal = "+9876543210" }

# Route messages from the Signal channel to the assistant agent
[[bindings]]
agent = "assistant"
match_rule = { channel = "signal", peer_id = "+9876543210" }

EOF
        echo "Created default configuration at $CONFIG_FILE"
    fi

    # Deploy default provider files
    local providers_dir="$CONFIG_DIR/providers"
    mkdir -p "$providers_dir"
    for name in chat embedding; do
        local file="$providers_dir/local-$name.toml"
        if [ ! -f "$file" ] || [ "$new_config" = "true" ]; then
            write_default_provider_toml "$name" "$file"
            echo "Created default local-$name configuration at $file"
        fi
    done

    local app_env_file="$CONFIG_DIR/.env"
    if [ ! -f "$app_env_file" ] || [ "$new_config" = "true" ]; then
        mkdir -p "$CONFIG_DIR"
        : >"$app_env_file"
        chmod 600 "$app_env_file"
        echo "Created default empty application environment file at $app_env_file"
    elif [ -f "$app_env_file" ]; then
        chmod 600 "$app_env_file"
    fi

    write_service_file

    if is_systemd_running; then
        echo "Reloading systemd and enabling service..."
        systemctl --user enable librefang.service

        if [ "$no_start" = "true" ]; then
            echo "Stopping service if running (--no-start specified)..."
            systemctl --user stop librefang.service || true
        else
            echo "Starting service automatically..."
            systemctl --user start librefang.service
        fi
    else
        echo "Systemd is not running. Service file generated but not started/enabled."
    fi

    echo "Done! Type '$0 logs' to see the output."
}

cmd_uninstall() {
    echo "Uninstalling librefang systemd service..."
    if is_systemd_running; then
        systemctl --user stop librefang.service || true
        systemctl --user disable librefang.service || true
    fi

    if [ -f "$SERVICE_FILE" ]; then
        rm "$SERVICE_FILE"
        if is_systemd_running; then
            systemctl --user daemon-reload
        fi
        echo "Removed service file."
    fi
    echo "Uninstalled successfully. Data in $LIBREFANG_HOME is preserved."
}

cmd_start() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Use 'exec' to run the assistant directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user start librefang.service
}

cmd_stop() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user stop librefang.service
}

cmd_restart() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Use 'exec' to run the assistant directly." >&2
        exit 1
    fi
    write_service_file
    systemctl --user restart librefang.service
}

cmd_status() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user status librefang.service
}

cmd_enable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    write_service_file
    systemctl --user enable librefang.service
}

cmd_disable() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running." >&2
        exit 1
    fi
    systemctl --user disable librefang.service
}

cmd_logs() {
    if ! is_systemd_running; then
        echo "Error: Systemd is not running. Check direct execution console output instead." >&2
        exit 1
    fi
    journalctl --user -u librefang.service "$@"
}

FALLBACK_SIDECAR_PIDS=()
FALLBACK_SIDECAR_NAMES=()

setup_fallback_environment() {
    # Set default AGENT_WORKSPACE before sourcing so self-referencing variables expand correctly
    export AGENT_WORKSPACE="${AGENT_WORKSPACE:-$HOME/.local/sandbox/librefang/.librefang/workspaces/agents/assistant}"
    if [ -f "$ENV_FILE" ]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$ENV_FILE"
        set +a
        set -u
    fi

    local app_env_file="$LIBREFANG_HOME/.librefang/.env"
    if [ -f "$app_env_file" ]; then
        set +u
        set -a
        # shellcheck disable=SC1090
        source "$app_env_file"
        set +a
        set -u
    fi
    export HOME="$LIBREFANG_HOME"
    local ws="${AGENT_WORKSPACE}"
    ws="${ws//%h/$HOME}"
    if [[ "$ws" =~ ^~ ]]; then
        ws="${ws/#\~/$HOME}"
    fi
    export AGENT_WORKSPACE="$ws"
    mkdir -p "$LIBREFANG_HOME" "$AGENT_WORKSPACE"
    cd "$LIBREFANG_HOME" || exit 1
}

spawn_fallback_sidecars() {
    local sidecars_val="${AGENT_SIDECARS:-}"
    sidecars_val="${sidecars_val//;/ }"
    sidecars_val="${sidecars_val//$'\n'/ }"

    for sidecar in ${sidecars_val}; do
        local var_name
        var_name=$(sanitize_var_name "$sidecar")
        local cmd_var="AGENT_SIDECAR_${var_name}_CMD"
        local cmd_val="${!cmd_var:-}"
        if [ -z "$cmd_val" ]; then
            cmd_val="$sidecar"
        fi

        local args_var="AGENT_SIDECAR_${var_name}_ARGS"
        local args_val="${!args_var:-}"

        # Host-side check before fork
        local check_cmd="$cmd_val"
        check_cmd="${check_cmd//\$AGENT_WORKSPACE/$AGENT_WORKSPACE}"
        check_cmd="${check_cmd//\$HOME/$HOME}"
        check_cmd="${check_cmd//%h/$HOME}"
        if [[ "$check_cmd" =~ ^~ ]]; then
            check_cmd="${check_cmd/#\~/$HOME}"
        fi
        if ! command -v "$check_cmd" >/dev/null 2>&1 && [ ! -x "$check_cmd" ]; then
            echo "Error: Cannot spawn sidecar $sidecar because its executable '$cmd_val' (resolved: '$check_cmd') is missing or not executable." >&2
            exit 1
        fi

        # Process env removes and overrides
        local env_remove_var="AGENT_SIDECAR_${var_name}_ENV_REMOVE"
        local env_remove_val="${!env_remove_var:-}"

        local env_override_var="AGENT_SIDECAR_${var_name}_ENV_OVERRIDE"
        local env_override_val="${!env_override_var:-}"

        (
            for r in ${env_remove_val}; do
                unset "$r"
            done
            for o in ${env_override_val}; do
                # shellcheck disable=SC2163
                export "$o"
            done
            eval "exec $cmd_val $args_val"
        ) &
        FALLBACK_SIDECAR_PIDS+=($!)
        FALLBACK_SIDECAR_NAMES+=("$sidecar")
    done
}

cmd_edit() {
    local config_file="$LIBREFANG_HOME/.librefang/config.toml"
    local app_env_file="$LIBREFANG_HOME/.librefang/.env"
    local tmpfiles_config="${XDG_CONFIG_HOME:-$HOME/.config}/user-tmpfiles.d/librefang.conf"
    if [ ! -f "$tmpfiles_config" ] && [ -f "${tmpfiles_config}.disabled" ]; then
        tmpfiles_config="${tmpfiles_config}.disabled"
    fi
    local providers_dir="$LIBREFANG_HOME/.librefang/providers"
    mkdir -p "$(dirname "$ENV_FILE")" "$(dirname "$app_env_file")" "$(dirname "$config_file")" "$(dirname "$tmpfiles_config")" "$providers_dir"
    touch "$ENV_FILE" "$app_env_file" "$config_file" "$tmpfiles_config"

    # Ensure local provider files exist and load them
    local local_providers=()
    for name in chat embedding; do
        local file="$providers_dir/local-$name.toml"
        if [ ! -s "$file" ]; then
            write_default_provider_toml "$name" "$file"
        fi
        local_providers+=("$file")
    done

    ${EDITOR:-nano} "$ENV_FILE" "$app_env_file" "$config_file" "$tmpfiles_config" "${local_providers[@]}"
    if is_systemd_running; then
        echo "Restarting service to apply updated environment..."
        cmd_restart
    else
        echo "Systemd is not running. Service restart skipped."
    fi
}

cmd_exec() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running librefang directly..."
        setup_fallback_environment

        if [ "${1:-}" = "start" ]; then
            # Run cleanup if enabled
            if [ "${AGENT_TMPFILES_CLEANUP:-false}" = "true" ]; then
                echo "Running systemd-tmpfiles cleanup..."
                systemd-tmpfiles --user --create --clean || true
            fi
            # Run daemon in the background
            /usr/bin/librefang "$@" &
            local main_pid=$!
            sleep 2
            if ! kill -0 "$main_pid" 2>/dev/null; then
                echo "Main daemon process (PID $main_pid) failed to start." >&2
                exit 1
            fi
            spawn_fallback_sidecars
            wait -n

            # Identify which process died
            if ! kill -0 "$main_pid" 2>/dev/null; then
                echo "Main daemon process (PID $main_pid) terminated."
            fi
            for i in "${!FALLBACK_SIDECAR_PIDS[@]}"; do
                local pid="${FALLBACK_SIDECAR_PIDS[$i]}"
                local name="${FALLBACK_SIDECAR_NAMES[$i]}"
                if ! kill -0 "$pid" 2>/dev/null; then
                    echo "Sidecar $name (PID $pid) terminated."
                fi
            done
            exit 1
        else
            exec /usr/bin/librefang "$@"
        fi
    fi

    echo "Starting librefang as a transient systemd service with args: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" /usr/bin/librefang "$@"
}

cmd_shell() {
    if ! is_systemd_running; then
        echo "Systemd is not running. Running shell directly..."
        setup_fallback_environment
        exec "${SHELL:-/bin/bash}" "$@"
    fi

    echo "Starting interactive shell as a transient systemd service..."

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "${SHELL:-/bin/bash}" "$@"
}

cmd_run() {
    if [ $# -lt 1 ]; then
        echo "Error: run requires a command to execute." >&2
        exit 1
    fi

    if ! is_systemd_running; then
        echo "Running command inside the librefang environment: $*"
        setup_fallback_environment
        exec "$@"
    fi

    echo "Running command inside the librefang environment: $*"

    local opts=(
        --user
        --pty
        --wait
        --collect
        --quiet
        -p "Type=exec"
    )

    while IFS= read -r opt; do
        if [ -n "$opt" ]; then
            opts+=(-p "$opt")
        fi
    done < <(get_shared_options transient)

    systemd-run "${opts[@]}" "$@"
}

usage() {
    echo "Usage: $0 <command>"
    echo "Commands:"
    echo "  install [--no-start] [--new-config] - Setup service and librefang home directory (do not start service if --no-start is specified, overwrite configs with defaults if --new-config is specified)"
    echo "  uninstall - Stop and remove systemd service"
    echo "  start     - Start the systemd service"
    echo "  stop      - Stop the systemd service"
    echo "  restart   - Restart the systemd service"
    echo "  status    - View systemd service status"
    echo "  enable    - Enable systemd service on boot"
    echo "  disable   - Disable systemd service on boot"
    echo "  logs      - Tail the systemd service logs"
    echo "  edit      - Edit the .env and config.toml files"
    echo "  exec      - Run librefang as a transient systemd user service with args"
    echo "  run       - Run a command inside the librefang systemd environment"
    echo "  shell     - Spawn an interactive shell in the librefang systemd environment"
}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

COMMAND="$1"
shift

case "$COMMAND" in
install) cmd_install "$@" ;;
uninstall) cmd_uninstall ;;
start) cmd_start ;;
stop) cmd_stop ;;
restart) cmd_restart ;;
status) cmd_status ;;
enable) cmd_enable ;;
disable) cmd_disable ;;
logs) cmd_logs "$@" ;;
edit) cmd_edit ;;
exec) cmd_exec "$@" ;;
run) cmd_run "$@" ;;
shell) cmd_shell "$@" ;;
*)
    echo "Unknown command: $COMMAND"
    usage
    exit 1
    ;;
esac
